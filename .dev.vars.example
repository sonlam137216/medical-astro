# Copy to .dev.vars for local `wrangler dev`. Never commit .dev.vars.
# Values below are placeholders; real values come from the owner's accounts (not yet provisioned).

# Database: Cloudflare D1, used inside the Worker through the `DB` binding (wrangler.jsonc), so it needs no secret.
# Local development uses a simulated D1 stored in .wrangler/state (see db/README.md).
#
# The BUILD reads the published content over Cloudflare's HTTP API (Phase 6 writes these into .dev.vars in CI).
# Leave all three empty to build with the built-in sample content.
#   CLOUDFLARE_API_TOKEN: token with "D1: Edit" (plus the Workers/R2 rights wrangler deploy needs). Backend / CI secret only.
#   D1_DATABASE_ID: id of the database of the environment being built (staging and production differ).
#   CLOUDFLARE_API_URL: for tests (a local mock of the API); leave empty for the real API.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=
CLOUDFLARE_API_URL=

# Cloudflare R2 media (Phase 5). Leave empty to serve media through the Worker route /media/* (local, staging);
# set to the public base URL of the bucket (custom domain) so visitors never reach the Worker for images.
R2_PUBLIC_BASE_URL=

# Cloudflare Turnstile for the consultation form (Phase 4)
TURNSTILE_SECRET_KEY=

# Publish pipeline (Phase 6). The admin's Publish button starts the "Publish" GitHub Actions workflow.
# GITHUB_DISPATCH_TOKEN: fine-grained token with "Actions: read and write" on the repository. Backend secret only.
# GITHUB_API_URL: for tests (a local mock); leave empty for the real GitHub API.
GITHUB_DISPATCH_TOKEN=
GITHUB_API_URL=

# Read by the build only (written by the workflow): the revision to build. Leave empty to use the newest.
CONTENT_REVISION_ID=

---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { MAX_ALT_LENGTH, mediaUrl, thumbnailKey } from '../../../lib/media';
import { readAlt } from '../../../lib/media-upload';
import { isSameOrigin } from '../../../lib/admin-auth';
import { readBodyLimited } from '../../../lib/consultation';

export const prerender = false;

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const id = Astro.params.id ?? '';
if (!UUID_RE.test(id)) return new Response('Not found', { status: 404 });

const db = Astro.locals.db;
let { data: asset } = await db.from('media_assets').select('*').eq('id', id).maybeSingle();
if (!asset) return new Response('Not found', { status: 404 });

let formError: string | undefined;
let saved = false;
if (Astro.request.method === 'POST') {
  if (!isSameOrigin(Astro.request)) return new Response('Forbidden', { status: 403 });
  const text = await readBodyLimited(Astro.request, 4 * 1024);
  if (text === null) return new Response('Payload Too Large', { status: 413 });
  const form = new URLSearchParams(text);
  const isDecorative = asset.kind === 'video' ? false : form.has('is_decorative');
  const alt = readAlt(
    form.get('alt_text') ?? '',
    isDecorative,
    asset.kind === 'video' ? 'video' : 'image',
  );
  if (!alt.ok) {
    formError = alt.error;
    Astro.response.status = 422;
    asset = { ...asset, alt_text: form.get('alt_text') ?? '', is_decorative: isDecorative };
  } else {
    const { error } = await db
      .from('media_assets')
      .update({ alt_text: alt.altText, is_decorative: isDecorative })
      .eq('id', id);
    if (error) {
      console.error('media update failed', error.code);
      formError = 'Could not save. Please try again.';
      Astro.response.status = 500;
    } else {
      asset = { ...asset, alt_text: alt.altText, is_decorative: isDecorative };
      saved = true;
    }
  }
}

const isVideo = asset.kind === 'video';
const { data: doctors } = await db.from('doctors').select('id, full_name').eq('image_id', id);
const poster = asset.poster_asset_id
  ? (
      await db
        .from('media_assets')
        .select('r2_key, variant_widths')
        .eq('id', asset.poster_asset_id)
        .maybeSingle()
    ).data
  : null;
const noun = isVideo ? 'video' : 'image';
const sp = Astro.url.searchParams;
---

<AdminLayout title={isVideo ? 'Video' : 'Image'} current="media">
  <main class="admin-main">
    <p>
      <a href="/admin/media">← All media</a>
    </p>
    <h1>{isVideo ? 'Video' : 'Image'}</h1>

    {sp.has('uploaded') && (
      <p class="admin-notice" role="status">
        Uploaded.
      </p>
    )}
    {saved && (
      <p class="admin-notice" role="status">
        Saved. Publish to show the change on the website.
      </p>
    )}
    {sp.get('error') === 'inuse' && (
      <p class="admin-notice admin-notice--error" role="alert">
        This {noun} is still used, so it cannot be deleted. Remove it from where it is used first.
      </p>
    )}
    {sp.has('focus') && (
      <p class="admin-notice" role="status">
        Focus point saved. Publish to show the change on the website.
      </p>
    )}
    {sp.get('error') === 'focus' && (
      <p class="admin-notice admin-notice--error" role="alert">
        Could not save the focus point. Use numbers from 0 to 100.
      </p>
    )}
    {sp.has('error') && sp.get('error') !== 'inuse' && sp.get('error') !== 'focus' && (
      <p class="admin-notice admin-notice--error" role="alert">
        Could not delete. Please try again.
      </p>
    )}

    <section class="admin-card">
      {isVideo ? (
        <video
          class="admin-media-preview"
          src={mediaUrl(asset.r2_key)}
          poster={poster ? mediaUrl(thumbnailKey(poster.r2_key, poster.variant_widths)) : undefined}
          controls
          playsinline
          preload="none"
          aria-label={asset.alt_text ?? undefined}
        />
      ) : (
        <img
          class="admin-media-preview"
          src={mediaUrl(asset.r2_key)}
          alt={asset.is_decorative ? '' : (asset.alt_text ?? '')}
          width={asset.width ?? undefined}
          height={asset.height ?? undefined}
        />
      )}
      <dl class="admin-dl" style="margin-top: 16px">
        {asset.width && asset.height && (
          <>
            <dt>Size</dt>
            <dd>
              {asset.width} × {asset.height} px
            </dd>
          </>
        )}
        {!isVideo && (
          <>
            <dt>Web sizes</dt>
            <dd>{asset.variant_widths.join(', ')} px</dd>
          </>
        )}
        <dt>Stored</dt>
        <dd>
          {isVideo
            ? `${(asset.size_bytes / 1024 / 1024).toFixed(1)} MB`
            : `${Math.round(asset.size_bytes / 1024)} KB in total`}
        </dd>
        <dt>Used by</dt>
        <dd>
          {doctors && doctors.length > 0
            ? doctors.map((d, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={`/admin/doctors/${d.id}`}>{d.full_name}</a>
                </>
              ))
            : 'Nothing yet'}
        </dd>
      </dl>
    </section>

    <form class="admin-form admin-card" method="post">
      <h2 class="t-h3">Description</h2>
      {formError && (
        <p class="admin-notice admin-notice--error" role="alert">
          {formError}
        </p>
      )}
      <label>
        {isVideo ? 'What the video shows' : 'Description for people who cannot see the image'}
        <input
          name="alt_text"
          value={asset.alt_text ?? ''}
          maxlength={MAX_ALT_LENGTH}
          aria-invalid={formError ? 'true' : undefined}
        />
      </label>
      {!isVideo && (
        <label class="admin-check">
          <input type="checkbox" name="is_decorative" checked={asset.is_decorative} />
          Decorative image (no description needed)
        </label>
      )}
      <div>
        <button class="admin-btn" type="submit">
          Save
        </button>
      </div>
    </form>

    {!isVideo && asset.width && asset.height && (
      <form class="admin-form admin-card" method="post" action={`/admin/media/${id}/focus`}>
        <h2 class="t-h3">Focus point</h2>
        <p class="admin-hint">
          The website crops this picture to fit each place that shows it. Mark the most important
          part (a face, a tooth) and it stays in view. Applies wherever the picture is used, after
          you publish.
        </p>
        <button
          type="button"
          class="admin-focus"
          data-focus-stage
          aria-label="Click the most important part of the picture"
        >
          <img src={mediaUrl(thumbnailKey(asset.r2_key, asset.variant_widths))} alt="" />
          <span
            class="admin-focus__marker"
            data-focus-marker
            hidden={asset.focal_x === null || asset.focal_y === null}
            style={
              asset.focal_x !== null && asset.focal_y !== null
                ? `left: ${asset.focal_x}%; top: ${asset.focal_y}%`
                : undefined
            }
          />
        </button>
        <div class="admin-focus-numbers">
          <label>
            From the left (%)
            <input
              type="number"
              name="x"
              min="0"
              max="100"
              step="1"
              value={asset.focal_x ?? ''}
              data-focus-x
            />
          </label>
          <label>
            From the top (%)
            <input
              type="number"
              name="y"
              min="0"
              max="100"
              step="1"
              value={asset.focal_y ?? ''}
              data-focus-y
            />
          </label>
        </div>
        <div class="admin-actions">
          <button class="admin-btn" type="submit">
            Save focus point
          </button>
          <button
            class="admin-btn admin-btn--ghost"
            type="submit"
            name="clear"
            value="1"
            formnovalidate
          >
            Use the default position
          </button>
        </div>
      </form>
    )}

    <form class="admin-form admin-card" method="post" action={`/admin/media/${id}/delete`}>
      <h2 class="t-h3">Delete</h2>
      <p class="admin-hint">
        Only {noun}s that nothing uses can be deleted. This cannot be undone.
      </p>
      <div>
        <button class="admin-btn admin-btn--danger" type="submit">
          Delete {noun}
        </button>
      </div>
    </form>
  </main>
</AdminLayout>

<script>
  // Click the picture to fill in the two numbers; the form is saved with the button, as without JavaScript.
  const stage = document.querySelector<HTMLElement>('[data-focus-stage]');
  const marker = document.querySelector<HTMLElement>('[data-focus-marker]');
  const x = document.querySelector<HTMLInputElement>('[data-focus-x]');
  const y = document.querySelector<HTMLInputElement>('[data-focus-y]');
  const picture = stage?.querySelector('img');
  const show = () => {
    if (!marker || !x || !y) return;
    const ok = x.value !== '' && y.value !== '';
    marker.hidden = !ok;
    if (ok) {
      marker.style.left = `${x.value}%`;
      marker.style.top = `${y.value}%`;
    }
  };
  stage?.addEventListener('click', (event) => {
    if (!picture || !x || !y) return;
    const rect = picture.getBoundingClientRect();
    const clamp = (n: number) => String(Math.min(100, Math.max(0, Math.round(n))));
    x.value = clamp(((event.clientX - rect.left) / rect.width) * 100);
    y.value = clamp(((event.clientY - rect.top) / rect.height) * 100);
    show();
  });
  x?.addEventListener('input', show);
  y?.addEventListener('input', show);
</script>

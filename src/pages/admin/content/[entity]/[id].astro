---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import EntityForm from '../../../../components/admin/EntityForm.astro';
import { ENTITIES, entityByKey } from '../../../../lib/cms/entities';
import {
  listRows,
  loadOptions,
  loadRow,
  processPost,
  valuesFromRow,
} from '../../../../lib/cms/admin';
import { UUID_RE } from '../../../../lib/cms/fields';

export const prerender = false;

const def = entityByKey(Astro.params.entity);
const id = Astro.params.id ?? '';
if (!def || !UUID_RE.test(id)) return new Response('Not found', { status: 404 });

const db = Astro.locals.db;
const row = await loadRow(db, def, id);
if (!row) return new Response('Not found', { status: 404 });

const result =
  Astro.request.method === 'POST' ? await processPost(Astro.request, db, def, id) : null;
if (result && 'redirect' in result) return result.redirect;
if (result) Astro.response.status = result.status;

const options = await loadOptions(db, def);
// Same fields as `def.fields`; some rows show other hints (the Home row of Pages asks for a taller banner).
const fields = def.fieldsFor?.(row) ?? def.fields;
const sp = Astro.url.searchParams;
const heading = String(row[def.titleField] ?? def.singular);

// The rows that belong to this one (the treatments of a service), listed under the form.
const children = await Promise.all(
  ENTITIES.filter((e) => e.parent?.entity === def.key).map(async (child) => ({
    def: child,
    ...(await listRows(db, child, id)),
  })),
);
// A treatment links back to its service.
const parent = def.parent
  ? options.refs[def.parent.field]?.find((o) => o.value === row[def.parent!.field])
  : undefined;
const yesNo = (value: unknown) => (value === true ? 'yes' : value === false ? 'no' : '—');
---

<AdminLayout title={heading} current={`content:${def.key}`}>
  <main class="admin-main">
    <p>
      {parent && def.parent ? (
        <a href={`/admin/content/${def.parent.entity}/${parent.value}#children-${def.key}`}>
          ← {parent.label}
        </a>
      ) : (
        <a href={`/admin/content/${def.key}`}>← {def.plural}</a>
      )}
    </p>
    <div class="admin-actions">
      <h1>{heading}</h1>
      {def.key === 'articles' && (
        <a
          class="admin-btn admin-btn--ghost"
          href={`/admin/preview/articles/${id}`}
          target="_blank"
          rel="noopener"
        >
          Preview
        </a>
      )}
    </div>
    {sp.get('error') === 'in_use' && (
      <p class="admin-notice admin-notice--error" role="alert">
        {children.some((c) => c.rows.length > 0)
          ? `This ${def.singular} still has ${children
              .filter((c) => c.rows.length > 0)
              .map((c) => c.def.plural.toLowerCase())
              .join(' and ')}: delete them first.`
          : 'This is still used by something else, so it cannot be deleted.'}
      </p>
    )}
    {sp.get('child') === 'saved' && (
      <p class="admin-notice" role="status">
        Saved. Publish to show the change on the website.
      </p>
    )}
    {sp.get('child') === 'deleted' && (
      <p class="admin-notice" role="status">
        Deleted. Publish to remove it from the website.
      </p>
    )}
    {sp.get('error') === 'failed' && (
      <p class="admin-notice admin-notice--error" role="alert">
        Could not delete. Please try again.
      </p>
    )}
    <EntityForm
      def={{ fields }}
      values={result?.values ?? valuesFromRow(fields, row)}
      errors={result?.errors}
      formError={result?.formError}
      options={options}
      submitLabel="Save changes"
    />
    {children.map((child) => (
      <section
        class="admin-card"
        id={`children-${child.def.key}`}
        aria-labelledby={`children-${child.def.key}-title`}
      >
        <div class="admin-actions">
          <h2 class="t-h3" id={`children-${child.def.key}-title`}>
            {child.def.plural}
          </h2>
          <a
            class="admin-btn"
            href={`/admin/content/${child.def.key}/new?${child.def.parent!.field}=${id}`}
          >
            Add {child.def.singular}
          </a>
        </div>
        {child.failed && (
          <p class="admin-notice admin-notice--error" role="alert">
            Could not load the list.
          </p>
        )}
        {child.rows.length > 0 ? (
          <table class="admin-table">
            <thead>
              <tr>
                {child.def.columns
                  .filter((c) => c.field !== child.def.parent!.field)
                  .map((c) => (
                    <th>{c.label}</th>
                  ))}
              </tr>
            </thead>
            <tbody>
              {child.rows.map((r) => (
                <tr>
                  {child.def.columns
                    .filter((c) => c.field !== child.def.parent!.field)
                    .map((c) => (
                      <td>
                        {c.field === child.def.titleField ? (
                          <a href={`/admin/content/${child.def.key}/${r.id}`}>
                            {String(r[c.field])}
                          </a>
                        ) : typeof r[c.field] === 'boolean' ? (
                          yesNo(r[c.field])
                        ) : r[c.field] === 0 ? (
                          0
                        ) : (
                          (r[c.field] ?? '—') || '—'
                        )}
                      </td>
                    ))}
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p class="admin-muted">
            No {child.def.plural.toLowerCase()} yet.{' '}
            {child.def.key === 'service-options' &&
              'Without treatments, the page of this service shows its description and invites visitors to ask for a quote.'}
            {child.def.key === 'service-faqs' &&
              'Without answered, shown questions, the page of this service has no FAQ block. Website FAQs are not used here.'}
            {child.def.key === 'service-situations' &&
              'Without situations, the page of this service has no “Which treatment fits your situation” block.'}
          </p>
        )}
      </section>
    ))}
    {def.deletable && (
      <form
        class="admin-form admin-card"
        method="post"
        action={`/admin/content/${def.key}/${id}/delete`}
      >
        <h2 class="t-h3">Delete</h2>
        <p class="admin-hint">
          This removes it from the working copy. It disappears from the website after you publish.
        </p>
        <div>
          <button class="admin-btn admin-btn--danger" type="submit">
            Delete {def.singular}
          </button>
        </div>
      </form>
    )}
  </main>
</AdminLayout>

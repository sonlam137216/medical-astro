---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { entityByKey } from '../../../../lib/cms/entities';
import { listRows, loadOptions } from '../../../../lib/cms/admin';
import { UUID_RE } from '../../../../lib/cms/fields';

export const prerender = false;

const def = entityByKey(Astro.params.entity);
if (!def) return new Response('Not found', { status: 404 });

const sp = Astro.url.searchParams;
// A child entity (the treatments) can be filtered by its parent, and its parent is shown by name.
const parents = def.parent
  ? ((await loadOptions(Astro.locals.db, def)).refs[def.parent.field] ?? [])
  : [];
const parentDef = def.parent ? entityByKey(def.parent.entity) : undefined;
const parentLabel = new Map(parents.map((p) => [p.value, p.label]));
const parentId = def.parent ? (sp.get(def.parent.field) ?? '').toLowerCase() : '';
const filter = UUID_RE.test(parentId) && parentLabel.has(parentId) ? parentId : null;
const { rows: listed, failed } = await listRows(Astro.locals.db, def, filter);
// Rows of one parent together, the parents in the same order as the filter (by name).
const parentOrder = new Map(parents.map((p, i) => [p.value, i]));
const rows = def.parent
  ? [...listed].sort(
      (a, b) =>
        (parentOrder.get(String(a[def.parent!.field])) ?? 0) -
        (parentOrder.get(String(b[def.parent!.field])) ?? 0),
    )
  : listed;

const cell = (value: unknown) => {
  if (value === true) return 'yes';
  if (value === false) return 'no';
  if (value === null || value === undefined || value === '') return '—';
  return String(value);
};
// Show the label of a select value (for example "Main menu" instead of "header").
const labelFor = (field: string, value: unknown) => {
  const f = def.fields.find((x) => x.name === field);
  if (f && f.type === 'ref' && field === def.parent?.field)
    return parentLabel.get(String(value)) ?? cell(value);
  if (f && f.type === 'select') {
    const match = f.options.find(([key]) => key === String(value));
    if (match) return match[1];
  }
  return cell(value);
};
---

<AdminLayout title={def.plural} current={`content:${def.key}`}>
  <main class="admin-main">
    <div class="admin-actions">
      <h1>{def.plural}</h1>
      {def.creatable !== false && (
        <a
          class="admin-btn"
          href={`/admin/content/${def.key}/new${filter && def.parent ? `?${def.parent.field}=${filter}` : ''}`}
        >
          Add {def.singular}
        </a>
      )}
      {def.key === 'pages' && (
        <form method="post" action="/admin/content/pages/seed">
          <button class="admin-btn" type="submit">
            Add the website’s pages
          </button>
        </form>
      )}
    </div>
    <p class="admin-muted">{def.intro}</p>

    {def.parent && parents.length > 0 && (
      <form class="admin-filters" method="get">
        <label>
          <span class="visually-hidden">{parentDef?.singular}</span>
          <select name={def.parent.field}>
            <option value="">All {parentDef?.plural.toLowerCase()}</option>
            {parents.map((p) => (
              <option value={p.value} selected={p.value === filter}>
                {p.label}
              </option>
            ))}
          </select>
        </label>
        <button class="admin-btn admin-btn--ghost" type="submit">
          Show
        </button>
      </form>
    )}

    {sp.has('saved') && (
      <p class="admin-notice" role="status">
        Saved. Publish to show the change on the website.
      </p>
    )}
    {sp.has('deleted') && (
      <p class="admin-notice" role="status">
        Deleted. Publish to remove it from the website.
      </p>
    )}
    {sp.has('seeded') && (
      <p class="admin-notice" role="status">
        The website’s pages are listed. Edit one to set its search text.
      </p>
    )}
    {sp.has('error') && (
      <p class="admin-notice admin-notice--error" role="alert">
        Something went wrong. Please try again.
      </p>
    )}
    {failed && (
      <p class="admin-notice admin-notice--error" role="alert">
        Could not load the list.
      </p>
    )}

    <div class="admin-card admin-table-wrap">
      {rows.length > 0 ? (
        <table class="admin-table">
          <thead>
            <tr>
              {def.columns.map((c) => (
                <th>{c.label}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr>
                {def.columns.map((c) => (
                  <td>
                    {c.field === def.titleField ? (
                      <a href={`/admin/content/${def.key}/${row.id}`}>{cell(row[c.field])}</a>
                    ) : (
                      labelFor(c.field, row[c.field])
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="admin-muted">Nothing here yet.</p>
      )}
    </div>
  </main>
</AdminLayout>

---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;

const STATUSES = [
  ['new', 'New'],
  ['in_progress', 'In progress'],
  ['done', 'Done'],
  ['spam', 'Spam'],
] as const;

const counts = await Promise.all(
  STATUSES.map(async ([status]) => {
    const { count } = await Astro.locals.db
      .from('consultation_requests')
      .select('id', { count: 'exact', head: true })
      .eq('status', status);
    return count ?? 0;
  }),
);
---

<AdminLayout title="Dashboard" current="dashboard">
  <main class="admin-main">
    <h1>Dashboard</h1>

    <section aria-labelledby="req-title" class="admin-section">
      <h2 id="req-title">Consultation requests</h2>
      <p class="admin-muted">The website sends no email, so check here for new requests.</p>
      <ul class="admin-stats">
        {STATUSES.map(([status, label], i) => (
          <li>
            <a
              class:list={['admin-stat', { 'admin-stat--new': status === 'new' }]}
              href={`/admin/consultations?status=${status}`}
            >
              <span class="admin-stat__value">{counts[i]}</span>
              <span class="admin-stat__label">{label}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="admin-card" aria-labelledby="quick-title">
      <h2 id="quick-title">Edit the website</h2>
      <ul class="admin-quick" style="margin-top: 14px">
        <li>
          <a href="/admin/sections">
            Page text<small>Headings and paragraphs of each page</small>
          </a>
        </li>
        <li>
          <a href="/admin/content/services">
            Services and packages<small>Cards, inclusions and prices</small>
          </a>
        </li>
        <li>
          <a href="/admin/doctors">
            Doctors<small>Profiles and photos</small>
          </a>
        </li>
        <li>
          <a href="/admin/content/articles">
            Articles<small>Travel guide and dental knowledge</small>
          </a>
        </li>
        <li>
          <a href="/admin/publish">
            Publish<small>Send your changes to the website</small>
          </a>
        </li>
      </ul>
    </section>
  </main>
</AdminLayout>

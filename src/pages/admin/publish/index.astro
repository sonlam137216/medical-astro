---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { buildSnapshot, hashSnapshot, snapshotProblems } from '../../../lib/snapshot';

export const prerender = false;

const db = Astro.locals.db;

const snapshot = await buildSnapshot(db);
const hash = await hashSnapshot(snapshot);
const problems = snapshotProblems(snapshot);

const { data: revisions } = await db
  .from('content_revisions')
  .select('id, revision_number, content_hash, note, created_at')
  .order('revision_number', { ascending: false })
  .limit(10);
const latest = revisions?.[0] ?? null;
const hasChanges = !latest || latest.content_hash !== hash;

const { data: jobs } = await db
  .from('publish_jobs')
  .select(
    'id, status, queued_at, finished_at, error, deploy_ref, revision_id, content_revisions(revision_number)',
  )
  .order('created_at', { ascending: false })
  .limit(10);

// The revision that is actually live: from the most recent successful deploy (not merely published).
const { data: liveJob } = await db
  .from('publish_jobs')
  .select('finished_at, content_revisions(revision_number)')
  .eq('status', 'deployed')
  .order('finished_at', { ascending: false })
  .limit(1)
  .maybeSingle();
const liveRevision = liveJob?.content_revisions?.revision_number ?? null;

// A build can be retried when nothing for the newest revision is waiting, running or live.
const latestJobs = (jobs ?? []).filter((j) => latest && j.revision_id === latest.id);
const canRetry =
  latest !== null && !latestJobs.some((j) => ['queued', 'building', 'deployed'].includes(j.status));
const building = (jobs ?? []).some((j) => j.status === 'building');

const runUrl = (ref: string | null) =>
  ref && env.GITHUB_REPO ? `https://github.com/${env.GITHUB_REPO}/actions/runs/${ref}` : null;

const when = new Intl.DateTimeFormat('en-GB', {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: 'Asia/Ho_Chi_Minh',
});
const sp = Astro.url.searchParams;
const published = sp.get('published');
const build = sp.get('build');
---

<AdminLayout title="Publish" current="publish">
  <main class="admin-main">
    <h1>Publish</h1>

    {published && (
      <p class="admin-notice" role="status">
        Revision {published} saved.{' '}
        {build === 'triggered' && 'The build has been started. This page shows when it is live.'}
        {build === 'not_configured' &&
          'The build trigger is not set up here, so nothing was started (see PUBLISHING.md).'}
      </p>
    )}
    {build === 'failed' && (
      <p class="admin-notice admin-notice--error" role="alert">
        The revision was saved, but the build could not be started. Use “Build again” below once the
        build trigger is fixed.
      </p>
    )}
    {sp.get('error') === 'busy' && (
      <p class="admin-notice" role="status">
        A build for the newest revision is already waiting, running or live.
      </p>
    )}
    {sp.has('unchanged') && (
      <p class="admin-notice" role="status">
        Nothing changed since the last revision.
      </p>
    )}
    {sp.has('error') && sp.get('error') !== 'busy' && (
      <p class="admin-notice admin-notice--error" role="alert">
        Could not publish.{' '}
        {problems.length > 0 ? 'Please fix the items below.' : 'Please try again.'}
      </p>
    )}
    {problems.length > 0 && (
      <section class="admin-card" aria-labelledby="problems-title">
        <h2 id="problems-title" class="t-h3">
          Fix before publishing
        </h2>
        <ul>
          {problems.map((p) => (
            <li>{p}</li>
          ))}
        </ul>
      </section>
    )}

    <section class="admin-card" aria-labelledby="live-title">
      <h2 id="live-title" class="t-h3">
        On the website
      </h2>
      <p style="margin-top: 8px">
        {liveRevision === null
          ? 'No revision has been built and deployed yet. The website shows sample content from the design.'
          : `Revision ${liveRevision} is live${liveJob?.finished_at ? ` (deployed ${when.format(new Date(liveJob.finished_at))}, Vietnam time)` : ''}.`}
        {latest &&
          liveRevision !== null &&
          latest.revision_number > liveRevision &&
          ` Revision ${latest.revision_number} is saved but not live yet.`}
      </p>
      {building && (
        <p class="admin-muted" style="margin-top: 8px">
          A build is running now.
        </p>
      )}
      {canRetry && (
        <form method="post" action="/admin/publish/retry" style="margin-top: 12px">
          <button class="admin-btn" type="submit">
            Build again
          </button>
          <span class="admin-hint"> Starts a new build of revision {latest?.revision_number}.</span>
        </form>
      )}
    </section>

    <section class="admin-card" aria-labelledby="state-title">
      <h2 id="state-title" class="t-h3">
        Working copy
      </h2>
      <p style="margin-top: 8px">
        {hasChanges
          ? latest
            ? 'There are changes that are not published yet.'
            : 'Nothing has been published yet. The website shows sample content from the design.'
          : `The working copy matches revision ${latest?.revision_number}.`}
      </p>
      <p class="admin-muted" style="margin-top: 8px">
        Includes {snapshot.doctors.length} visible doctor{snapshot.doctors.length === 1 ? '' : 's'}.
        Other content is not managed here yet.
      </p>
      <form
        class="admin-form"
        method="post"
        action="/admin/publish/create"
        style="margin-top: 16px"
      >
        <label>
          Note (optional)
          <input name="note" maxlength="500" placeholder="What changed?" />
        </label>
        <div>
          <button class="admin-btn" type="submit" disabled={!hasChanges || problems.length > 0}>
            Publish
          </button>
        </div>
      </form>
      <p class="admin-hint" style="margin-top: 12px">
        Publishing saves an unchangeable copy (a revision) and starts a build that deploys it. The
        website changes only when that build succeeds; if it fails, the previous version stays live.
        Builds usually take a few minutes.
      </p>
    </section>

    <section class="admin-card admin-table-wrap" aria-labelledby="jobs-title">
      <h2 id="jobs-title" class="t-h3">
        Recent publishes
      </h2>
      {jobs && jobs.length > 0 ? (
        <table class="admin-table" style="margin-top: 12px">
          <thead>
            <tr>
              <th>Revision</th>
              <th>Queued (Vietnam time)</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {jobs.map((j) => (
              <tr>
                <td>#{j.content_revisions?.revision_number ?? '—'}</td>
                <td>{when.format(new Date(j.queued_at))}</td>
                <td>
                  <span class="admin-status" data-status={j.status}>
                    {j.status}
                  </span>
                  {j.error && <div class="admin-field-error">{j.error}</div>}
                  {runUrl(j.deploy_ref) && (
                    <div>
                      <a href={runUrl(j.deploy_ref)!} rel="noopener noreferrer" target="_blank">
                        Build log
                      </a>
                    </div>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="admin-muted">Nothing published yet.</p>
      )}
    </section>
  </main>
</AdminLayout>

---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import SectionIntro from '../../components/SectionIntro.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import TreatmentGrid from '../../components/TreatmentGrid.astro';
import CtaBand from '../../components/CtaBand.astro';
import TreatmentCosts from '../../components/home/TreatmentCosts.astro';
import SeamlessJourney from '../../components/SeamlessJourney.astro';
import FaqList from '../../components/FaqList.astro';
import ServiceArticles from '../../components/ServiceArticles.astro';
import SmileResults from '../../components/SmileResults.astro';
import TreatmentFit from '../../components/TreatmentFit.astro';
import { careCta, serviceFaq } from '../../data/shared';
import { heroImage } from '../../data/home';
import {
  getFaqs,
  getSection,
  getService,
  getServices,
  type PublicService,
} from '../../lib/content';
import { HAND_BUILT_SERVICE_PAGES } from '../../lib/services';
import { breadcrumbJsonLd, faqJsonLd, pageUrl } from '../../lib/seo';
import { getPageBanner } from '../../lib/site-content';

// The page of one service, built from the CMS (Services > a service, and its Treatments), after the Figma
// "General Service Template" (banner, price cards, cost comparison, which treatment fits, how it works, results, FAQ;
// the About text and the call to action are added). The cost comparison is the Home page's table (Page text > Home: treatment costs
// table), the results slider (Smile results) and the FAQ (FAQs) are shared by every service page.
// Dental Implants keeps its own page, written by hand at the same address, with its own table.

export const prerender = true;

export async function getStaticPaths() {
  return (await getServices())
    .filter((service) => !HAND_BUILT_SERVICE_PAGES.includes(service.slug))
    .map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: PublicService;
}

// Read again at render time: the dev server keeps the result of getStaticPaths, so its props would still be the
// revision that was live when the server started (npm run dev:local shows each new publish). Same data in a build.
const service = (await getService(Astro.props.service.slug)) ?? Astro.props.service;
const title = service.seoTitle || `${service.title} · Melatec Dental Clinic`;
const description = service.seoDescription || service.summary || undefined;
// Paragraphs are separated by a blank line.
const paragraphs = (service.description ?? '')
  .split(/\n{2,}/)
  .map((p) => p.trim())
  .filter(Boolean);

// The questions shared by every service page (FAQs): the sample questions before any is published.
const faqHeading = (await getSection('service_faq'))!;
const faqs = await getFaqs(serviceFaq.questions);
const faqData = faqJsonLd(faqs);

const site = Astro.site;
const at = (path: string) => pageUrl(site, path);
const jsonLd = site
  ? [
      breadcrumbJsonLd([
        { name: 'Home', url: at('/') },
        { name: 'Services', url: at('/services') },
        { name: service.title },
      ]),
      ...(faqData ? [faqData] : []),
    ]
  : [];
// The service's own banner, else the Services page's (Pages), else the built-in picture.
const servicesBanner = await getPageBanner('/services');
---

<SiteLayout {title} {description} {jsonLd}>
  <PageHero
    variant="banner"
    upper
    label="Our services"
    image={service.banner ?? servicesBanner ?? heroImage}
    position="75% center"
  >
    <nav slot="top" class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li>
          <a href="/">Home</a>
        </li>
        <li>
          <a href="/services">Services</a>
        </li>
        <li aria-current="page">{service.title}</li>
      </ol>
    </nav>
    <Fragment slot="title">{service.title}</Fragment>
    {service.summary && <p>{service.summary}</p>}
    <Button slot="actions" href="#consultation">
      <Icon name="calendar-time" />
      Book free consultation
    </Button>
  </PageHero>

  <Section tone="soft" labelledby="treatments-title">
    <SectionIntro label="Treatments" headingId="treatments-title" align="center" lined>
      <Fragment slot="title">{service.title} options</Fragment>
    </SectionIntro>
    {service.options.length > 0 ? (
      <TreatmentGrid items={service.options} />
    ) : (
      <div class="quote">
        <p>
          Every treatment plan is different. Send us your details and our team will prepare a
          personalised plan and quote for you.
        </p>
        <Button href="#consultation">Request a quote</Button>
      </div>
    )}
  </Section>

  <TreatmentCosts sectionKey="home_costs" align="center" />

  <TreatmentFit
    situations={service.situations}
    label={service.situationsLabel}
    images={service.situationsImages}
  />

  {paragraphs.length > 0 && (
    <Section labelledby="about-title">
      <SectionIntro label="About the treatment" headingId="about-title" align="center" lined>
        <Fragment slot="title">About {service.title}</Fragment>
      </SectionIntro>
      <div class="prose">
        {paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </Section>
  )}

  <CtaBand {...careCta} />
  <SeamlessJourney />

  <SmileResults />

  {faqs.length > 0 ? (
    <FaqList label={faqHeading.label} title={faqHeading.title} {faqs}>
      <ServiceArticles />
    </FaqList>
  ) : (
    <ServiceArticles standalone />
  )}
</SiteLayout>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    line-height: 20px;
    color: var(--color-muted);
  }

  .crumbs li + li::before {
    content: '›';
    margin-right: 6px;
  }

  .crumbs a {
    color: var(--color-muted);
  }

  .crumbs a:hover {
    color: var(--color-blue);
  }

  .crumbs li[aria-current] {
    color: var(--color-navy);
  }

  .quote {
    display: grid;
    justify-items: center;
    gap: 20px;
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
  }

  .quote p {
    margin: 0;
    color: var(--color-muted);
  }

  .prose {
    display: grid;
    gap: 16px;
    max-width: 720px;
    margin-inline: auto;
  }

  .prose p {
    margin: 0;
    font-size: 17px;
    line-height: 30px;
    white-space: pre-line;
  }
</style>

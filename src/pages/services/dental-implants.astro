---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import SectionIntro from '../../components/SectionIntro.astro';
import Button from '../../components/Button.astro';
import InfoCard from '../../components/cards/InfoCard.astro';
import PriceCard from '../../components/cards/PriceCard.astro';
import TreatmentCosts from '../../components/home/TreatmentCosts.astro';
import SeamlessJourney from '../../components/SeamlessJourney.astro';
import PlanVisit from '../../components/PlanVisit.astro';
import LatestArticles from '../../components/articles/LatestArticles.astro';
import { getPageSeo } from '../../lib/site-content';
import { getFaqs, getSection } from '../../lib/content';
import { faqJsonLd } from '../../lib/seo';

import { heroImage } from '../../data/implants';

export const prerender = true;

// Answers are plain text; a blank line starts a new paragraph.
const paragraphs = (text: string) => text.split(/\n{2,}/);
const hero = (await getSection('implants_hero'))!;
const costs = (await getSection('implants_costs'))!;
const why = (await getSection('implants_why'))!;
const faq = (await getSection('implants_faq'))!;
const faqs = await getFaqs('dental-implants', faq.questions);
const seo = await getPageSeo('/services/dental-implants', {
  title: 'Dental implants · Melatec Dental Clinic',
  description:
    'Single-tooth implants and All-on-4 and All-on-6 restorations, with a personalised treatment plan and estimate before you travel to Vietnam.',
});
const faqData = faqJsonLd(faqs);
---

<!-- The page has its own consultation block and no social row. The header is the standard one (the new Figma has no landing-page header variant). -->
<SiteLayout
  title={seo.title}
  description={seo.description}
  consultation={false}
  consultationAnchor
  social={false}
  jsonLd={faqData ? [faqData] : []}
>
  <PageHero
    variant="banner"
    upper
    label={hero.label}
    image={heroImage}
    imageHeight={440}
    position="85% center"
  >
    <Fragment slot="title">{hero.title}</Fragment>
    <p>{hero.body}</p>
    <Button slot="actions" href="#consultation">
      Book free consultation
    </Button>
  </PageHero>

  {hero.chips.length > 0 && (
    <section class="chips" aria-label="Melatec at a glance">
      <ul class="container chips__list">
        {hero.chips.map((chip) => (
          <li>{chip}</li>
        ))}
      </ul>
    </section>
  )}

  <Section tone="soft" labelledby="prices-title">
    <SectionIntro label={costs.label} headingId="prices-title" align="center" lined>
      <Fragment slot="title">{costs.title}</Fragment>
    </SectionIntro>
    <ul class="grid">
      {costs.cards.map((c, i) => (
        <li>
          <PriceCard
            title={c.title}
            subtitle={c.subtitle}
            inclusions={c.inclusions}
            total={c.total}
            href="#consultation"
            tone={i === 1 ? 'featured' : i === 2 ? 'tint' : 'default'}
          />
        </li>
      ))}
    </ul>
  </Section>

  <TreatmentCosts sectionKey="implants_comparison" align="center" />

  <Section tone="blue" labelledby="why-title">
    <SectionIntro label={why.label} headingId="why-title" align="center" lined inverse>
      <Fragment slot="title">{why.title}</Fragment>
    </SectionIntro>
    <ul class="grid">
      {why.items.map((i) => (
        <li>
          <InfoCard {...i} />
        </li>
      ))}
    </ul>
  </Section>

  <PlanVisit />

  <SeamlessJourney />

  <!-- Figma "Results: Real Stories. Real Smiles." (before/after carousel) is not built: the pictures show a real
       patient, and consent and usage rights are not confirmed (see src/assets/images/SOURCES.md). -->

  <LatestArticles />

  <Section tone="soft" labelledby="faq-title">
    <SectionIntro label={faq.label} headingId="faq-title" align="center" lined>
      <Fragment slot="title">{faq.title}</Fragment>
    </SectionIntro>
    <div class="faq">
      {faqs.map((item, i) => (
        <details open={i === 0}>
          <summary>{item.question}</summary>
          {item.answer && (
            <Fragment>
              {paragraphs(item.answer).map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </Fragment>
          )}
          {/* PLACEHOLDER: the design shows questions only; sample questions have no answer yet. */}
          {!item.answer && <p class="muted">Answer to be provided by Melatec.</p>}
        </details>
      ))}
    </div>
  </Section>
</SiteLayout>

<style>
  /* Figma: three small outlined badges under the banner. */
  .chips {
    padding-block: 28px 0;
  }

  .chips__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-block: 0;
    padding-block: 0;
    list-style: none;
  }

  .chips__list li {
    min-width: 200px;
    padding: 14px 24px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: 0 6px 18px rgb(0 86 229 / 8%);
    font: 500 var(--text-small) / var(--text-small-lh) var(--font-display);
    color: var(--color-title);
    text-align: center;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid li {
    display: flex;
  }

  .grid li > :global(*) {
    flex: 1;
  }

  /* Figma: each question is a bordered card; the open one is tinted. */
  .faq {
    display: grid;
    gap: 12px;
    max-width: 720px;
    margin-inline: auto;
    width: 100%;
  }

  .faq details {
    padding: 16px 24px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .faq details[open] {
    background: var(--color-card);
  }

  .faq summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    list-style: none;
    font: 700 var(--text-body) / var(--text-body-lh) var(--font-display);
    color: var(--color-title);
  }

  @media (max-width: 768px) {
    .faq summary {
      align-items: center;
      min-height: 44px;
    }
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::after {
    content: '+';
    font-size: 24px;
    line-height: 26px;
    color: var(--color-blue);
  }

  .faq details[open] summary::after {
    content: '–';
  }

  .faq details p {
    margin-top: 12px;
    font-size: var(--text-small);
    line-height: var(--text-small-lh);
  }

  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

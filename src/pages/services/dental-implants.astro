---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import SectionIntro from '../../components/SectionIntro.astro';
import Button from '../../components/Button.astro';
import InfoCard from '../../components/cards/InfoCard.astro';
import TreatmentGrid from '../../components/TreatmentGrid.astro';
import TreatmentCosts from '../../components/home/TreatmentCosts.astro';
import SeamlessJourney from '../../components/SeamlessJourney.astro';
import PlanVisit from '../../components/PlanVisit.astro';
import LatestArticles from '../../components/articles/LatestArticles.astro';
import FaqList from '../../components/FaqList.astro';
import ServiceGuide from '../../components/ServiceGuide.astro';
import SmileResults from '../../components/SmileResults.astro';
import TreatmentFit from '../../components/TreatmentFit.astro';
import { getPageSeo, getPageBanner } from '../../lib/site-content';
import { getServiceFaqs, getSection, getService } from '../../lib/content';
import { faqJsonLd } from '../../lib/seo';
import Icon from '../../components/Icon.astro';
import { isIconName } from '../../lib/icons';

import { heroImage } from '../../data/implants';

export const prerender = true;

const hero = (await getSection('implants_hero'))!;
const costs = (await getSection('implants_costs'))!;
// The price cards: the treatments of the Dental Implants service (Services > Dental Implants > Treatments), and
// the "Which treatment fits your situation" cards (Treatment situations).
const service = await getService('dental-implants');
const treatments = service?.options ?? [];
const why = (await getSection('implants_why'))!;
const faq = (await getSection('service_faq'))!;
// Questions authored for Dental Implants only.
const faqs = await getServiceFaqs('dental-implants');
const seo = await getPageSeo('/services/dental-implants', {
  title: 'Dental implants · Melatec Dental Clinic',
  description:
    'Single-tooth implants and All-on-4 and All-on-6 restorations, with a personalised treatment plan and estimate before you travel to Vietnam.',
});
const faqData = faqJsonLd(faqs);
const banner = await getPageBanner('/services/dental-implants');
---

<!-- The page has its own consultation block and no social row. The header is the standard one (the new Figma has no landing-page header variant). -->
<SiteLayout
  title={seo.title}
  description={seo.description}
  consultation={false}
  consultationAnchor
  social={false}
  jsonLd={faqData ? [faqData] : []}
>
  <PageHero
    variant="banner"
    upper
    label={hero.label}
    image={banner ?? heroImage}
    position="85% center"
  >
    <Fragment slot="title">{hero.title}</Fragment>
    <p>{hero.body}</p>
    <Button slot="actions" href="#consultation">
      <Icon name="calendar-time" />
      Book free consultation
    </Button>
  </PageHero>

  {hero.chips.length > 0 && (
    <section class="chips" aria-label="Melatec at a glance">
      <ul class="container chips__list">
        {hero.chips.map((chip) => (
          <li>
            {isIconName(chip.icon) && <Icon class="chips__icon" name={chip.icon} size={28} />}
            {chip.text}
          </li>
        ))}
      </ul>
    </section>
  )}

  {treatments.length > 0 && (
    <Section tone="soft" labelledby="prices-title">
      <SectionIntro label={costs.label} headingId="prices-title" align="center" lined>
        <Fragment slot="title">{costs.title}</Fragment>
      </SectionIntro>
      <TreatmentGrid items={treatments} />
    </Section>
  )}

  <TreatmentCosts sectionKey="implants_comparison" align="center" />

  <TreatmentFit
    situations={service?.situations ?? []}
    label={service?.situationsLabel}
    images={service?.situationsImages}
  />

  <Section tone="blue" labelledby="why-title">
    <SectionIntro label={why.label} headingId="why-title" align="center" lined inverse>
      <Fragment slot="title">{why.title}</Fragment>
    </SectionIntro>
    <ul class="grid">
      {why.items.map((i) => (
        <li>
          <InfoCard {...i} />
        </li>
      ))}
    </ul>
  </Section>

  <PlanVisit />

  <SeamlessJourney />

  <!-- Figma "Results: Real Stories. Real Smiles.": the Smile results pairs belonging to Dental Implants, shown
       only once a pair is published. -->
  <SmileResults serviceSlug="dental-implants" />

  <LatestArticles />

  {faqs.length > 0 ? (
    <FaqList label={faq.label} title={faq.title} {faqs}>
      <ServiceGuide guide={service?.guide ?? null} />
    </FaqList>
  ) : (
    <ServiceGuide guide={service?.guide ?? null} standalone />
  )}
</SiteLayout>

<style>
  /* Figma: small outlined badges under the banner, each with an icon before its text. */
  .chips {
    padding-block: 28px 0;
  }

  .chips__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-block: 0;
    padding-block: 0;
    list-style: none;
  }

  /* Equal widths, four on one row on a wide screen as in Figma; the text wraps next to its icon. */
  .chips__list li {
    display: flex;
    flex: 1 1 200px;
    align-items: center;
    gap: 12px;
    max-width: 280px;
    padding: 14px 18px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: 0 6px 18px rgb(0 86 229 / 8%);
    font: 500 var(--text-small) / var(--text-small-lh) var(--font-display);
    color: var(--color-title);
    text-align: left;
  }

  .chips__icon {
    flex: none;
    color: var(--color-blue);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid li {
    display: flex;
  }

  .grid li > :global(*) {
    flex: 1;
  }

  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import SectionIntro from '../../components/SectionIntro.astro';
import Button from '../../components/Button.astro';
import InfoCard from '../../components/cards/InfoCard.astro';
import PackageCard from '../../components/cards/PackageCard.astro';
import TreatmentCosts from '../../components/home/TreatmentCosts.astro';
import SeamlessJourney from '../../components/SeamlessJourney.astro';
import PlanVisit from '../../components/PlanVisit.astro';
import { getPageSeo } from '../../lib/site-content';
import { getFaqs } from '../../lib/content';
import { stats } from '../../data/about';
import { heroImage, hero, costs, comparison, why, faq } from '../../data/implants';

export const prerender = true;

// Answers are plain text; a blank line starts a new paragraph.
const paragraphs = (text: string) => text.split(/\n{2,}/);
const faqs = await getFaqs('dental-implants', faq.questions);
const seo = await getPageSeo('/services/dental-implants', {
  title: 'Dental implants · Melatec Dental Clinic',
});
// The Figma row has one filled card (30,000+) and three empty ones: only the filled one is shown.
const [stat] = stats;
---

<!-- The page has its own consultation block and no social row. The header is the standard one (the new Figma has no landing-page header variant). -->
<SiteLayout
  title={seo.title}
  description={seo.description}
  consultation={false}
  consultationAnchor
  social={false}
>
  <PageHero
    variant="banner"
    dark
    label={hero.label}
    image={heroImage}
    imageHeight={440}
    position="85% center"
  >
    <Fragment slot="title">{hero.title}</Fragment>
    <p>{hero.body}</p>
    <Button slot="actions" variant="light" href="#consultation">
      Book free consultation
    </Button>
  </PageHero>

  <section class="stat" aria-label="Melatec at a glance">
    <div class="container">
      <p class="stat__card">
        <span class="stat__value">{stat.value}</span>
        <span class="stat__label">{stat.label}</span>
      </p>
    </div>
  </section>

  <Section tone="soft" labelledby="costs-title">
    <SectionIntro label={costs.label} headingId="costs-title" align="center" lined>
      <Fragment slot="title">{costs.title}</Fragment>
    </SectionIntro>
    <ul class="grid">
      {costs.cards.map((c) => (
        <li>
          <PackageCard {...c} href="#consultation" linkLabel="Request an estimate" />
        </li>
      ))}
    </ul>
  </Section>

  <TreatmentCosts label={comparison.label} rows={comparison.rows} align="center">
    <Fragment slot="title">{comparison.title}</Fragment>
  </TreatmentCosts>

  <Section tone="navy" labelledby="why-title">
    <SectionIntro label={why.label} headingId="why-title" align="center" lined inverse>
      <Fragment slot="title">{why.title}</Fragment>
    </SectionIntro>
    <ul class="grid">
      {why.items.map((i) => (
        <li>
          <InfoCard {...i} tone="dark" />
        </li>
      ))}
    </ul>
  </Section>

  <PlanVisit />

  <SeamlessJourney />

  <!-- Figma "Results: Real Stories. Real Smiles." (before/after carousel) is not built: the pictures show a real
       patient, and consent and usage rights are not confirmed (see src/assets/images/SOURCES.md). -->

  <Section tone="soft" labelledby="faq-title">
    <SectionIntro label={faq.label} headingId="faq-title" align="center" lined>
      <Fragment slot="title">{faq.title}</Fragment>
    </SectionIntro>
    <div class="faq">
      {faqs.map((item, i) => (
        <details open={i === 0}>
          <summary>{item.question}</summary>
          {item.answer && (
            <Fragment>
              {paragraphs(item.answer).map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </Fragment>
          )}
          {/* PLACEHOLDER: the design shows questions only; sample questions have no answer yet. */}
          {!item.answer && <p class="muted">Answer to be provided by Melatec.</p>}
        </details>
      ))}
    </div>
  </Section>
</SiteLayout>

<style>
  .stat {
    padding-block: 40px 0;
  }

  .stat__card {
    display: grid;
    gap: 4px;
    width: 260px;
    margin-inline: auto;
    padding: 20px 24px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: 0 6px 18px rgb(0 86 229 / 8%);
    text-align: center;
  }

  .stat__value {
    font: 700 48px / 56px var(--font-serif);
    color: var(--color-title);
  }

  .stat__label {
    font: 500 var(--text-small) / var(--text-small-lh) var(--font-display);
    color: var(--color-navy);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid li {
    display: flex;
  }

  .grid li > :global(*) {
    flex: 1;
  }

  /* Figma: each question is a bordered card; the open one is tinted. */
  .faq {
    display: grid;
    gap: 12px;
    max-width: 720px;
    margin-inline: auto;
    width: 100%;
  }

  .faq details {
    padding: 16px 24px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .faq details[open] {
    background: var(--color-card);
  }

  .faq summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    list-style: none;
    font: 700 var(--text-body) / var(--text-body-lh) var(--font-display);
    color: var(--color-title);
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::after {
    content: '+';
    font-size: 24px;
    line-height: 26px;
    color: var(--color-blue);
  }

  .faq details[open] summary::after {
    content: '–';
  }

  .faq details p {
    margin-top: 12px;
    font-size: var(--text-small);
    line-height: var(--text-small-lh);
  }

  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPageSeo } from '../../lib/site-content';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import ServiceCard from '../../components/cards/ServiceCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import TourismSupport from '../../components/TourismSupport.astro';
import SeamlessJourney from '../../components/SeamlessJourney.astro';
import { towerImage, serviceDetails } from '../../data/shared';

export const prerender = true;

const seo = await getPageSeo('/services', { title: 'Dental services · Melatec Dental Clinic' });
---

<SiteLayout title={seo.title} description={seo.description}>
  <PageHero variant="banner" dark label="Our services." image={towerImage} imageHeight={400}>
    <Fragment slot="title">Comprehensive dental care for every smile</Fragment>
    <p>
      Providing advanced implant, cosmetic, orthodontic, and restorative dental care in a modern,
      patient-focused clinical environment.
    </p>
  </PageHero>

  <Section tone="soft" labelledby="dental-services-title">
    <h2 class="visually-hidden" id="dental-services-title">
      Dental services
    </h2>
    <ul class="grid">
      {serviceDetails.map((s) => (
        <li>
          <ServiceCard {...s} detail />
        </li>
      ))}
    </ul>
  </Section>

  <CtaBand
    actions={[
      { label: 'Book a consultation', href: '#consultation' },
      { label: 'Explore our doctors', href: '/our-doctors' },
    ]}
  />
  <TourismSupport />
  <SeamlessJourney />
</SiteLayout>

<style>
  /* Figma: equal cards, 2 on the first row (centred) and 3 on the second. */
  .grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid li {
    display: flex;
    grid-column: span 2;
  }

  .grid li:nth-child(1) {
    grid-column: 2 / span 2;
  }

  .grid li:nth-child(2) {
    grid-column: 4 / span 2;
  }

  .grid li > :global(*) {
    flex: 1;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .grid li,
    .grid li:nth-child(1),
    .grid li:nth-child(2) {
      grid-column: auto;
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

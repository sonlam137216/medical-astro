---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPageSeo } from '../../lib/site-content';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import ServiceCard from '../../components/cards/ServiceCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import TourismSupport from '../../components/TourismSupport.astro';
import SeamlessJourney from '../../components/SeamlessJourney.astro';
import { towerImage } from '../../data/shared';
import { getSection, getServices } from '../../lib/content';

export const prerender = true;

const services = await getServices();
const hero = (await getSection('services_hero'))!;
const seo = await getPageSeo('/services', {
  title: 'Dental services · Melatec Dental Clinic',
  description:
    'Implant, cosmetic, orthodontic and restorative dental care in a modern, patient-focused clinic in Vietnam.',
});
---

<SiteLayout title={seo.title} description={seo.description}>
  <PageHero variant="banner" dark label={hero.label} image={towerImage} imageHeight={400}>
    <Fragment slot="title">{hero.title}</Fragment>
    {hero.body && <p>{hero.body}</p>}
  </PageHero>

  <Section tone="soft" labelledby="dental-services-title">
    <h2 class="visually-hidden" id="dental-services-title">
      Dental services
    </h2>
    <ul class="grid">
      {services.map((s) => (
        <li id={s.slug ?? undefined}>
          <ServiceCard
            title={s.title}
            body={s.summary}
            href={s.hasPage ? s.href : null}
            image={s.image}
            linkLabel="Explore services"
            detail
          />
        </li>
      ))}
    </ul>
  </Section>

  <CtaBand
    actions={[
      { label: 'Book a consultation', href: '#consultation' },
      { label: 'Explore our doctors', href: '/our-doctors' },
    ]}
  />
  <TourismSupport />
  <SeamlessJourney />
</SiteLayout>

<style>
  /* 3 per row, the last row centred, whatever the number of services. */
  .grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid li {
    display: flex;
    flex: 0 0 calc((100% - 48px) / 3);
  }

  .grid li > :global(*) {
    flex: 1;
  }

  @media (max-width: 900px) {
    .grid li {
      flex-basis: calc((100% - 24px) / 2);
    }
  }

  @media (max-width: 600px) {
    .grid li {
      flex-basis: 100%;
    }
  }
</style>

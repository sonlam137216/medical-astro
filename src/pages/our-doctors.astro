---
import ProfileImage from '../components/ProfileImage.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getPageSeo } from '../lib/site-content';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { towerImage } from '../data/shared';
import { getDoctors } from '../lib/content';

export const prerender = true;

const doctorProfiles = await getDoctors();

const seo = await getPageSeo('/our-doctors', {
  title: 'Our doctors · Melatec Dental Clinic',
  description:
    'Meet the dentists and specialists of Melatec Dental Clinic, who provide implant, cosmetic and restorative care in English.',
});
---

<!-- Figma highlights "About us" in the nav on this page -->
<SiteLayout title={seo.title} description={seo.description} current="/about">
  <PageHero variant="banner" dark label="Our doctors." image={towerImage} imageHeight={400}>
    <Fragment slot="title">Meet our team of experienced specialists</Fragment>
    <p>
      From cosmetic dentistry and dental implants to restorative treatments and general dental care,
      Melatec Dental Clinic provides comprehensive solutions for patients who want to improve their
      smiles while enjoying their stay in Vietnam.
    </p>
    <Fragment slot="extra">
      <p class="hero-chip">15+ Years of Experience</p>
      <p class="hero-chip">English-speaking doctors</p>
    </Fragment>
  </PageHero>

  <Section tone="soft" labelledby="profiles-title">
    <h2 class="visually-hidden" id="profiles-title">
      Doctor profiles
    </h2>
    <ul class="profiles">
      {doctorProfiles.map((d) => (
        <li class="profile">
          {d.image ? (
            <ProfileImage
              class="profile__img"
              image={d.image}
              width={282}
              height={422}
              sizes="(max-width: 700px) 60vw, 240px"
            />
          ) : (
            <div class="profile__img profile__initials" aria-hidden="true">
              {d.name
                .replace(/^(dr|prof|assoc\. prof)\.?\s+/i, '')
                .split(/\s+/)
                .slice(-2)
                .map((w) => w[0]?.toUpperCase() ?? '')
                .join('')}
            </div>
          )}
          <div class="profile__text">
            {d.role && <p class="profile__role">{d.role}</p>}
            <h3 class="profile__name">{d.name}</h3>
            {d.bio && <p class="t-small profile__bio">{d.bio}</p>}
            {d.credentials.length > 0 && (
              <ul class="profile__creds">
                {d.credentials.map((c) => (
                  <li class="t-small">{c}</li>
                ))}
              </ul>
            )}
            {d.languages.length > 0 && (
              <ul class="profile__langs" aria-label="Languages spoken">
                {d.languages.map((l) => (
                  <li>{l}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ul>
  </Section>
</SiteLayout>

<style>
  .profiles {
    display: grid;
    gap: 24px;
    max-width: 880px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .profile {
    display: grid;
    grid-template-columns: 240px 1fr;
    align-items: center;
    gap: 40px;
    padding: 24px 32px 24px 24px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: 0 6px 18px rgb(0 86 229 / 6%);
  }

  .profile__img {
    width: 100%;
    height: auto;
    aspect-ratio: 282 / 422;
    object-fit: contain;
    object-position: center bottom;
  }

  .profile__initials {
    display: grid;
    place-items: center;
    font: 700 72px / 1 var(--font-serif);
    color: var(--color-heading);
    background: var(--color-soft);
    border-radius: 12px;
  }

  .profile__text {
    display: grid;
    gap: 10px;
    align-content: start;
    color: var(--color-navy);
  }

  /* Figma: role in serif blue above a bold navy name. */
  .profile__role {
    font: 700 22px / 28px var(--font-serif);
    color: var(--color-blue);
  }

  .profile__name {
    font: 700 24px / 30px var(--font-sans);
    color: var(--color-heading);
  }

  .profile__bio {
    color: var(--color-muted);
  }

  .profile__creds {
    display: grid;
    gap: 8px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .profile__creds li {
    position: relative;
    padding-left: 22px;
  }

  .profile__creds li::before {
    content: '';
    position: absolute;
    top: 7px;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-title);
  }

  .profile__langs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }

  .profile__langs li {
    padding: 6px 18px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-card);
    font: 700 var(--text-small) / 20px var(--font-sans);
    color: var(--color-title);
  }

  @media (max-width: 700px) {
    .profile {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 20px;
    }

    .profile__img {
      max-width: 220px;
      justify-self: center;
    }
  }
</style>

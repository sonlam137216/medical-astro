---
import ProfileImage from '../components/ProfileImage.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { towerImage } from '../data/shared';
import { getDoctors } from '../lib/content';

export const prerender = true;

const doctorProfiles = await getDoctors();
---

<!-- Figma highlights "About us" in the nav on this page -->
<SiteLayout title="Our doctors · Melatec Dental Clinic" current="/about">
  <PageHero label="Our doctors." image={towerImage} imageHeight={298} upper>
    <Fragment slot="title">Meet our team of experienced specialists</Fragment>
    <p>
      From cosmetic dentistry and dental implants to restorative treatments and general dental care,
      Melatec Dental Clinic provides comprehensive solutions for patients who want to improve their
      smiles while enjoying their stay in Vietnam.
    </p>
    <Fragment slot="extra">
      <p>15+ Years of Experience</p>
      <p>English-speaking doctors</p>
    </Fragment>
  </PageHero>

  <Section labelledby="profiles-title">
    <h2 class="visually-hidden" id="profiles-title">
      Doctor profiles
    </h2>
    <ul class="profiles">
      {doctorProfiles.map((d) => (
        <li class="card profile">
          {d.image ? (
            <ProfileImage
              class="profile__img"
              image={d.image}
              width={282}
              height={422}
              sizes="(max-width: 700px) 60vw, 282px"
            />
          ) : (
            <div class="profile__img profile__initials" aria-hidden="true">
              {d.name
                .replace(/^(dr|prof|assoc\. prof)\.?\s+/i, '')
                .split(/\s+/)
                .slice(-2)
                .map((w) => w[0]?.toUpperCase() ?? '')
                .join('')}
            </div>
          )}
          <div class="profile__text">
            <h3 class="t-h3">{d.name}</h3>
            {d.role && <p class="t-small">{d.role}</p>}
            {d.bio && <p class="t-small profile__bio">{d.bio}</p>}
            <ul class="profile__creds">
              {d.credentials.map((c) => (
                <li class="t-small">{c}</li>
              ))}
              {d.languages.length > 0 && (
                <li class="t-small">Languages: {d.languages.join(', ')}</li>
              )}
            </ul>
          </div>
        </li>
      ))}
    </ul>
  </Section>
</SiteLayout>

<style>
  .profiles {
    display: grid;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .profile {
    display: grid;
    grid-template-columns: 282px 1fr;
    align-items: start;
    gap: 40px;
    padding: 24px;
  }

  .profile__img {
    width: 100%;
    height: auto;
    aspect-ratio: 282 / 422;
    object-fit: contain;
    object-position: center bottom;
  }

  .profile__initials {
    display: grid;
    place-items: center;
    font: 600 72px / 1 var(--font-serif);
    color: var(--color-heading);
    background: var(--color-soft);
    border-radius: 12px;
  }

  .profile__text {
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .profile__bio {
    max-width: 760px;
  }

  .profile__creds {
    display: grid;
    gap: 10px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 700px) {
    .profile {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .profile__img {
      max-width: 240px;
    }
  }
</style>

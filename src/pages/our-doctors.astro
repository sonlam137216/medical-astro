---
import ProfileImage from '../components/ProfileImage.astro';
import { frameAspect, IMAGE_SLOTS } from '../lib/image-slots';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getPageSeo, getPageBanner } from '../lib/site-content';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { heroImage } from '../data/home';
import { getDoctors, getSection } from '../lib/content';

export const prerender = true;

const doctorProfiles = await getDoctors();
const hero = (await getSection('doctors_hero'))!;

const seo = await getPageSeo('/our-doctors', {
  title: 'Our doctors · Melatec Dental Clinic',
  description:
    'Meet the dentists and specialists of Melatec Dental Clinic, who provide implant, cosmetic and restorative care in English.',
});
const banner = await getPageBanner('/our-doctors');
---

<!-- Figma highlights "About us" in the nav on this page -->
<SiteLayout title={seo.title} description={seo.description} current="/about">
  <PageHero
    variant="banner"
    upper
    label={hero.label}
    image={banner ?? heroImage}
    position="75% center"
  >
    <Fragment slot="title">{hero.title}</Fragment>
    {hero.body && <p>{hero.body}</p>}
    <Fragment slot="extra">
      {hero.chips.map((chip) => (
        <p class="hero-chip">{chip}</p>
      ))}
    </Fragment>
  </PageHero>

  <Section tone="soft" labelledby="profiles-title">
    <h2 class="visually-hidden" id="profiles-title">
      Doctor profiles
    </h2>
    <ul class="profiles">
      {doctorProfiles.map((d) => (
        <li class="profile">
          {d.image ? (
            <ProfileImage
              class="profile__img"
              image={d.image}
              slot="doctor"
              sizes="(max-width: 700px) 60vw, 240px"
            />
          ) : (
            <div
              class="profile__img profile__initials"
              style={`aspect-ratio: ${frameAspect(IMAGE_SLOTS.doctor)}`}
              aria-hidden="true"
            >
              {d.name
                .replace(/^(dr|prof|assoc\. prof)\.?\s+/i, '')
                .split(/\s+/)
                .slice(-2)
                .map((w) => w[0]?.toUpperCase() ?? '')
                .join('')}
            </div>
          )}
          <div class="profile__text">
            {d.role && <p class="profile__role">{d.role}</p>}
            <h3 class="profile__name">{d.name}</h3>
            {d.bio && <p class="t-small profile__bio">{d.bio}</p>}
            {d.credentials.length > 0 && (
              <ul class="profile__creds">
                {d.credentials.map((c) => (
                  <li class="t-small">{c}</li>
                ))}
              </ul>
            )}
            {d.languages.length > 0 && (
              <ul class="profile__langs" aria-label="Languages spoken">
                {d.languages.map((l) => (
                  <li>
                    {/* A drawn flag: Windows shows the 🇬🇧 emoji of the design as the letters "GB". */}
                    {l === 'English' && (
                      <svg
                        class="flag"
                        viewBox="0 0 60 30"
                        width="20"
                        height="10"
                        aria-hidden="true"
                        focusable="false"
                      >
                        <rect width="60" height="30" fill="#012169" />
                        <path d="M0 0l60 30M60 0L0 30" stroke="#fff" stroke-width="6" />
                        <path d="M0 0l60 30M60 0L0 30" stroke="#c8102e" stroke-width="2" />
                        <path d="M30 0v30M0 15h60" stroke="#fff" stroke-width="10" />
                        <path d="M30 0v30M0 15h60" stroke="#c8102e" stroke-width="6" />
                      </svg>
                    )}
                    {l}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ul>
  </Section>
</SiteLayout>

<style>
  .profiles {
    display: grid;
    gap: 24px;
    max-width: 880px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .profile {
    display: grid;
    grid-template-columns: 240px 1fr;
    align-items: center;
    gap: 40px;
    padding: 24px 32px 24px 24px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: 0 6px 18px rgb(0 86 229 / 6%);
  }

  .profile__img {
    width: 100%;
    height: auto;
  }

  .profile__initials {
    display: grid;
    place-items: center;
    font: 700 72px / 1 var(--font-display);
    color: var(--color-heading);
    background: var(--color-soft);
    border-radius: 12px;
  }

  .profile__text {
    display: grid;
    gap: 10px;
    align-content: start;
    color: var(--color-navy);
  }

  /* Figma: role in bold blue Montserrat above a bold navy name. */
  .profile__role {
    font: 700 20px / 28px var(--font-display);
    color: var(--color-blue);
  }

  .profile__name {
    font: 700 24px / 30px var(--font-sans);
    color: var(--color-heading);
  }

  .profile__bio {
    color: var(--color-muted);
  }

  .profile__creds {
    display: grid;
    gap: 8px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .profile__creds li {
    position: relative;
    padding-left: 22px;
  }

  .profile__creds li::before {
    content: '';
    position: absolute;
    top: 7px;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-title);
  }

  .profile__langs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }

  .profile__langs li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 18px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-card);
    font: 700 var(--text-small) / 20px var(--font-sans);
    color: var(--color-title);
  }

  .flag {
    flex: none;
    border-radius: 2px;
  }

  @media (max-width: 700px) {
    .profile {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 20px;
    }

    .profile__img {
      max-width: 220px;
      justify-self: center;
    }
  }
</style>

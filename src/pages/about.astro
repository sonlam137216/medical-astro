---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getPageSeo } from '../lib/site-content';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionIntro from '../components/SectionIntro.astro';
import Button from '../components/Button.astro';
import InfoCard from '../components/cards/InfoCard.astro';
import DoctorCard from '../components/cards/DoctorCard.astro';
import CtaBand from '../components/CtaBand.astro';
import SeamlessJourney from '../components/SeamlessJourney.astro';
import { heroImage } from '../data/home';
import { getDoctors } from '../lib/content';
import { aboutHero, stats, personalisedCare, whyChoose, insideClinic } from '../data/about';

export const prerender = true;

const doctors = (await getDoctors())
  .slice(0, 4)
  .map(({ name, role, image }) => ({ name, role, image }));

// Figma lays the clinic photos out as two columns, the right one shifted down.
const galleryColumns = [
  insideClinic.photos.filter((_, i) => i % 2 === 0),
  insideClinic.photos.filter((_, i) => i % 2 === 1),
];

const seo = await getPageSeo('/about', {
  title: 'About us · Melatec Dental Clinic',
  description:
    'Learn about Melatec Dental Clinic: modern dental technology, experienced dentists and personalised care for international patients in Vietnam.',
});
---

<SiteLayout title={seo.title} description={seo.description}>
  <PageHero
    variant="banner"
    label={aboutHero.label}
    image={heroImage}
    imageHeight={480}
    upper
    position="75% center"
  >
    <Fragment slot="title">{aboutHero.title}</Fragment>
    {aboutHero.paragraphs.map((p) => (
      <p>{p}</p>
    ))}
    <Button slot="actions" href="#consultation">
      Book free consultation
    </Button>
  </PageHero>

  <section class="stats" aria-label="Melatec at a glance">
    <div class="container">
      <ul class="stats__grid">
        {stats.map((s) => (
          <li class="stats__card">
            <span class="stats__value">{s.value}</span>
            <span class="stats__label">{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Section tone="soft" labelledby="care-title">
    <SectionIntro label={personalisedCare.label} headingId="care-title" align="center" lined>
      <Fragment slot="title">{personalisedCare.title}</Fragment>
    </SectionIntro>
    <div class="care">
      {personalisedCare.rows.map((row) => (
        <div class="care__row">
          <Image
            class="care__img"
            src={row.image.src}
            alt={row.image.alt}
            width={568}
            height={379}
            densities={[1, 2]}
            sizes="(max-width: 900px) 100vw, 520px"
            loading="lazy"
          />
          <div class="care__text">
            <h3 class="care__title">{row.title}</h3>
            <p>{row.body}</p>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <Section tone="navy" labelledby="why-title">
    <SectionIntro label={whyChoose.label} headingId="why-title" align="center" lined inverse>
      <Fragment slot="title">{whyChoose.title}</Fragment>
    </SectionIntro>
    <ul class="cards">
      {whyChoose.items.map((i) => (
        <li>
          <InfoCard {...i} tone="dark" />
        </li>
      ))}
    </ul>
  </Section>

  <Section labelledby="inside-title">
    <SectionIntro label={insideClinic.label} headingId="inside-title" align="center" lined>
      <Fragment slot="title">{insideClinic.title}</Fragment>
    </SectionIntro>
    <div class="photos">
      {galleryColumns.map((column) => (
        <ul class="photos__col">
          {column.map((p) => (
            <li>
              <Image
                class="photos__img"
                src={p.src}
                alt={p.alt}
                width={512}
                height={384}
                densities={[1, 2]}
                sizes="(max-width: 640px) 100vw, 512px"
                loading="lazy"
              />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </Section>

  <CtaBand
    actions={[
      { label: 'Book a consultation', href: '#consultation' },
      { label: 'Explore our services', href: '/services' },
    ]}
  />

  <Section tone="soft" labelledby="specialists-title">
    <SectionIntro label="Our doctors" headingId="specialists-title" align="center" lined>
      <Fragment slot="title">Meet Melatec’s Specialists</Fragment>
    </SectionIntro>
    <ul class="doctors">
      {doctors.map((d) => (
        <li>
          <DoctorCard {...d} />
        </li>
      ))}
    </ul>
    <div class="more">
      <Button variant="outline" href="/our-doctors">
        View all doctors
      </Button>
    </div>
  </Section>

  <SeamlessJourney />
</SiteLayout>

<style>
  .stats {
    padding-block: 40px 0;
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stats__card {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 24px 20px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: 0 6px 18px rgb(0 86 229 / 8%);
  }

  .stats__value {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 48px;
    line-height: 56px;
    color: var(--color-title);
  }

  .stats__label {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-small);
    line-height: var(--text-small-lh);
    color: var(--color-navy);
  }

  .care {
    display: grid;
    gap: 40px;
  }

  .care__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 64px;
  }

  .care__row:nth-child(even) .care__img {
    order: 2;
  }

  .care__img {
    width: 100%;
    height: auto;
    aspect-ratio: 568 / 379;
    object-fit: cover;
    border-radius: var(--radius-card);
  }

  .care__text {
    display: grid;
    gap: 16px;
    max-width: 440px;
    font-family: var(--font-display);
    color: var(--color-navy);
  }

  .care__title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 30px;
    line-height: 36px;
    color: var(--color-heading);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    max-width: 800px;
    margin-inline: auto;
  }

  .photos__col {
    display: grid;
    align-content: start;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .photos__col:nth-child(even) {
    padding-top: 48px;
  }

  .photos__img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-card);
  }

  .doctors {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .doctors li {
    display: flex;
  }

  .doctors li > :global(*) {
    flex: 1;
  }

  .more {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 1024px) {
    .stats__grid,
    .doctors {
      grid-template-columns: repeat(2, 1fr);
    }

    .cards {
      grid-template-columns: repeat(2, 1fr);
    }

    .care__row {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .care__row:nth-child(even) .care__img {
      order: 0;
    }

    .care__text {
      max-width: none;
    }
  }

  @media (max-width: 600px) {
    .cards,
    .doctors {
      grid-template-columns: 1fr;
    }

    .stats__grid {
      gap: 12px;
    }

    .stats__card {
      padding: 16px 14px;
    }

    .stats__value {
      font-size: 36px;
      line-height: 44px;
    }

    .photos {
      gap: 16px;
    }

    .photos__col {
      gap: 16px;
    }

    .photos__col:nth-child(even) {
      padding-top: 24px;
    }
  }
</style>

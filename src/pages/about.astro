---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getPageSeo, getPageBanner } from '../lib/site-content';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionIntro from '../components/SectionIntro.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import InfoCard from '../components/cards/InfoCard.astro';
import DoctorCard from '../components/cards/DoctorCard.astro';
import CtaBand from '../components/CtaBand.astro';
import SeamlessJourney from '../components/SeamlessJourney.astro';
import ProfileImage from '../components/ProfileImage.astro';
import { itemInput } from '../lib/cms/fields';
import { CLINIC_PHOTOS } from '../lib/cms/sections';
import { heroImage } from '../data/home';
import { getDoctors, getSection } from '../lib/content';

export const prerender = true;

const aboutHero = (await getSection('about_hero'))!;
const statsSection = await getSection('about_stats');
const personalisedCare = (await getSection('about_care'))!;
const whyChoose = (await getSection('about_why'))!;
const insideClinic = await getSection('about_inside');
const doctors = (await getDoctors())
  .slice(0, 4)
  .map(({ name, role, image }) => ({ name, role, image }));

// Figma (2026-10-17): two big photos on the left; two smaller ones over two squares on the right. Each place shows
// the photo chosen for it in Page text, or the built-in one.
const clinicPhotos =
  insideClinic &&
  CLINIC_PHOTOS.map(([name, , slot], i) => ({
    image: insideClinic.chosenPhotos[name] ?? insideClinic.photos[i]!,
    slot,
  }));

const seo = await getPageSeo('/about', {
  title: 'About us · Melatec Dental Clinic',
  description:
    'Learn about Melatec Dental Clinic: modern dental technology, experienced dentists and personalised care for international patients in Vietnam.',
});
const banner = await getPageBanner('/about');
---

<SiteLayout title={seo.title} description={seo.description} theme="sans">
  <PageHero
    variant="banner"
    label={aboutHero.label}
    image={banner ?? heroImage}
    upper
    position="75% center"
  >
    <Fragment slot="title">{aboutHero.title}</Fragment>
    {aboutHero.paragraphs.map((p) => (
      <p>{p}</p>
    ))}
    <Button slot="actions" href="#consultation">
      <Icon name="calendar-time" />
      Book free consultation
    </Button>
  </PageHero>

  {statsSection && statsSection.items.length > 0 && (
    <section class="stats" aria-label="Melatec at a glance">
      <div class="container">
        <ul class="stats__grid">
          {statsSection.items.map((s) => (
            <li class="stats__card">
              <span class="stats__value">{s.value}</span>
              <span class="stats__label">{s.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <Section tone="soft" labelledby="care-title">
    <SectionIntro label={personalisedCare.label} headingId="care-title" align="center" lined>
      <Fragment slot="title">{personalisedCare.title}</Fragment>
    </SectionIntro>
    <div class="care">
      {personalisedCare.rows.map((row, i) => (
        <div class="care__row">
          <ProfileImage
            class="care__img"
            image={personalisedCare.chosenPhotos[itemInput('rows', i, 'photo')] ?? row.image}
            slot="about-care"
            width={568}
            height={379}
            sizes="(max-width: 900px) 100vw, 520px"
          />
          <div class="care__text">
            <h3 class="care__title">{row.title}</h3>
            <p>{row.body}</p>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <Section tone="blue" labelledby="why-title">
    <SectionIntro label={whyChoose.label} headingId="why-title" align="center" lined inverse>
      <Fragment slot="title">{whyChoose.title}</Fragment>
    </SectionIntro>
    <ul class="cards">
      {whyChoose.items.map((i) => (
        <li>
          <InfoCard {...i} />
        </li>
      ))}
    </ul>
  </Section>

  {insideClinic && clinicPhotos && (
    <Section labelledby="inside-title">
      <SectionIntro label={insideClinic.label} headingId="inside-title" align="center" lined>
        <Fragment slot="title">{insideClinic.title}</Fragment>
      </SectionIntro>
      <div class="photos">
        <ul class="photos__big">
          {clinicPhotos.slice(0, 2).map((p) => (
            <li>
              <ProfileImage
                class="photos__img"
                image={p.image}
                slot={p.slot}
                sizes="(max-width: 768px) 50vw, 400px"
              />
            </li>
          ))}
        </ul>
        <ul class="photos__small">
          {clinicPhotos.slice(2).map((p) => (
            <li>
              <ProfileImage
                class="photos__img"
                image={p.image}
                slot={p.slot}
                sizes="(max-width: 768px) 50vw, 320px"
              />
            </li>
          ))}
        </ul>
      </div>
    </Section>
  )}

  <CtaBand
    bright
    actions={[
      { label: 'Book a consultation', href: '#consultation' },
      { label: 'Explore our services', href: '/services' },
    ]}
  />

  <Section tone="soft" labelledby="specialists-title">
    <SectionIntro label="Our doctors" headingId="specialists-title" align="center" lined>
      <Fragment slot="title">Meet Our Specialists</Fragment>
    </SectionIntro>
    <ul class="doctors">
      {doctors.map((d) => (
        <li>
          <DoctorCard {...d} />
        </li>
      ))}
    </ul>
    <div class="more">
      <Button variant="outline" href="/our-doctors">
        View Our Doctors
      </Button>
    </div>
  </Section>

  <SeamlessJourney />
</SiteLayout>

<style>
  .stats {
    padding-block: 40px 0;
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stats__card {
    display: grid;
    min-width: 0;
    align-content: start;
    gap: 4px;
    padding: 24px 20px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: 0 6px 18px rgb(0 86 229 / 8%);
  }

  .stats__value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 40px;
    line-height: 48px;
    color: var(--color-title);
  }

  .stats__label {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-small);
    line-height: var(--text-small-lh);
    color: var(--color-navy);
  }

  .care {
    display: grid;
    gap: 40px;
  }

  .care__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 64px;
  }

  .care__row:nth-child(even) .care__img {
    order: 2;
  }

  .care__img {
    width: 100%;
    height: auto;
    aspect-ratio: 568 / 379;
    object-fit: cover;
    border-radius: var(--radius-card);
  }

  .care__text {
    display: grid;
    gap: 16px;
    max-width: 440px;
    font-family: var(--font-display);
    color: var(--color-navy);
  }

  .care__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 26px;
    line-height: 34px;
    color: var(--color-blue);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Clinic photos: Figma widths 356 | 279 + 279, the right block as tall as the left one. */
  .photos {
    display: grid;
    grid-template-columns: 356fr 583fr;
    gap: 24px;
  }

  .photos ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .photos__big {
    display: grid;
    align-content: start;
    gap: 20px;
  }

  .photos__small {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto 1fr;
    gap: 24px;
  }

  .photos li {
    min-width: 0;
    min-height: 0;
  }

  .photos__img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
  }

  /* The squares fill what is left under the top pair, so both sides end on the same line. */
  .photos__small li:nth-child(n + 3) .photos__img {
    height: 100%;
  }

  .doctors {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .doctors li {
    display: flex;
  }

  .doctors li > :global(*) {
    flex: 1;
  }

  .more {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 1024px) {
    .stats__grid,
    .doctors {
      grid-template-columns: repeat(2, 1fr);
    }

    .cards {
      grid-template-columns: repeat(2, 1fr);
    }

    .care__row {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .care__row:nth-child(even) .care__img {
      order: 0;
    }

    .care__text {
      max-width: none;
    }
  }

  /* Not in Figma: tablets and phones stack the two blocks, the big photos side by side. */
  @media (max-width: 768px) {
    .photos {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .photos__big {
      grid-template-columns: 1fr 1fr;
    }

    .photos__big,
    .photos__small {
      gap: 16px;
    }

    .photos__small li:nth-child(n + 3) .photos__img {
      height: auto;
    }
  }

  @media (max-width: 600px) {
    .cards,
    .doctors {
      grid-template-columns: 1fr;
    }

    .stats__grid {
      gap: 12px;
    }

    .stats__card {
      padding: 16px 14px;
    }

    .stats__value {
      font-size: 26px;
      line-height: 34px;
    }
  }
</style>

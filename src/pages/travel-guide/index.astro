---
import ArticleIndex from '../../components/articles/ArticleIndex.astro';
import { getArticles, getArticleCategories } from '../../lib/content';
import { getPageSeo } from '../../lib/site-content';

export const prerender = true;

const [articles, categories] = await Promise.all([
  getArticles('travel_guide'),
  getArticleCategories('travel_guide'),
]);
const seo = await getPageSeo('/travel-guide', {
  title: 'Dental travel guide · Melatec Dental Clinic',
});
---

<!-- Figma "Dental Travel Guide". The intro line is not in Figma (it repeats the Services text there). -->
<ArticleIndex
  title={seo.title}
  description={seo.description}
  label="Dental travel guide"
  heading="Discover Beautiful Vietnam."
  intro="Practical tips and places to explore when you plan a trip around your dental treatment in Vietnam."
  articles={articles}
  categories={categories}
/>

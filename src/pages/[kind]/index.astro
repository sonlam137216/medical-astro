---
import ArticleListPage from '../../components/articles/ArticleListPage.astro';
import { ARTICLE_SEGMENTS } from '../../data/article-lists';

export const prerender = true;

// /travel-guide and /dental-knowledge: page 1 of the whole list. Later pages are in page/[page].astro.
export function getStaticPaths() {
  return ARTICLE_SEGMENTS.map(([segment, kind]) => ({
    params: { kind: segment },
    props: { kind },
  }));
}

const { kind } = Astro.props;
---

<ArticleListPage {kind} page={1} />

---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPageSeo } from '../../lib/site-content';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import PackageGrid from '../../components/PackageGrid.astro';
import CtaBand from '../../components/CtaBand.astro';
import TourismSupport from '../../components/TourismSupport.astro';
import { towerImage } from '../../data/shared';
import { getSection } from '../../lib/content';

export const prerender = true;

const hero = (await getSection('packages_hero'))!;
const seo = await getPageSeo('/dental-packages', {
  title: 'Dental packages · Melatec Dental Clinic',
  description:
    'Explore the dental packages of Melatec Dental Clinic, from single treatments to combos you can pair with a trip in Vietnam.',
});
---

<!-- Figma frame: "Dental Packages / Single Treatments" -->
<SiteLayout title={seo.title} description={seo.description}>
  <PageHero variant="banner" dark label={hero.label} image={towerImage} imageHeight={400}>
    <Fragment slot="title">{hero.title}</Fragment>
    {hero.body && <p>{hero.body}</p>}
    <!-- Not in Figma: the two package pages have no link between them there. Remove if the owner prefers another entry point. -->
    <Button slot="actions" variant="light" href="/dental-packages/travel-combos">
      See travel combos
    </Button>
  </PageHero>

  <PackageGrid kind="single_treatment" />

  <CtaBand
    actions={[
      { label: 'Book a consultation', href: '#consultation' },
      { label: 'Explore our services', href: '/services' },
    ]}
  />
  <TourismSupport />
</SiteLayout>

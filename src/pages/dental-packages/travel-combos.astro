---
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import SectionIntro from '../../components/SectionIntro.astro';
import Button from '../../components/Button.astro';
import DestinationCard from '../../components/cards/DestinationCard.astro';
import LocationCard from '../../components/cards/LocationCard.astro';
import PackageGrid from '../../components/PackageGrid.astro';
import CtaBand from '../../components/CtaBand.astro';
import { towerImage } from '../../data/shared';
import { gallery, destinations, discover } from '../../data/packages';

export const prerender = true;
---

<!-- Figma frame: "Dental Packages / Travel Combos". Order and the missing social row follow the design. -->
<SiteLayout title="Travel combos · Melatec Dental Clinic" current="/dental-packages" social={false}>
  <PageHero label="Our dental packages." image={towerImage} imageHeight={480} rounded upper>
    <Fragment slot="title">Comprehensive dental care for every smile</Fragment>
    <p>
      Plan your dental care alongside a relaxing travel experience. Explore some of Vietnam’s most
      popular destinations while your treatment schedule is arranged around your trip.
    </p>
  </PageHero>

  <Section labelledby="gallery-title">
    <h2 class="visually-hidden" id="gallery-title">
      Vietnam travel gallery
    </h2>
    <ul class="gallery">
      {gallery.map((img) => (
        <li>
          <Image
            class="gallery__img"
            src={img.src}
            alt={img.alt}
            width={384}
            height={256}
            densities={[1, 2]}
            sizes="(max-width: 640px) 100vw, 384px"
            loading="lazy"
          />
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="soft" labelledby="destinations-title">
    <SectionIntro label={destinations.label} headingId="destinations-title">
      <Fragment slot="title">{destinations.title}</Fragment>
    </SectionIntro>
    <ul class="destinations">
      {destinations.cards.map((c) => (
        <li>
          <DestinationCard {...c} />
        </li>
      ))}
    </ul>
  </Section>

  <CtaBand
    actions={[
      { label: 'Book a consultation', href: '#consultation' },
      { label: 'Explore our services', href: '/services', variant: 'outline-light' },
    ]}
  />

  <PackageGrid intro={{ label: 'Cost', title: 'Dental Tourism Package Prices' }} />

  <Fragment slot="after-consultation">
    <Section tone="soft" labelledby="discover-title">
      <SectionIntro label={discover.label} headingId="discover-title">
        <Fragment slot="title">{discover.title}</Fragment>
      </SectionIntro>
      <ul class="discover">
        {discover.cards.map((c) => (
          <li>
            <LocationCard {...c} detail />
          </li>
        ))}
      </ul>
      <div>
        <Button variant="outline" href={discover.cta.href}>
          {discover.cta.label}
        </Button>
      </div>
    </Section>
  </Fragment>
</SiteLayout>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery__img {
    width: 100%;
    height: auto;
    aspect-ratio: 384 / 256;
    object-fit: cover;
    border-radius: var(--radius-card);
  }

  .destinations {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .discover {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .destinations li,
  .discover li {
    display: flex;
  }

  .destinations li > :global(*),
  .discover li > :global(*) {
    flex: 1;
  }

  @media (max-width: 1100px) {
    .destinations {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 960px) {
    .gallery,
    .discover {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .gallery,
    .destinations,
    .discover {
      grid-template-columns: 1fr;
    }
  }
</style>

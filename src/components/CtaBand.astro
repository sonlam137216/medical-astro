---
import Button from './Button.astro';

interface Action {
  label: string;
  href: string;
  variant?: 'light' | 'outline-light';
}

interface Props {
  label?: string;
  title?: string;
  actions: Action[];
}

const {
  label = 'Take the first step',
  title = 'Begin Your Personalized Dental Journey',
  actions,
} = Astro.props;
---

<section class="band" aria-labelledby="cta-title">
  <div class="container cta">
    <p class="t-label is-lined cta__label">{label}</p>
    <h2 class="t-h2 cta__title" id="cta-title">
      {title}
    </h2>
    <div class="cta__actions">
      {actions.map((a) => (
        <Button href={a.href} variant={a.variant ?? 'light'}>
          {a.label}
        </Button>
      ))}
    </div>
  </div>
</section>

<style>
  /* Figma: centred eyebrow with rules, serif title, two white buttons side by side, on the navy gradient. */
  .band {
    padding-block: calc(var(--section-pad-y) * 0.75);
    background: var(--gradient-band);
  }

  .cta {
    display: grid;
    justify-items: center;
    gap: 16px;
    text-align: center;
  }

  .cta__label,
  .cta__title {
    color: var(--color-white);
  }

  .cta__title {
    font-family: var(--font-serif);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 8px;
  }
</style>

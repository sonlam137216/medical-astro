---
import Button from './Button.astro';

interface Action {
  label: string;
  href: string;
  variant?: 'light' | 'outline-light';
}

interface Props {
  label?: string;
  title?: string;
  actions: Action[];
  /** Bright blue band with a Montserrat title (About in Figma) instead of navy with Cormorant. */
  bright?: boolean;
}

const {
  label = 'Take the first step',
  title = 'Begin Your Personalized Dental Journey',
  actions,
  bright = false,
} = Astro.props;
---

<section class:list={['band', { 'band--bright': bright }]} aria-labelledby="cta-title">
  <div class="container cta">
    <p class="t-label is-lined cta__label">{label}</p>
    <h2 class="t-h2 cta__title" id="cta-title">
      {title}
    </h2>
    <div class="cta__actions">
      {actions.map((a) => (
        <Button href={a.href} variant={a.variant ?? 'light'}>
          {a.label}
        </Button>
      ))}
    </div>
  </div>
</section>

<style>
  /* Figma: centred eyebrow with rules, title, two white buttons side by side, on the navy gradient. */
  .band {
    padding-block: calc(var(--section-pad-y) * 0.75);
    background: var(--gradient-band);
  }

  .band--bright {
    background: var(--gradient-blue);
  }

  .cta {
    display: grid;
    justify-items: center;
    gap: 16px;
    text-align: center;
  }

  .cta__label,
  .cta__title {
    color: var(--color-white);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 8px;
  }
</style>

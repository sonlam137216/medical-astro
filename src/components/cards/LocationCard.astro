---
import { Image } from 'astro:assets';
import type { Img } from '../../data/home';

interface Props {
  name: string;
  address: string;
  href: string;
  image: Img;
  linkLabel?: string;
  /** Discover Vietnam cards use the 16/26 body style rather than small muted text. */
  detail?: boolean;
  /** `button` (Home): bold name + address and a pill button. `link` (Travel Combos): name heading and an arrow link. */
  action?: 'link' | 'button';
}

const {
  name,
  address,
  href,
  image,
  linkLabel = 'Directions',
  detail = false,
  action = 'link',
} = Astro.props;
const external = /^https?:\/\//i.test(href);
---

<article class="card location">
  <Image
    class="card__media location__img"
    src={image.src}
    alt={image.alt}
    width={384}
    height={216}
    densities={[1, 2]}
    sizes="(max-width: 768px) 100vw, 384px"
    loading="lazy"
  />
  <div class="card__body">
    {action === 'button' ? (
      <>
        <p class="location__text">
          <strong>{name}</strong>: {address}
        </p>
        <a
          class="location__btn"
          href={href}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
        >
          {linkLabel}
          {external && <span class="visually-hidden"> (opens in a new tab)</span>}
        </a>
      </>
    ) : (
      <>
        <h3 class="t-h3">{name}</h3>
        <p class:list={detail ? [] : ['t-small', 'muted']}>{address}</p>
        <a class="link-arrow" href={href}>
          {linkLabel} <span aria-hidden="true">→</span>
        </a>
      </>
    )}
  </div>
</article>

<style>
  .location__img {
    aspect-ratio: 384 / 216;
    object-fit: cover;
  }

  .card__body {
    gap: 12px;
  }

  .location__text {
    font-size: var(--text-small);
    line-height: var(--text-small-lh);
    color: var(--color-muted);
  }

  .location__text strong {
    font-weight: 700;
    color: var(--color-navy);
  }

  .location__btn {
    justify-self: start;
    padding: 8px 22px;
    border-radius: var(--radius-button);
    background: var(--color-blue);
    font: 500 var(--text-small) / var(--text-small-lh) var(--font-display);
    color: var(--color-white);
  }

  .location__btn:hover {
    background: var(--color-blue-deep);
  }
</style>

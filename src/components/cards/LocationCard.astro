---
import Icon from '../Icon.astro';
import type { Img } from '../../data/home';
import type { PublicImage } from '../../lib/media';
import ProfileImage from '../ProfileImage.astro';
import { frameAspect, IMAGE_SLOTS } from '../../lib/image-slots';

interface Props {
  name: string;
  address: string;
  href: string;
  /** Absent (a published clinic without a photo): an empty frame keeps the cards aligned. */
  image?: Img | PublicImage;
  linkLabel?: string;
  /** Discover Vietnam cards use the 16/26 body style rather than small muted text. */
  detail?: boolean;
  /** `button` (Home): bold name + address and a pill button. `link` (Travel Combos): name heading and an arrow link. */
  action?: 'link' | 'button';
}

const {
  name,
  address,
  href,
  image,
  linkLabel = 'Directions',
  detail = false,
  action = 'link',
} = Astro.props;
const external = /^https?:\/\//i.test(href);
---

<article class="card location">
  {image ? (
    <ProfileImage
      class="card__media location__img"
      image={image}
      slot="location-card"
      sizes="(max-width: 768px) 100vw, 384px"
    />
  ) : (
    <div
      class="card__media location__img location__img--empty"
      style={`aspect-ratio: ${frameAspect(IMAGE_SLOTS['location-card'])}`}
      aria-hidden="true"
    ></div>
  )}
  <div class="card__body">
    {action === 'button' ? (
      <>
        <p class="location__text">
          <Icon name="map-pin" size={18} />
          <span>
            <strong>{name}</strong>: {address}
          </span>
        </p>
        <a
          class="location__btn"
          href={href}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
        >
          <Icon name="directions" size={16} />
          {linkLabel}
          {external && <span class="visually-hidden"> (opens in a new tab)</span>}
        </a>
      </>
    ) : (
      <>
        <h3 class="t-h3">{name}</h3>
        <p class:list={detail ? [] : ['t-small', 'muted']}>{address}</p>
        <a class="link-arrow" href={href}>
          {linkLabel}{' '}
          <span aria-hidden="true">
            <Icon name="arrow-right" size={14} />
          </span>
        </a>
      </>
    )}
  </div>
</article>

<style>
  .location__img--empty {
    background: var(--color-card);
  }

  .card__body {
    gap: 12px;
  }

  .location__text {
    display: flex;
    gap: 8px;
    font-size: var(--text-small);
    line-height: var(--text-small-lh);
    color: var(--color-muted);
  }

  .location__text :global(.icon) {
    margin-top: 2px;
    color: var(--color-blue);
  }

  .location__text strong {
    font-weight: 700;
    color: var(--color-navy);
  }

  .location__btn {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 22px;
    border-radius: var(--radius-button);
    background: var(--color-blue);
    font: 500 var(--text-small) / var(--text-small-lh) var(--font-display);
    color: var(--color-white);
  }

  @media (max-width: 768px) {
    .location__btn {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }

  .location__btn:hover {
    background: var(--color-blue-deep);
  }
</style>

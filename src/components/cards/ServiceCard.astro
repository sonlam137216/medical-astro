---
import { Image } from 'astro:assets';
import type { Img } from '../../data/home';

interface Props {
  title: string;
  body: string;
  /** Home cards show a "TOTAL: …" line; the Services page cards do not. */
  total?: string;
  href: string;
  image: Img;
  linkLabel?: string;
  /** Services page: body copy in the 16/26 text style instead of the small muted one. */
  detail?: boolean;
}

const { title, body, total, href, image, linkLabel = 'Learn more', detail = false } = Astro.props;
---

<article class="card service">
  <Image
    class="card__media service__img"
    src={image.src}
    alt={image.alt}
    width={384}
    height={190}
    densities={[1, 2]}
    sizes="(max-width: 768px) 100vw, 384px"
    loading="lazy"
  />
  <div class="card__body">
    <h3 class="t-h3">{title}</h3>
    <p class:list={detail ? [] : ['t-small', 'muted']}>{body}</p>
    {total && <p class="price-total">{total}</p>}
    <a class="link-arrow" href={href}>
      {linkLabel} <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .service__img {
    aspect-ratio: 384 / 190;
    object-fit: cover;
    object-position: center top;
  }
</style>

---
import type { Img } from '../../data/types';
import type { PublicImage } from '../../lib/media';
import ProfileImage from '../ProfileImage.astro';

interface Props {
  name: string;
  role?: string | null;
  /** Optional profile link. The Figma cards have none, so the Home and About pages leave it out. */
  href?: string;
  /** A sample photo or a media-library image. Missing: initials are shown instead. */
  image?: Img | PublicImage;
}

const { name, role, href, image } = Astro.props;

// 'Dr. Le Thi Yen' -> 'TY' (last two words, titles ignored)
const initials = name
  .replace(/^(dr|prof|assoc\. prof)\.?\s+/i, '')
  .split(/\s+/)
  .slice(-2)
  .map((w) => w[0]?.toUpperCase() ?? '')
  .join('');
---

<article class="card doctor">
  {image ? (
    <ProfileImage
      class="card__media doctor__img"
      image={image}
      width={282}
      height={280}
      sizes="(max-width: 600px) 100vw, 282px"
    />
  ) : (
    <div class="card__media doctor__img doctor__initials" aria-hidden="true">
      {initials}
    </div>
  )}
  <div class="card__body">
    {role && <p class="doctor__role">{role}</p>}
    <h3 class="doctor__name">{name}</h3>
    {href && (
      <a class="link-arrow" href={href}>
        View profile <span aria-hidden="true">→</span>
      </a>
    )}
  </div>
</article>

<style>
  .doctor {
    background: var(--color-white);
    border-color: var(--color-blue);
  }

  .doctor__img {
    aspect-ratio: 282 / 280;
    object-fit: contain;
    object-position: center bottom;
    background: var(--color-white);
  }

  .doctor__initials {
    display: grid;
    place-items: center;
    font: 700 56px / 1 var(--font-serif);
    color: var(--color-heading);
    background: var(--color-soft);
  }

  .card__body {
    gap: 4px;
    padding: 4px 16px 20px;
    text-align: center;
  }

  /* Figma: the role (small, blue) sits above the name (bold, dark blue). */
  .doctor__role {
    display: grid;
    align-items: end;
    min-height: calc(var(--text-small-lh) * 2);
    font: 500 var(--text-small) / var(--text-small-lh) var(--font-display);
    color: var(--color-blue);
  }

  .doctor__name {
    font: 600 var(--text-body) / var(--text-body-lh) var(--font-display);
    color: var(--color-title);
  }

  .link-arrow {
    justify-self: center;
    margin-top: 8px;
  }
</style>

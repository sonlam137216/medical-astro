---
import type { Img } from '../../data/types';
import type { PublicImage } from '../../lib/media';
import ProfileImage from '../ProfileImage.astro';

interface Props {
  name: string;
  role?: string | null;
  href?: string;
  /** A sample photo or a media-library image. Missing: initials are shown instead. */
  image?: Img | PublicImage;
}

const { name, role, href, image } = Astro.props;

// 'Dr. Le Thi Yen' -> 'TY' (last two words, titles ignored)
const initials = name
  .replace(/^(dr|prof|assoc\. prof)\.?\s+/i, '')
  .split(/\s+/)
  .slice(-2)
  .map((w) => w[0]?.toUpperCase() ?? '')
  .join('');
---

<article class="card doctor">
  {image ? (
    <ProfileImage
      class="card__media doctor__img"
      image={image}
      width={282}
      height={280}
      sizes="(max-width: 600px) 100vw, 282px"
    />
  ) : (
    <div class="card__media doctor__img doctor__initials" aria-hidden="true">
      {initials}
    </div>
  )}
  <div class="card__body">
    <h3 class="doctor__name">{name}</h3>
    {role && <p class="t-small muted">{role}</p>}
    {href && (
      <a class="link-arrow" href={href}>
        View profile <span aria-hidden="true">→</span>
      </a>
    )}
  </div>
</article>

<style>
  .doctor__img {
    aspect-ratio: 282 / 280;
    object-fit: contain;
    object-position: center bottom;
    background: var(--color-white);
  }

  .doctor__initials {
    display: grid;
    place-items: center;
    font: 600 56px / 1 var(--font-serif);
    color: var(--color-heading);
    background: var(--color-soft);
  }

  .card__body {
    gap: 8px;
  }

  .doctor__name {
    font: 600 var(--text-button) / var(--text-button-lh) var(--font-sans);
    color: var(--color-heading);
  }

  .link-arrow {
    margin-top: 8px;
  }
</style>

---
import { Image } from 'astro:assets';
import inclusionDot from '../../assets/images/icons/inclusion-dot.png';
import type { Img } from '../../data/types';
import type { PublicImage } from '../../lib/media';
import ProfileImage from '../ProfileImage.astro';

interface Props {
  title: string;
  inclusions: string[];
  /** The price line; absent: none is shown. */
  total?: string | null;
  /** A short condition under the price. */
  note?: string | null;
  href: string;
  /** Absent (a service without a photo): an empty frame keeps the cards aligned. */
  image?: Img | PublicImage;
  linkLabel?: string;
}

const { title, inclusions, total, note, href, image, linkLabel = 'Learn more' } = Astro.props;
---

<article class="card package">
  {image ? (
    <ProfileImage
      class="card__media package__img"
      image={image}
      width={384}
      height={190}
      sizes="(max-width: 768px) 100vw, 384px"
    />
  ) : (
    <div class="card__media package__img package__img--empty" aria-hidden="true"></div>
  )}
  <div class="card__body">
    <h3 class="t-h3">{title}</h3>
    {inclusions.length > 0 && (
      <ul class="package__list">
        {inclusions.map((item) => (
          <li>
            <Image
              src={inclusionDot}
              alt=""
              width={20}
              height={20}
              densities={[1, 2]}
              loading="lazy"
            />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    )}
    {total && <p class="package__total">{total}</p>}
    {total && note && <p class="package__note">{note}</p>}
    <a class="link-arrow" href={href}>
      {linkLabel} <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .package__img {
    aspect-ratio: 384 / 190;
    object-fit: cover;
    object-position: center top;
  }

  .package__img--empty {
    background: var(--color-card);
  }

  .package__list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .package__list li {
    font-size: var(--text-small);
    line-height: var(--text-small-lh);
    color: var(--color-muted);
    display: grid;
    grid-template-columns: 20px 1fr;
    align-items: start;
    gap: 12px;
  }

  .package__list li :global(img) {
    margin-top: 3px;
  }

  .package__note {
    margin-top: -8px;
    font-size: var(--text-small);
    line-height: var(--text-small-lh);
    color: var(--color-muted);
  }

  .package__total {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 26px;
    line-height: 34px;
    color: var(--color-blue);
  }
</style>

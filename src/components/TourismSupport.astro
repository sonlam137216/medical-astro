---
import Section from './Section.astro';
import SectionIntro from './SectionIntro.astro';
import InfoCard from './cards/InfoCard.astro';
import { tourismSupport as t } from '../data/shared';
---

<Section tone="soft" labelledby="tourism-title">
  <SectionIntro label={t.label} headingId="tourism-title" align="center" lined>
    <Fragment slot="title">{t.title}</Fragment>
  </SectionIntro>
  <ul class="grid">
    {t.items.map((item) => (
      <li>
        <InfoCard title={item.title} body={item.body} upper />
      </li>
    ))}
  </ul>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid li {
    min-height: 200px;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .grid li {
      min-height: 0;
    }
  }
</style>

---
interface Props {
  /**
   * `light` and `outline-light` are for dark bands (Figma "Take the first step").
   * `whatsapp` is the green button next to the hero copy.
   */
  variant?: 'primary' | 'outline' | 'light' | 'outline-light' | 'whatsapp';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
}

const { variant = 'primary', href, type = 'button', class: className } = Astro.props;
const Tag = href ? 'a' : 'button';
const attrs = href ? { href } : { type };
---

<Tag class:list={['btn', `btn--${variant}`, className]} {...attrs}>
  <slot />
</Tag>

<style>
  /*
   * Figma buttons: radius 15 on a 43 px box, Montserrat Medium; the label sits off-centre in several
   * Figma frames, here it is always centred (owner: misaligned labels in the design are not copied).
   * Our scale is ~1.18× Figma: height 48, radius 16, 16/24 text.
   */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    padding: 12px 28px;
    border: 1px solid transparent;
    border-radius: var(--radius-button);
    font: 500 var(--text-button) / var(--text-button-lh) var(--font-display);
    text-align: center;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color 0.15s,
      border-color 0.15s,
      color 0.15s;
  }

  .btn--primary {
    background: var(--color-blue);
    border-color: var(--color-blue);
    color: var(--color-white);
  }

  .btn--primary:hover {
    background: var(--color-blue-deep);
    border-color: var(--color-blue-deep);
  }

  .btn--outline {
    background: var(--color-white);
    border-color: var(--color-border);
    color: var(--color-title);
  }

  .btn--outline:hover {
    border-color: var(--color-blue);
    color: var(--color-blue);
  }

  .btn--light {
    background: var(--color-white);
    border-color: var(--color-white);
    color: var(--color-blue-deep);
  }

  .btn--light:hover {
    background: var(--color-soft);
    border-color: var(--color-soft);
  }

  .btn--outline-light {
    background: transparent;
    border-color: var(--color-white);
    color: var(--color-white);
  }

  .btn--outline-light:hover {
    background: rgb(255 255 255 / 12%);
  }

  .btn--whatsapp {
    background: var(--color-green);
    border-color: var(--color-green);
    color: var(--color-white);
  }

  .btn--whatsapp:hover {
    filter: brightness(0.92);
  }
</style>

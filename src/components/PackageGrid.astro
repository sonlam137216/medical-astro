---
import SectionIntro from './SectionIntro.astro';
import Section from './Section.astro';
import PackageCard from './cards/PackageCard.astro';
import { getPackages, type PackageKind } from '../lib/content';

interface Props {
  /** Travel Combos shows a "Cost / Dental Tourism Package Prices" intro, Single Treatments does not. */
  intro?: { label: string; title: string };
  tone?: 'white' | 'soft';
  /** Which cards: the Dental Packages page or the Travel Combos page. */
  kind: PackageKind;
}

const { intro, tone = 'soft', kind } = Astro.props;
const packages = await getPackages(kind);
---

{packages.length > 0 && (
  <Section {tone} labelledby="packages-title">
    {intro ? (
      <SectionIntro label={intro.label} headingId="packages-title" align="center" lined>
        <Fragment slot="title">{intro.title}</Fragment>
      </SectionIntro>
    ) : (
      <h2 class="visually-hidden" id="packages-title">
        Dental packages
      </h2>
    )}
    <ul class="grid">
      {packages.map((p) => (
        <li>
          <PackageCard {...p} />
        </li>
      ))}
    </ul>
  </Section>
)}

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid li {
    display: flex;
  }

  .grid li > :global(*) {
    flex: 1;
  }

  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import SectionIntro from './SectionIntro.astro';
import Section from './Section.astro';
import PackageCard from './cards/PackageCard.astro';
import ComboCard from './cards/ComboCard.astro';
import { getPackages, getTravelCombos, type PackageKind } from '../lib/content';

interface Props {
  /** Travel Combos shows a "Cost / Dental Tourism Package Prices" intro, Single Treatments does not. */
  intro?: { label: string; title: string };
  tone?: 'white' | 'soft';
  /** Which cards: the Dental Packages page or the Travel Combos page. */
  kind: PackageKind;
}

const { intro, tone = 'soft', kind } = Astro.props;
// Travel Combos has its own cards (Figma "Dental Tourism Package Prices", two columns); Dental Packages keeps the
// photo cards.
const combos = kind === 'travel_combo' ? await getTravelCombos() : [];
const packages = kind === 'travel_combo' ? [] : await getPackages(kind);
---

{(packages.length > 0 || combos.length > 0) && (
  <Section {tone} labelledby="packages-title">
    {intro ? (
      <SectionIntro label={intro.label} headingId="packages-title" align="center" lined>
        <Fragment slot="title">{intro.title}</Fragment>
      </SectionIntro>
    ) : (
      <h2 class="visually-hidden" id="packages-title">
        Dental packages
      </h2>
    )}
    {combos.length > 0 ? (
      <ul class="grid grid--combos">
        {combos.map((c) => (
          <li>
            <ComboCard {...c} />
          </li>
        ))}
      </ul>
    ) : (
      <ul class="grid">
        {packages.map((p) => (
          <li>
            <PackageCard {...p} />
          </li>
        ))}
      </ul>
    )}
  </Section>
)}

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Two wider cards per row, the block centred (Figma). */
  .grid--combos {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 820px;
    margin-inline: auto;
  }

  .grid li {
    display: flex;
  }

  .grid li > :global(*) {
    flex: 1;
  }

  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .grid,
    .grid--combos {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import type { Img } from '../data/types';

interface Props {
  label: string;
  image: Img;
  /** Rendered image height in px (width is 568 for `split`; `banner` uses it as the band height). */
  imageHeight: number;
  /** Rounded 24px image (landing and packages pages) or square corners (About, Services, Doctors). */
  rounded?: boolean;
  /** Content pages set the h1 in capitals. */
  upper?: boolean;
  headingId?: string;
  /**
   * `split`: text left, picture right (current pages).
   * `banner`: full-width picture with the copy on top, as in the new Figma hero.
   */
  variant?: 'split' | 'banner';
  /** Banner only: navy overlay with white serif title (Services, Doctors, Packages) instead of the light Home/About look. */
  dark?: boolean;
  /** Banner only: CSS object-position of the picture, to keep the subject clear of the copy. */
  position?: string;
}

const {
  label,
  image,
  imageHeight,
  rounded = false,
  upper = false,
  headingId = 'page-title',
  variant = 'split',
  dark = false,
  position = 'center',
} = Astro.props;
const banner = variant === 'banner';
---

{banner ? (
  <section class:list={['banner', { 'banner--dark': dark }]} aria-labelledby={headingId}>
    <Image
      class="banner__bg"
      src={image.src}
      alt={image.alt}
      widths={[960, 1440, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      style={`object-position: ${position};`}
    />
    <div class="container banner__inner" style={`min-height: ${imageHeight}px;`}>
      <div class="hero__text">
        <p class:list={['t-label', 'is-lined', 'is-lead', 'hero__label']}>{label}</p>
        <h1
          class:list={['t-hero', { 't-hero--serif': dark, 'is-upper': upper || dark }]}
          id={headingId}
        >
          <slot name="title" />
        </h1>
        <div class="hero__body">
          <slot />
        </div>
        <div class="hero__actions">
          <slot name="actions" />
        </div>
        <div class="hero__extra">
          <slot name="extra" />
        </div>
      </div>
    </div>
  </section>
) : (
  <section class="band band--soft" aria-labelledby={headingId}>
    <div class="container hero">
      <div class="hero__text">
        <p class="t-label">{label}</p>
        <h1 class:list={['t-hero', { 'is-upper': upper }]} id={headingId}>
          <slot name="title" />
        </h1>
        <div class="hero__body">
          <slot />
        </div>
        <div class="hero__actions">
          <slot name="actions" />
        </div>
        <div class="hero__extra">
          <slot name="extra" />
        </div>
      </div>
      <Image
        class:list={['hero__img', { 'is-rounded': rounded }]}
        src={image.src}
        alt={image.alt}
        width={568}
        height={imageHeight}
        densities={[1, 2]}
        sizes="(max-width: 900px) 100vw, 568px"
        loading="eager"
        fetchpriority="high"
        style={`aspect-ratio: 568 / ${imageHeight};`}
      />
    </div>
  </section>
)}

<style>
  .band {
    padding-block: var(--section-pad-y);
  }

  .band--soft {
    background: var(--color-soft);
  }

  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 64px;
  }

  .hero__text {
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  .hero__body {
    display: grid;
    gap: 24px;
    max-width: 600px;
    color: var(--color-heading);
  }

  .hero__body:empty,
  .hero__actions:empty,
  .hero__extra:empty {
    display: none;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .hero__extra {
    display: grid;
    gap: 16px;
    color: var(--color-heading);
  }

  .is-upper {
    text-transform: uppercase;
  }

  .hero__img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .hero__img.is-rounded {
    border-radius: var(--radius-image);
  }

  /* Banner variant: picture fills the band, copy sits on a gradient so it stays readable. */
  .banner {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-soft);
  }

  .banner__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .banner::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      90deg,
      rgb(255 255 255 / 88%) 0%,
      rgb(255 255 255 / 55%) 45%,
      rgb(255 255 255 / 0%) 100%
    );
  }

  .banner--dark::before {
    background: linear-gradient(
      90deg,
      rgb(0 26 79 / 90%) 0%,
      rgb(0 26 79 / 60%) 55%,
      rgb(0 26 79 / 30%) 100%
    );
  }

  .banner__inner {
    display: grid;
    align-items: center;
    padding-block: var(--section-pad-y);
  }

  .banner .hero__text {
    max-width: 620px;
  }

  .banner--dark .hero__label,
  .banner--dark .hero__body,
  .banner--dark .hero__extra {
    color: var(--color-white);
  }

  /* Pills under the hero copy (Our Doctors: "15+ Years of Experience"). Pass <p class="hero-chip">. */
  .hero__extra :global(.hero-chip) {
    display: inline-flex;
    justify-self: start;
    padding: 8px 22px;
    border-radius: 999px;
    background: var(--color-white);
    color: var(--color-heading);
    font: 700 var(--text-body) / var(--text-body-lh) var(--font-serif);
  }

  .banner--dark .hero__extra:has(.hero-chip) {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    /* Copy covers most of the picture on narrow screens: strengthen the overlay for legibility. */
    .banner::before {
      background: rgb(255 255 255 / 80%);
    }

    .banner--dark::before {
      background: rgb(0 26 79 / 78%);
    }
  }
</style>

---
import Button from './Button.astro';
import FormGuards from './FormGuards.astro';
import PhoneField from './PhoneField.astro';
import { getServiceLinks, getSiteContent } from '../lib/site-content';

const site = await getSiteContent();

// Copy is from Figma "Shared / Consultation". The rating line is a claim made by the design;
// the owner must confirm it is current and verifiable before launch.
const services = (await getServiceLinks()).map((t) => t.label);
---

<section class="consult" id="consultation" aria-labelledby="consult-title">
  <div class="container consult__inner">
    <p class="t-label is-lined consult__eyebrow">Visit us</p>
    <h2 class="t-h2 consult__title" id="consult-title">
      Come see us in Viet Nam
    </h2>

    <div class="consult__grid">
      <div class="consult__panel consult__info">
        <p class="consult__name">{site.name}</p>
        <p class="consult__rating">
          <span aria-hidden="true">★★★★★</span>
          <span class="visually-hidden">Rated</span> 4.9/5 on Google Reviews
        </p>
        {site.addressLine && (
          <p class="consult__line">
            <span class="consult__key">Headquarters</span>
            {site.addressLine.replace(', Vietnam', '')}
          </p>
        )}
        {site.phoneIntl && (
          <p class="consult__line">
            <span class="consult__key">Phone / WhatsApp</span>
            {site.phoneIntl}
          </p>
        )}
        {site.hours && (
          <p class="consult__line">
            <span class="consult__key">Opening hours</span>
            {site.hours}
          </p>
        )}
        <p class="consult__line consult__note">
          We provide consultation support in English and flexible scheduling for overseas patients.
        </p>
      </div>

      <div class="consult__panel consult__formwrap">
        <h3 class="consult__formtitle">Book a consultation</h3>
        <!--
          POST (never GET) so personal data can never end up in the URL. Works without JS (the endpoint
          answers with a small page); the script below upgrades it to an in-page submit.
        -->
        <form class="form" method="post" action="/api/consultation" data-form="consultation">
          <FormGuards part="fields" />
          <div class="field">
            <label for="cf-name">Name</label>
            <input
              id="cf-name"
              name="name"
              type="text"
              autocomplete="name"
              placeholder="Your full name"
              maxlength="120"
              required
            />
          </div>
          <div class="field">
            <label for="cf-email">Email</label>
            <input
              id="cf-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="you@example.com"
              maxlength="254"
              required
            />
          </div>
          <PhoneField id="cf-phone" label="Phone" class="form__wide" />
          <div class="field form__wide">
            <label for="cf-service">Services</label>
            <select id="cf-service" name="service">
              <option value="">Select a treatment</option>
              {services.map((s) => (
                <option value={s}>{s}</option>
              ))}
            </select>
          </div>
          <div class="form__actions">
            <Button type="submit" variant="light" class="consult__submit">
              Request consultation
            </Button>
          </div>
          <FormGuards part="status" />
          <p class="form__note">*Your information is kept strictly confidential.</p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  /* Figma: dark blue band, centred eyebrow + serif title, an info card and a form card side by side,
     both translucent with a light outline. Roboto for the small text. */
  .consult {
    padding-block: var(--section-pad-y);
    background: var(--gradient-band);
    color: var(--color-white);
    font-family: var(--font-roboto);
    /* Brighter error colour so the invalid-field outline stays visible on the dark band. */
    --color-error: #ff8a80;
  }

  .consult__inner {
    display: grid;
    justify-items: center;
    gap: 16px;
  }

  .consult__eyebrow,
  .consult__title {
    color: var(--color-white);
  }

  .consult__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    width: 100%;
    margin-top: 24px;
  }

  .consult__panel {
    padding: 32px;
    background: rgb(255 255 255 / 6%);
    border: 1px solid rgb(255 255 255 / 55%);
    border-radius: var(--radius-panel);
  }

  .consult__info {
    display: grid;
    align-content: start;
    gap: 0;
  }

  .consult__name,
  .consult__formtitle {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 32px;
    line-height: 40px;
    color: var(--color-white);
  }

  .consult__rating {
    margin: 8px 0 20px;
    font-size: var(--text-small);
  }

  .consult__rating [aria-hidden] {
    margin-right: 6px;
    color: #ffc83d;
  }

  .consult__line {
    display: grid;
    gap: 2px;
    padding-block: 16px;
    border-top: 1px solid rgb(255 255 255 / 55%);
  }

  .consult__key {
    font-size: var(--text-small);
    opacity: 0.85;
  }

  .consult__note {
    font-size: var(--text-small);
  }

  .consult__formtitle {
    margin-bottom: 24px;
  }

  .form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    /* Colours picked up by the inputs here and by PhoneField. */
    --field-label: var(--color-white);
    --field-label-font: 700 14px / 20px var(--font-roboto);
    --field-label-transform: uppercase;
    --field-color: var(--color-white);
    --field-bg: rgb(255 255 255 / 8%);
    --field-border: rgb(255 255 255 / 55%);
    --field-placeholder: rgb(255 255 255 / 65%);
    --field-radius: 10px;
  }

  .field {
    display: grid;
    gap: 8px;
  }

  .field label {
    color: var(--field-label);
    font: var(--field-label-font);
    text-transform: var(--field-label-transform);
  }

  .field input,
  .field select {
    width: 100%;
    height: 54px;
    padding: 0 14px;
    font: inherit;
    color: var(--field-color);
    background: var(--field-bg);
    border: 1px solid var(--field-border);
    border-radius: var(--field-radius);
  }

  .field input::placeholder {
    color: var(--field-placeholder);
  }

  .field select option {
    color: var(--color-navy);
    background: var(--color-white);
  }

  .form__actions,
  .form__note,
  .form__wide,
  .form :global(.form__wide) {
    grid-column: 1 / -1;
  }

  .form__actions {
    display: flex;
  }

  .consult :global(.consult__submit) {
    font-family: var(--font-roboto);
    font-weight: 700;
    text-transform: uppercase;
  }

  .form__note {
    font-size: var(--text-small);
    font-style: italic;
  }

  .consult :global(.form__status[data-kind='ok']),
  .consult :global(.form__status[data-kind='error']) {
    color: var(--color-white);
  }

  @media (max-width: 900px) {
    .consult__grid {
      grid-template-columns: 1fr;
    }

    .consult__panel {
      padding: 24px 20px;
    }
  }

  @media (max-width: 560px) {
    .form {
      grid-template-columns: 1fr;
    }
  }
</style>

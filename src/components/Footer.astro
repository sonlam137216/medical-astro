---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import emblem from '../assets/images/brand/logo-emblem-white.png';
import { getSiteContent } from '../lib/site-content';
import { pageLink } from '../lib/links';

interface Props {
  /** The page has its own `#consultation` block (see SiteLayout). */
  consultationHere?: boolean;
}

const { consultationHere = true } = Astro.props;
const site = await getSiteContent();
const link = (href: string) => pageLink(href, consultationHere);
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="/" class="footer__logo" aria-label={`${site.name} — home`}>
          <Image src={emblem} alt="" width={91} densities={[1, 2]} />
        </a>
        <p class="footer__name">{site.name}</p>
        {site.tagline && <p class="footer__tagline">{site.tagline}</p>}
      </div>

      <nav class="footer__col" aria-label="Treatment">
        <h2 class="footer__title">Treatment</h2>
        <ul>
          {site.footerTreatments.map((l) => (
            <li>
              <a href={link(l.href)}>{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav class="footer__col" aria-label="Explore">
        <h2 class="footer__title">Explore</h2>
        <ul>
          {site.footerExplore.map((l) => (
            <li>
              <a href={link(l.href)}>{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="footer__col">
        <h2 class="footer__title">Contact Us</h2>
        <address>
          {site.addressLine && (
            <p>
              <Icon name="map-pin" size={20} />
              <span>Headquarters: {site.addressLine}</span>
            </p>
          )}
          {site.phoneIntl && (
            <p>
              <Icon name="phone" size={20} />
              <span>
                Phone: <a href={`tel:${site.phoneIntl.replace(/\s/g, '')}`}>{site.phoneIntl}</a>
              </span>
            </p>
          )}
          {site.hours && (
            <p>
              <Icon name="clock" size={20} />
              <span>Opening Hours: {site.hours}</span>
            </p>
          )}
        </address>
      </div>
    </div>

    <div class="footer__bottom">
      {site.copyright && <p>{site.copyright}</p>}
      <ul class="footer__legal">
        {site.footerLegal.map((l) => (
          <li>
            <a href={link(l.href)}>{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  /*
   * Figma Shared / Footer (2026-10-17, same on every page): blue gradient picture, Montserrat, the white logo
   * emblem above the clinic name, 3 link columns, a white rule, then the legal row. Sizes follow Figma 1:1
   * (the footer frame is about as wide as the site container).
   */
  .footer {
    background: var(--gradient-footer);
    color: var(--color-white);
    padding-block: 52px 32px;
    font-family: var(--font-display);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr 1fr 1.6fr;
    gap: 0;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: fit-content;
    max-width: 270px;
    padding-right: 24px;
  }

  /* The emblem sits centred over the clinic name (Figma). */
  .footer__logo {
    display: block;
    align-self: center;
    line-height: 0;
  }

  .footer__logo img {
    width: 91px;
    height: auto;
  }

  .footer__name {
    margin: 4px 0 0;
    font-weight: 700;
    font-size: 20px;
    line-height: 28px;
  }

  .footer__tagline {
    margin: 10px 0 0;
    font-size: 17px;
    line-height: 21px;
  }

  .footer__col {
    font-size: 17px;
    line-height: 21px;
  }

  .footer__title {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 25px;
    line-height: 30px;
    text-transform: uppercase;
  }

  .footer__col ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__col address {
    display: grid;
    gap: 12px;
    font-style: normal;
    max-width: 320px;
  }

  /* Icons hang to the left of their line (Figma Home). */
  .footer__col address p {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 8px;
    align-items: start;
    margin: 0;
  }

  .footer__col address :global(.icon) {
    margin-top: 1px;
  }

  .footer a:hover {
    text-decoration: underline;
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 52px;
    padding-top: 26px;
    border-top: 1px solid var(--color-white);
    font-size: 15px;
    line-height: 20px;
  }

  .footer__bottom p {
    margin: 0;
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }

    .footer__brand {
      grid-column: 1 / -1;
      max-width: 320px;
      padding-right: 0;
    }

    .footer__logo {
      align-self: flex-start;
    }

    .footer__title {
      font-size: 22px;
      line-height: 28px;
    }
  }

  /* Phones: a 40 px tap area for the phone number without spreading the lines apart. */
  @media (max-width: 768px) {
    .footer__col address a {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      margin-block: -10px;
    }
  }

  @media (max-width: 600px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }

    .footer__bottom {
      flex-direction: column;
    }
  }
</style>

---
import Logo from './Logo.astro';
import { getSiteContent } from '../lib/site-content';
import { pageLink } from '../lib/links';

interface Props {
  /** The page has its own `#consultation` block (see SiteLayout). */
  consultationHere?: boolean;
}

const { consultationHere = true } = Astro.props;
const site = await getSiteContent();
const link = (href: string) => pageLink(href, consultationHere);
---

<!-- Navy on every page (UI update): the bright variant of Home/About ran into the blue "Visit us" band above it. -->
<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <Logo tone="light" />
        <p class="footer__name t-h3">{site.name}</p>
        {site.tagline && <p class="footer__tagline">{site.tagline}</p>}
      </div>

      <nav class="footer__col" aria-label="Treatment">
        <h2 class="footer__title">Treatment</h2>
        <ul>
          {site.footerTreatments.map((l) => (
            <li>
              <a href={link(l.href)}>{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav class="footer__col" aria-label="Explore">
        <h2 class="footer__title">Explore</h2>
        <ul>
          {site.footerExplore.map((l) => (
            <li>
              <a href={link(l.href)}>{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="footer__col">
        <h2 class="footer__title">Contact Us</h2>
        <address>
          {site.addressLine && <p>{site.addressLine}</p>}
          {site.phoneIntl && (
            <p>
              <a href={`tel:${site.phoneIntl.replace(/\s/g, '')}`}>{site.phoneIntl}</a>
            </p>
          )}
          {/* Was in the top bar, which the UI update removed. */}
          {site.email && (
            <p>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </p>
          )}
          {site.hours && <p>{site.hours}</p>}
        </address>
      </div>
    </div>

    <div class="footer__bottom">
      {site.copyright && <p>{site.copyright}</p>}
      <ul class="footer__legal">
        {site.footerLegal.map((l) => (
          <li>
            <a href={link(l.href)}>{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  /* Figma Shared / Footer: dark blue gradient, logo + 3 link columns, rule, legal row. */
  .footer {
    background: var(--gradient-band);
    color: var(--color-white);
    padding-block: 64px 32px;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1.25fr;
    gap: 0;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-right: 48px;
  }

  .footer__name {
    font-weight: 700;
    color: var(--color-white);
    margin-top: 8px;
  }

  .footer__tagline {
    max-width: 320px;
    line-height: 24px;
  }

  .footer__col {
    font-size: 15px;
    line-height: 24px;
    color: rgb(255 255 255 / 88%);
  }

  .footer__title {
    margin: 0 0 20px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 13px;
    line-height: 20px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 70%);
  }

  .footer__col ul {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__col address {
    display: grid;
    gap: 12px;
    font-style: normal;
    max-width: 280px;
  }

  .footer a:hover {
    text-decoration: underline;
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid rgb(255 255 255 / 35%);
    font-size: var(--text-small);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }

    .footer__brand {
      grid-column: 1 / -1;
      padding-right: 0;
    }
  }

  @media (max-width: 600px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }

    .footer__bottom {
      flex-direction: column;
    }
  }
</style>

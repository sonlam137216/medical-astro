---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import emblem from '../assets/images/brand/logo-emblem-white.png';
import { getSiteContent } from '../lib/site-content';
import { pageLink } from '../lib/links';

interface Props {
  /** The page has its own `#consultation` block (see SiteLayout). */
  consultationHere?: boolean;
}

const { consultationHere = true } = Astro.props;
const site = await getSiteContent();
const link = (href: string) => pageLink(href, consultationHere);
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="/" class="footer__logo" aria-label={`${site.name} — home`}>
          <Image src={emblem} alt="" width={91} densities={[1, 2]} />
        </a>
        <p class="footer__name">{site.name}</p>
        {site.tagline && <p class="footer__tagline">{site.tagline}</p>}
      </div>

      <nav class="footer__col footer__treatments" aria-label="Treatment">
        <h2 class="footer__title">Treatment</h2>
        <ul>
          {site.footerTreatments.map((l) => (
            <li>
              <a href={link(l.href)}>{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav class="footer__col footer__explore" aria-label="Explore">
        <h2 class="footer__title">Explore</h2>
        <ul>
          {site.footerExplore.map((l) => (
            <li>
              <a href={link(l.href)}>{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="footer__col footer__contact">
        <h2 class="footer__title">Contact Us</h2>
        <address>
          {site.addressLine && (
            <p>
              <Icon name="map-pin" size={20} />
              <span>Headquarters: {site.addressLine}</span>
            </p>
          )}
          {site.phoneIntl && (
            <p>
              <Icon name="phone" size={20} />
              <span>
                Phone: <a href={`tel:${site.phoneIntl.replace(/\s/g, '')}`}>{site.phoneIntl}</a>
              </span>
            </p>
          )}
          {site.hours && (
            <p>
              <Icon name="clock" size={20} />
              <span>Opening Hours: {site.hours}</span>
            </p>
          )}
        </address>
      </div>
    </div>

    <div class="footer__bottom">
      {site.copyright && <p>{site.copyright}</p>}
      <ul class="footer__legal">
        {site.footerLegal.map((l) => (
          <li>
            <a href={link(l.href)}>{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--gradient-footer);
    color: var(--color-white);
    padding-block: 56px 24px;
    font-family: var(--font-display);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.6fr);
    grid-template-areas: 'brand treatments explore contact';
    gap: 32px;
    align-items: start;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    grid-area: brand;
    max-width: 270px;
  }

  .footer__logo {
    display: block;
    align-self: flex-start;
    line-height: 0;
  }

  .footer__logo img {
    width: 68px;
    height: auto;
  }

  .footer__name {
    margin: 16px 0 0;
    font-weight: 700;
    font-size: 18px;
    line-height: 26px;
  }

  .footer__tagline {
    margin: 10px 0 0;
    font-size: 14px;
    line-height: 24px;
    color: rgb(255 255 255 / 80%);
  }

  .footer__col {
    min-width: 0;
    font-size: 14px;
    line-height: 24px;
  }

  .footer__treatments {
    grid-area: treatments;
  }

  .footer__explore {
    grid-area: explore;
  }

  .footer__contact {
    grid-area: contact;
  }

  .footer__title {
    margin: 0 0 16px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    line-height: 24px;
  }

  .footer__col ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__col li a,
  .footer__legal a {
    display: flex;
    align-items: center;
    min-height: 32px;
    padding-block: 4px;
    width: fit-content;
    max-width: 100%;
    color: rgb(255 255 255 / 85%);
  }

  .footer__col address {
    display: grid;
    gap: 16px;
    font-style: normal;
    overflow-wrap: anywhere;
    color: rgb(255 255 255 / 85%);
  }

  /* Icons hang to the left of their line (Figma Home). */
  .footer__col address p {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 8px;
    align-items: start;
    margin: 0;
  }

  .footer__col address :global(.icon) {
    margin-top: 1px;
  }

  .footer a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
    color: var(--color-white);
  }

  .footer a:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid rgb(255 255 255 / 24%);
    font-size: 12px;
    line-height: 20px;
    color: rgb(255 255 255 / 72%);
  }

  .footer__bottom p {
    margin: 0;
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      grid-template-areas: 'brand contact' 'treatments explore';
      gap: 32px 48px;
    }

    .footer__brand {
      max-width: 320px;
    }

    .footer__bottom {
      padding-right: 64px;
    }
  }

  @media (max-width: 768px) {
    .footer__col li a,
    .footer__legal a {
      min-height: 36px;
      padding-block: 6px;
    }

    .footer__col li a {
      width: 100%;
    }

    .footer__col address a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      margin-block: -10px;
    }
  }

  @media (max-width: 600px) {
    .footer {
      padding-block: 36px 88px;
    }

    .footer__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: 'brand brand' 'treatments explore' 'contact contact';
      gap: 28px 20px;
    }

    .footer__brand {
      max-width: 100%;
      display: grid;
      grid-template-columns: 56px minmax(0, 1fr);
      gap: 8px 16px;
      align-items: center;
    }

    .footer__logo {
      grid-row: span 2;
      align-self: start;
    }

    .footer__logo img {
      width: 56px;
    }

    .footer__name,
    .footer__tagline {
      margin: 0;
    }

    .footer__name {
      font-size: 16px;
      line-height: 24px;
    }

    .footer__tagline {
      font-size: 13px;
      line-height: 21px;
    }

    .footer__contact {
      padding-top: 24px;
      padding-right: 44px;
      border-top: 1px solid rgb(255 255 255 / 24%);
    }

    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      margin-top: 28px;
      padding-right: 44px;
    }
  }
</style>

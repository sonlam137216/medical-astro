---
import Section from '../Section.astro';
import SectionIntro from '../SectionIntro.astro';
import Button from '../Button.astro';
import ProfileImage from '../ProfileImage.astro';
import { travelGuide } from '../../data/home';
import { getArticles, isSampleContent } from '../../lib/content';

// Published travel guide articles: the newest one large, the next three beside it. Before the first publish the
// design's sample article is shown; once something is published and there are no articles, the section is hidden
// (sample articles must never look real on the live site).
const published = await getArticles('travel_guide');
const sample = await isSampleContent();
const toCard = (a: (typeof published)[number]) => ({
  title: a.title,
  excerpt: a.excerpt ?? '',
  href: a.path,
  image: a.cover,
});
const featured = published[0] ? toCard(published[0]) : sample ? { ...travelGuide.featured } : null;
const more =
  published.length > 0 ? published.slice(1, 4).map(toCard) : sample ? travelGuide.more : [];
---

{featured && (
  <Section tone="soft" labelledby="guide-title">
    <SectionIntro label={travelGuide.label} headingId="guide-title" lined>
      <Fragment slot="title">{travelGuide.title}</Fragment>
      <Button slot="action" variant="outline" href={travelGuide.cta.href}>
        {travelGuide.cta.label}
      </Button>
    </SectionIntro>

    <div class="guide">
      <article class="guide__featured">
        <a href={featured.href}>
          {featured.image && (
            <ProfileImage
              class="guide__img"
              image={featured.image}
              width={480}
              height={330}
              sizes="(max-width: 900px) 100vw, 480px"
            />
          )}
          <h3 class="guide__title">{featured.title}</h3>
        </a>
        <p class="guide__excerpt">{featured.excerpt}</p>
      </article>

      <ul class="guide__list">
        {more.map((a) => (
          <li class:list={['guide__item', { 'guide__item--plain': !a.image }]}>
            {a.image && (
              <a href={a.href} tabindex="-1" aria-hidden="true">
                <ProfileImage
                  class="guide__thumb"
                  image={a.image}
                  width={170}
                  height={110}
                  sizes="170px"
                />
              </a>
            )}
            <div>
              <h3 class="guide__title">
                <a href={a.href}>{a.title}</a>
              </h3>
              <p class="guide__excerpt">{a.excerpt}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </Section>
)}

<style>
  .guide {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }

  .guide__featured {
    display: grid;
    gap: 12px;
  }

  .guide__featured a {
    display: grid;
    gap: 16px;
  }

  .guide__img {
    width: 100%;
    height: auto;
    aspect-ratio: 480 / 330;
    object-fit: cover;
    border-radius: var(--radius-card);
  }

  .guide__list {
    display: grid;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide__item {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 20px;
    align-items: start;
  }

  .guide__item--plain {
    grid-template-columns: 1fr;
  }

  .guide__thumb {
    width: 100%;
    height: auto;
    aspect-ratio: 170 / 110;
    object-fit: cover;
    border-radius: 12px;
  }

  .guide__title {
    font: 600 var(--text-body) / var(--text-body-lh) var(--font-display);
    color: var(--color-title);
  }

  .guide__title a:hover {
    color: var(--color-blue);
  }

  .guide__excerpt {
    margin-top: 6px;
    font-size: var(--text-small);
    line-height: var(--text-small-lh);
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .guide {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .guide__item {
      grid-template-columns: 1fr;
    }
  }
</style>

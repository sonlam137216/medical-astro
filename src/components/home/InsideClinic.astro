---
import Icon from '../Icon.astro';
import ProfileImage from '../ProfileImage.astro';
import { itemInput } from '../../lib/cms/fields';
import Section from '../Section.astro';

import { getSection } from '../../lib/content';

const insideClinic = await getSection('home_inside');
---

{insideClinic && insideClinic.tiles.length > 0 && (
  <Section tone="blue" labelledby="clinic-title">
    <h2 class="visually-hidden" id="clinic-title">
      {insideClinic.title}
    </h2>

    <!-- Figma: a blue band with a row of photo tiles and an arrow at each end. -->
    <div class="gallery" data-gallery>
      <button class="gallery__arrow" type="button" aria-label="Previous photos" data-gallery-prev>
        <span aria-hidden="true">
          <Icon name="arrow-left" size={22} />
        </span>
      </button>
      <ul class="gallery__track" tabindex="0" aria-label="Clinic photos" data-gallery-track>
        {insideClinic.tiles.map((tile, i) => (
          <li class="gallery__tile">
            <figure>
              <ProfileImage
                class="gallery__img"
                image={insideClinic.chosenPhotos[itemInput('tiles', i, 'photo')] ?? tile.image}
                slot="home-inside"
                width={360}
                height={340}
                sizes="(max-width: 700px) 70vw, 340px"
              />
              <figcaption>{tile.caption}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
      <button class="gallery__arrow" type="button" aria-label="Next photos" data-gallery-next>
        <span aria-hidden="true">
          <Icon name="arrow-right" size={22} />
        </span>
      </button>
    </div>
  </Section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const track = gallery.querySelector<HTMLElement>('[data-gallery-track]');
    if (!track) return;
    // One tile (plus the gap) per click; the row snaps to tile edges.
    const step = () => {
      const tile = track.firstElementChild as HTMLElement | null;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return (tile?.offsetWidth ?? 240) + gap;
    };
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const behavior = reduce ? 'auto' : 'smooth';
    // At either end the arrow wraps round to the other end, so both arrows always do something.
    const scroll = (dir: number) => {
      const max = track.scrollWidth - track.clientWidth;
      if (dir > 0 && track.scrollLeft >= max - 4) track.scrollTo({ left: 0, behavior });
      else if (dir < 0 && track.scrollLeft <= 4) track.scrollTo({ left: max, behavior });
      else track.scrollBy({ left: dir * step(), behavior });
    };
    gallery.querySelector('[data-gallery-prev]')?.addEventListener('click', () => scroll(-1));
    gallery.querySelector('[data-gallery-next]')?.addEventListener('click', () => scroll(1));
  });
</script>

<style>
  .gallery {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 20px;
  }

  .gallery__track {
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 6px 4px 14px; /* room for the lifted tile's shadow */
    overflow-x: auto;
    list-style: none;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .gallery__track::-webkit-scrollbar {
    display: none;
  }

  .gallery__tile {
    flex: 0 0 calc((100% - 48px) / 3);
    min-width: 240px;
    scroll-snap-align: start;
  }

  .gallery__tile figure {
    display: grid;
    grid-template-rows: auto 1fr;
    align-content: start;
    height: 100%;
    gap: 16px;
    margin: 0;
    padding: 16px 16px 20px;
    background: var(--color-white);
    border-radius: var(--radius-card);
  }

  .gallery__img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 12px;
  }

  figcaption {
    text-align: center;
    font: 600 20px / 28px var(--font-display);
    color: var(--color-blue-deep);
  }

  .gallery__arrow {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    background: var(--color-white);
    border: 0;
    border-radius: 50%;
    font-size: 22px;
    line-height: 1;
    color: var(--color-blue);
    cursor: pointer;
  }

  .gallery__arrow:hover {
    background: var(--color-soft);
  }

  /* Without JS the arrows do nothing, so hide them and let the row scroll by touch or keyboard. */
  :global(html:not(.js)) .gallery__arrow {
    display: none;
  }

  @media (max-width: 700px) {
    .gallery {
      grid-template-columns: 1fr;
    }

    .gallery__arrow {
      display: none;
    }

    .gallery__tile {
      flex-basis: 78%;
    }

    figcaption {
      font-size: 18px;
      line-height: 26px;
    }
  }
</style>

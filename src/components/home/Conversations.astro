---
import Section from '../Section.astro';
import Video from '../Video.astro';
import VideoEmbed from '../VideoEmbed.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';

import VideoReel from './VideoReel.astro';
import { getSection } from '../../lib/content';
import ProfileImage from '../ProfileImage.astro';
import { getSiteContent } from '../../lib/site-content';
import { getHomeVideos } from '../../lib/home-videos';

// The videos listed in Page text show one at a time beside the text; without any, a video chosen in Site details
// replaces the picture. Either way the hero's "Watch video" button scrolls here. With no video at all the section
// keeps its picture and shows no video controls. "View all videos" leads to the clinic's channel (Page text), and
// only shows once that link is filled in: the site has no videos page of its own.
const { video, videoEmbed } = await getSiteContent();
// Switched off in Page text: no section (and no video).
const conversations = await getSection('home_conversations');
const picture = conversations && (conversations.chosenPhotos.image ?? conversations.image);
const videos = conversations ? await getHomeVideos(conversations.videos) : [];
---

{conversations && picture && (
  <Section
    id={videos.length > 0 || video || videoEmbed ? 'video' : undefined}
    tone="soft"
    labelledby="conversations-title"
  >
    <div class="split">
      <div class="split__text">
        <p class="t-label is-lined is-start">{conversations.label}</p>
        <h2 class="t-h2 pre-line" id="conversations-title">
          {conversations.title}
        </h2>
        <p class="split__body">{conversations.body}</p>
        {conversations.channelUrl && (
          <Button variant="outline" href={conversations.channelUrl} class="split__all">
            View all videos
            <Icon name="arrow-right" />
          </Button>
        )}
      </div>
      {videos.length > 0 ? (
        <VideoReel
          class="split__img"
          videos={videos}
          poster={picture}
          label={conversations.label}
        />
      ) : videoEmbed ? (
        <VideoEmbed
          class="split__img"
          video={videoEmbed}
          poster={picture}
          title={conversations.label}
        />
      ) : video ? (
        <Video class="split__img" video={video} />
      ) : (
        <ProfileImage
          class="split__img"
          image={picture}
          slot="home-conversations"
          sizes="(max-width: 960px) 100vw, 520px"
        />
      )}
    </div>
  </Section>
)}

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 64px;
  }

  .split__img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-image);
    overflow: hidden;
  }

  .split__text {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  .split__body {
    max-width: 480px;
    margin-bottom: 8px;
    color: var(--color-muted);
  }

  @media (max-width: 960px) {
    .split {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>

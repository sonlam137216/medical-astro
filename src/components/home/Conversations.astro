---
import { Image } from 'astro:assets';
import Section from '../Section.astro';
import { conversations } from '../../data/home';
---

<Section tone="soft" labelledby="conversations-title">
  <div class="split">
    <div class="split__text">
      <p class="t-label is-lined is-start">{conversations.label}</p>
      <h2 class="t-h2" id="conversations-title">
        Real conversations.
        <br />
        Expert insights.
        <br />
        Personal experiences.
      </h2>
      <p class="split__body">{conversations.body}</p>
      <div>
        <!-- PROVISIONAL target: no videos page exists (video is out of scope) -->
        <a class="btn-outline-arrow" href="#">
          View All Videos <span aria-hidden="true">⟶</span>
        </a>
      </div>
    </div>
    <Image
      class="split__img"
      src={conversations.image.src}
      alt={conversations.image.alt}
      width={520}
      height={440}
      densities={[1, 2]}
      sizes="(max-width: 960px) 100vw, 520px"
      loading="lazy"
    />
  </div>
</Section>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 64px;
  }

  .split__img {
    width: 100%;
    height: auto;
    aspect-ratio: 520 / 440;
    object-fit: cover;
    border-radius: var(--radius-image);
  }

  .split__text {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  .split__body {
    max-width: 480px;
    margin-bottom: 8px;
    color: var(--color-muted);
  }

  .btn-outline-arrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    padding: 12px 24px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    font: 600 var(--text-small) / var(--text-small-lh) var(--font-display);
    color: var(--color-title);
  }

  .btn-outline-arrow:hover {
    border-color: var(--color-blue);
  }

  @media (max-width: 960px) {
    .split {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>

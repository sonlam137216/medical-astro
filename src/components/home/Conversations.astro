---
import { Image } from 'astro:assets';
import Section from '../Section.astro';
import Video from '../Video.astro';
import { conversations } from '../../data/home';
import { getSiteContent } from '../../lib/site-content';

// With a video chosen in Site details the player replaces the picture (the hero's "Watch video" button scrolls
// here). Without one the section keeps its picture and shows no video controls or "View all videos" button:
// there is no videos page.
const { video } = await getSiteContent();
---

<Section id={video ? 'video' : undefined} tone="soft" labelledby="conversations-title">
  <div class="split">
    <div class="split__text">
      <p class="t-label is-lined is-start">{conversations.label}</p>
      <h2 class="t-h2" id="conversations-title">
        Real conversations.
        <br />
        Expert insights.
        <br />
        Personal experiences.
      </h2>
      <p class="split__body">{conversations.body}</p>
    </div>
    {video ? (
      <Video class="split__img" video={video} />
    ) : (
      <Image
        class="split__img"
        src={conversations.image.src}
        alt={conversations.image.alt}
        width={520}
        height={440}
        densities={[1, 2]}
        sizes="(max-width: 960px) 100vw, 520px"
        loading="lazy"
      />
    )}
  </div>
</Section>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 64px;
  }

  .split__img {
    width: 100%;
    height: auto;
    aspect-ratio: 520 / 440;
    object-fit: cover;
    border-radius: var(--radius-image);
    overflow: hidden;
  }

  .split__text {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  .split__body {
    max-width: 480px;
    margin-bottom: 8px;
    color: var(--color-muted);
  }

  @media (max-width: 960px) {
    .split {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>

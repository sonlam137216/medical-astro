---
import Section from '../Section.astro';

import { getSection } from '../../lib/content';

const whyMelatec = await getSection('home_why');
---

{whyMelatec && (
  <Section tone="soft" labelledby="why-title">
    <div class="why">
      <div class="why__intro">
        <p class="t-label is-lined is-start">{whyMelatec.label}</p>
        <h2 class="t-h2" id="why-title">
          {whyMelatec.title}
        </h2>
        {whyMelatec.body && <p class="why__body">{whyMelatec.body}</p>}
      </div>

      <ol class="why__list">
        {whyMelatec.items.map((item) => (
          <li class="why__item">
            <span class="why__no" aria-hidden="true">
              {Number(item.number)}
            </span>
            <div>
              <h3 class="t-h3">{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </Section>
)}

<style>
  .why {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 64px;
    align-items: start;
  }

  .why__intro {
    display: grid;
    gap: 16px;
  }

  .why__body {
    color: var(--color-muted);
  }

  .why__list {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Figma: each point is a white outlined card with a numbered circle on its left. */
  .why__item {
    display: grid;
    grid-template-columns: 44px 1fr;
    align-items: start;
    gap: 20px;
    padding: 20px 24px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: 0 2px 10px rgb(0 86 229 / 8%);
  }

  .why__item h3 {
    margin-bottom: 6px;
    color: var(--color-blue);
  }

  .why__item p {
    font-size: var(--text-small);
    line-height: var(--text-small-lh);
    color: var(--color-muted);
  }

  .why__no {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-blue);
    border-radius: 50%;
    font: 500 20px / 1 var(--font-display);
    color: var(--color-blue);
  }

  @media (max-width: 960px) {
    .why {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>

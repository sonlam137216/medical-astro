---
import { getSection } from '../../lib/content';

const section = await getSection('home_support');
---

{section && section.items.length > 0 && (
  <section class="support" aria-label="Why international patients choose Melatec">
    <div class="container">
      <!-- UI update: Figma's outlined boxes read as buttons; now a plain row of reasons with a tick and an
           optional line of text, split by hairlines. -->
      <ul class="support__grid">
        {section.items.map((item) => (
          <li class="support__item">
            <span class="support__tick" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18">
                <path
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m6 12.5 4 4 8-9"
                ></path>
              </svg>
            </span>
            <span class="support__text">
              <span class="support__title pre-line">{item.title}</span>
              {item.body && <span class="support__body">{item.body}</span>}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .support {
    background: var(--color-white);
    border-bottom: 1px solid var(--color-border);
  }

  .support__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .support__item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 28px 20px;
  }

  .support__item + .support__item {
    border-left: 1px solid var(--color-border);
  }

  .support__item:first-child {
    padding-left: 0;
  }

  .support__tick {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--color-soft);
    color: var(--color-blue);
  }

  .support__text {
    display: grid;
    gap: 4px;
  }

  .support__title {
    font: 600 15px / 22px var(--font-display);
    color: var(--color-title);
  }

  .support__body {
    font-size: var(--text-small);
    line-height: 20px;
    color: var(--color-muted);
  }

  @media (max-width: 1024px) {
    .support__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .support__item:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }

    .support__item:nth-child(n + 3) {
      border-top: 1px solid var(--color-border);
    }
  }

  @media (max-width: 520px) {
    .support__grid {
      grid-template-columns: 1fr;
    }

    .support__item {
      padding: 16px 0;
    }

    .support__item + .support__item {
      border-left: 0;
      border-top: 1px solid var(--color-border);
    }
  }
</style>

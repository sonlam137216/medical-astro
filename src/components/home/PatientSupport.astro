---
import { patientSupport } from '../../data/home';
---

<section class="support" aria-label="Why international patients choose Melatec">
  <div class="container">
    <ul class="support__grid">
      {patientSupport.map((item) => (
        <li class="support__card">{item.title}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Figma: four outlined boxes, centred two-line text in blue. */
  .support {
    padding-block: 48px 8px;
    background: var(--color-white);
  }

  .support__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .support__card {
    display: grid;
    place-items: center;
    min-height: 88px;
    padding: 16px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: 0 2px 10px rgb(0 86 229 / 8%);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-body);
    line-height: var(--text-body-lh);
    color: var(--color-blue);
    text-align: center;
    white-space: pre-line;
  }

  @media (max-width: 1024px) {
    .support__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 520px) {
    .support__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

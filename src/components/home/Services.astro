---
import Section from '../Section.astro';
import SectionIntro from '../SectionIntro.astro';
import Button from '../Button.astro';
import PackageCard from '../cards/PackageCard.astro';
import { services } from '../../data/home';
---

<Section labelledby="services-title">
  <SectionIntro label="Our services" headingId="services-title" align="center" lined>
    <Fragment slot="title">Treatments for every smile</Fragment>
  </SectionIntro>

  <ul class="grid">
    {services.map((s) => (
      <li>
        <PackageCard {...s} />
      </li>
    ))}
  </ul>

  <div class="actions">
    <Button href="/services">Explore Our Dental Services</Button>
    <Button variant="outline" href="/dental-packages">
      Top Dental Packages
    </Button>
  </div>
</Section>

<style>
  /* 3 per row, the last row centred (Figma: 3 + 2) */
  .grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid li {
    flex: 0 0 calc((100% - 48px) / 3);
    display: flex;
  }

  .grid li > :global(*) {
    flex: 1;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }

  @media (max-width: 1024px) {
    .grid li {
      flex-basis: calc((100% - 24px) / 2);
    }
  }

  @media (max-width: 640px) {
    .grid li {
      flex-basis: 100%;
    }
  }
</style>

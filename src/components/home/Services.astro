---
import Section from '../Section.astro';
import SectionIntro from '../SectionIntro.astro';
import Button from '../Button.astro';
import ServiceTile from '../cards/ServiceTile.astro';
import { getSection, getServices } from '../../lib/content';

// UI update: one row of up to four cards; the full list (and what each includes) is on the Services page.
const HOME_LIMIT = 4;
const services = (await getServices()).slice(0, HOME_LIMIT);
const heading = (await getSection('home_services'))!;
---

<Section labelledby="services-title">
  <SectionIntro label={heading.label} headingId="services-title" align="center" lined>
    <Fragment slot="title">{heading.title}</Fragment>
  </SectionIntro>

  <ul class="grid">
    {services.map((s) => (
      <li>
        <ServiceTile
          title={s.title}
          summary={s.summary}
          price={s.priceText}
          href={s.href}
          image={s.image}
        />
      </li>
    ))}
  </ul>

  <div class="actions">
    <Button href="/services">Explore Our Dental Services</Button>
    <Button variant="outline" href="/dental-packages">
      Top Dental Packages
    </Button>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid li {
    display: flex;
  }

  .grid li > :global(*) {
    flex: 1;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }

  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import Section from '../Section.astro';
import SectionIntro from '../SectionIntro.astro';
import Button from '../Button.astro';
import TreatmentGrid from '../TreatmentGrid.astro';
import { getHomeTreatments, getSection } from '../../lib/content';

// The treatments ticked "Show on the Home page" (Services > a service > Treatments); none: no section.
const treatments = await getHomeTreatments();
const heading = (await getSection('home_services'))!;
---

{treatments.length > 0 && (
  <Section labelledby="services-title">
    <SectionIntro label={heading.label} headingId="services-title" align="center" lined>
      <Fragment slot="title">{heading.title}</Fragment>
    </SectionIntro>

    <TreatmentGrid items={treatments} />

    <div class="actions services__actions">
      <Button href="/services">Explore Our Dental Services</Button>
      <Button variant="outline" href="/dental-packages">
        Top Dental Packages
      </Button>
    </div>
  </Section>
)}

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }
</style>

---
import Section from '../Section.astro';
import SectionIntro from '../SectionIntro.astro';
import { costComparison as c } from '../../data/home';
import { getSection } from '../../lib/content';
import type { CostRow } from '../../data/sections';

// Shared by Home and the Dental Implants page: the same table with the rows, title and figures of each page's
// "Page text" section. Before the section is edited the rows show the design's placeholder figures.
interface Props {
  sectionKey: 'home_costs' | 'implants_comparison';
  align?: 'start' | 'center';
}
const { sectionKey, align = 'start' } = Astro.props;

type Row = CostRow;
const data = await getSection(sectionKey);

// Vietnam is always shown first; the visitor picks which other country to compare against.
const [home, ...others] = c.countries;
const defaultCountry = others.includes('Australia') ? 'Australia' : others[0];

// "A$1,250 | 40 clinics" -> two lines. Empty: a dash. Built-in rows: the design's placeholder figures.
const cellLines = (row: Row, i: number): string[] => {
  if (!data?.edited) return [c.cell.price, c.cell.clinics];
  const value = (row.cells?.[i] ?? '').trim();
  return value ? value.split(/\s*\|\s*/) : ['—'];
};
const saving = (row: Row) => (data?.edited ? row.saving || '—' : c.saving);
const methodParagraphs = (data?.methodology ?? '')
  .split(/\n{2,}|\n/)
  .filter((p) => p.trim() !== '');
---

{data && (
  <Section labelledby="costs-title">
    <SectionIntro label={data.label} headingId="costs-title" lined {align}>
      <Fragment slot="title">
        <span class="pre-line">{data.title}</span>
      </Fragment>
    </SectionIntro>

    <div class="compare" data-compare>
      <label class="compare__label" for="compare-country">
        Compare against prices in
      </label>
      <select class="compare__select" id="compare-country" data-compare-select>
        {others.map((country) => (
          <option value={country} selected={country === defaultCountry}>
            {country}
          </option>
        ))}
      </select>
    </div>

    <div class="scroller" tabindex="0" role="region" aria-label="Treatment cost comparison">
      <table class="table" data-compare-table>
        <caption class="visually-hidden">
          Treatment prices in{home}compared with the selected country
        </caption>
        <thead>
          <tr>
            <th scope="col">Treatment</th>
            {c.countries.map((country, i) => (
              <th
                scope="col"
                data-country={country}
                class:list={{
                  'is-home': i === 0,
                  'is-selected': country === defaultCountry,
                }}
              >
                {country}
              </th>
            ))}
            <th scope="col">Saving</th>
          </tr>
        </thead>
        <tbody>
          {data.rows.map((row) => (
            <tr>
              <th scope="row">
                <span class="row__name">{row.name}</span>
                <span class="row__note">{row.note}</span>
              </th>
              {c.countries.map((country, i) => (
                <td
                  data-country={country}
                  class:list={{
                    'is-home': i === 0,
                    'is-selected': country === defaultCountry,
                  }}
                >
                  {cellLines(row, i).map((line, n) => (
                    <>
                      {n > 0 && <br />}
                      {line}
                    </>
                  ))}
                </td>
              ))}
              <td>{saving(row)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <details class="method">
      <summary>{c.methodologyTitle}</summary>
      {methodParagraphs.length > 0 ? (
        methodParagraphs.map((p) => <p class="muted">{p}</p>)
      ) : (
        <p class="muted">Methodology to be provided by Melatec.</p>
      )}
    </details>
  </Section>
)}

<script>
  // Highlights the column of the chosen country. The table already renders every country, so
  // without JavaScript the default country stays highlighted and nothing is lost.
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach((box) => {
    const select = box.querySelector('select');
    const table = box.parentElement?.querySelector<HTMLTableElement>('[data-compare-table]');
    if (!select || !table) return;
    select.addEventListener('change', () => {
      table.querySelectorAll<HTMLElement>('[data-country]').forEach((cell) => {
        cell.classList.toggle('is-selected', cell.dataset.country === select.value);
      });
    });
  });
</script>

<style>
  .compare {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .compare__label {
    font-size: var(--text-small);
    color: var(--color-muted);
  }

  .compare__select {
    min-width: 160px;
    height: 40px;
    padding: 0 14px;
    font: 600 var(--text-small) / var(--text-small-lh) var(--font-display);
    color: var(--color-title);
    background: var(--color-white);
    border: 1px solid var(--color-title);
    border-radius: 10px;
  }

  .scroller {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .table {
    width: 100%;
    min-width: 960px;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: var(--text-small);
    line-height: var(--text-small-lh);
    text-align: left;
  }

  thead th {
    padding: 18px 10px;
    font-weight: 600;
    color: var(--color-title);
  }

  thead th:first-child,
  tbody th {
    width: 220px;
    padding-left: 24px;
  }

  tbody tr + tr {
    border-top: 1px solid var(--color-border);
  }

  tbody th,
  tbody td {
    padding: 18px 10px;
    vertical-align: top;
    font-weight: 400;
    color: var(--color-muted);
  }

  tbody th {
    padding-right: 16px;
  }

  .row__name {
    display: block;
    font-weight: 600;
    color: var(--color-title);
  }

  .row__note {
    display: block;
    margin-top: 4px;
  }

  /* Vietnam column: solid blue band running through header and rows. */
  .table .is-home {
    background: var(--color-blue);
    color: var(--color-white);
  }

  tbody td.is-home {
    font-weight: 600;
  }

  /* Chosen comparison country: light blue column. */
  .table .is-selected {
    background: var(--color-border);
    color: var(--color-blue-deep);
  }

  .method summary {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 12px 20px;
    cursor: pointer;
    list-style: none;
    font: 500 var(--text-body) / var(--text-body-lh) var(--font-display);
    color: var(--color-title);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
  }

  .method summary::-webkit-details-marker {
    display: none;
  }

  .method summary::after {
    content: '+';
    font-size: 20px;
    line-height: 20px;
    color: var(--color-blue);
  }

  .method[open] summary::after {
    content: '–';
  }

  .method p {
    margin-top: 12px;
  }
</style>

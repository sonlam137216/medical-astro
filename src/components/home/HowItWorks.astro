---
import Section from '../Section.astro';
import SectionIntro from '../SectionIntro.astro';
import Button from '../Button.astro';
import JourneyCard from '../cards/JourneyCard.astro';
import { howItWorks } from '../../data/home';
import { site } from '../../data/site';
---

<Section tone="navy" labelledby="how-title">
  <SectionIntro label={howItWorks.label} headingId="how-title" inverse>
    <Fragment slot="title">Dental Journey, Made Simple</Fragment>
  </SectionIntro>

  <ol class="grid">
    {howItWorks.steps.map((s) => (
      <li>
        <JourneyCard {...s} />
      </li>
    ))}
  </ol>

  <div class="help">
    <p>
      {howItWorks.helpTitle}
      <br />
      {howItWorks.helpBody}
    </p>
    <Button variant="outline" href={site.whatsappUrl}>
      Chat on WhatsApp
    </Button>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid li {
    display: flex;
  }

  .grid li > :global(*) {
    flex: 1;
  }

  .help {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 8px;
  }

  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

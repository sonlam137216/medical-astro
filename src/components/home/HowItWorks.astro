---
import Section from '../Section.astro';
import SectionIntro from '../SectionIntro.astro';
import JourneySteps from '../JourneySteps.astro';

import { getSection } from '../../lib/content';
import { getSiteContent } from '../../lib/site-content';

const site = await getSiteContent();
const howItWorks = await getSection('home_how');
---

{howItWorks && (
  <Section tone="blue" labelledby="how-title">
    <SectionIntro label={howItWorks.label} headingId="how-title" inverse lined>
      <Fragment slot="title">{howItWorks.title}</Fragment>
    </SectionIntro>

    <!-- UI update: numbered steps on a dashed line instead of four cards repeating one X-ray picture. -->
    <JourneySteps steps={howItWorks.steps} />

    <div class="help">
      <p>
        {howItWorks.helpTitle}
        {howItWorks.helpTitle && howItWorks.helpBody && <br />}
        {howItWorks.helpBody}
      </p>
      {site.whatsappUrl && (
        <a class="help__btn" href={site.whatsappUrl}>
          Chat on WhatsApp <span aria-hidden="true">⟶</span>
        </a>
      )}
    </div>
  </Section>
)}

<style>
  .help {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 8px;
    font-family: var(--font-display);
  }

  .help__btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    padding: 12px 24px;
    background: var(--color-white);
    border-radius: var(--radius-button);
    font: 600 var(--text-small) / var(--text-small-lh) var(--font-display);
    color: var(--color-blue-deep);
  }

  .help__btn:hover {
    background: var(--color-soft);
  }
</style>

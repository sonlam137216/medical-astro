---
import Section from '../Section.astro';
import SectionIntro from '../SectionIntro.astro';
import JourneyCard from '../cards/JourneyCard.astro';
import { howItWorks } from '../../data/home';
import { getSiteContent } from '../../lib/site-content';

const site = await getSiteContent();
---

<Section tone="blue" labelledby="how-title">
  <SectionIntro label={howItWorks.label} headingId="how-title" inverse lined>
    <Fragment slot="title">Dental Journey, Made Simple</Fragment>
  </SectionIntro>

  <ol class="grid">
    {howItWorks.steps.map((s) => (
      <li>
        <JourneyCard {...s} />
      </li>
    ))}
  </ol>

  <div class="help">
    <p>
      {howItWorks.helpTitle}
      <br />
      {howItWorks.helpBody}
    </p>
    {site.whatsappUrl && (
      <a class="help__btn" href={site.whatsappUrl}>
        Chat on WhatsApp <span aria-hidden="true">⟶</span>
      </a>
    )}
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid li {
    display: flex;
  }

  .grid li > :global(*) {
    flex: 1;
  }

  .help {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 8px;
    font-family: var(--font-display);
  }

  .help__btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    padding: 12px 24px;
    background: var(--color-white);
    border-radius: var(--radius-button);
    font: 600 var(--text-small) / var(--text-small-lh) var(--font-display);
    color: var(--color-blue-deep);
  }

  .help__btn:hover {
    background: var(--color-soft);
  }

  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import Section from '../Section.astro';
import SectionIntro from '../SectionIntro.astro';

import { getSection } from '../../lib/content';
import { getSiteContent } from '../../lib/site-content';

const site = await getSiteContent();
const howItWorks = await getSection('home_how');
---

{howItWorks && (
  <Section tone="blue" labelledby="how-title">
    <SectionIntro label={howItWorks.label} headingId="how-title" inverse lined>
      <Fragment slot="title">{howItWorks.title}</Fragment>
    </SectionIntro>

    <!-- UI update: numbered steps on a dashed line instead of four cards repeating one X-ray picture.
         The optional tag ("Online", "In Vietnam") says where the step happens. -->
    <ol class="steps">
      {howItWorks.steps.map((s, i) => (
        <li class="step">
          <span class="step__no" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          {s.tag && <span class="step__tag">{s.tag}</span>}
          <h3 class="step__title">
            <span class="visually-hidden">Step {i + 1}: </span>
            {s.title}
          </h3>
          {s.body && <p class="step__body">{s.body}</p>}
        </li>
      ))}
    </ol>

    <div class="help">
      <p>
        {howItWorks.helpTitle}
        {howItWorks.helpTitle && howItWorks.helpBody && <br />}
        {howItWorks.helpBody}
      </p>
      {site.whatsappUrl && (
        <a class="help__btn" href={site.whatsappUrl}>
          Chat on WhatsApp <span aria-hidden="true">⟶</span>
        </a>
      )}
    </div>
  </Section>
)}

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 28px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  /* A dashed line from each number to the next one. */
  .step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 24px;
    left: 62px;
    right: -14px;
    border-top: 2px dashed rgb(255 255 255 / 35%);
  }

  .step {
    position: relative;
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 10px;
  }

  .step__no {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 6px;
    border-radius: 50%;
    background: var(--color-white);
    box-shadow: 0 0 0 6px rgb(255 255 255 / 14%);
    font: 700 16px / 1 var(--font-display);
    color: var(--color-blue);
  }

  .step__tag {
    padding: 2px 10px;
    border-radius: 999px;
    background: rgb(255 255 255 / 16%);
    font: 600 12px / 20px var(--font-sans);
    letter-spacing: 0.02em;
    color: var(--color-white);
  }

  .step__title {
    font: 600 18px / 26px var(--font-display);
    color: var(--color-white);
  }

  .step__body {
    font-size: var(--text-small);
    line-height: 22px;
    color: rgb(255 255 255 / 85%);
  }

  .help {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 8px;
    font-family: var(--font-display);
  }

  .help__btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    padding: 12px 24px;
    background: var(--color-white);
    border-radius: var(--radius-button);
    font: 600 var(--text-small) / var(--text-small-lh) var(--font-display);
    color: var(--color-blue-deep);
  }

  .help__btn:hover {
    background: var(--color-soft);
  }

  /* Two or more rows: a single line across would join steps that are not next to each other. */
  @media (max-width: 1024px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }

    .step:not(:last-child)::after {
      display: none;
    }
  }

  /* Phones: one column, the line runs down past the numbers. */
  @media (max-width: 520px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .step:not(:last-child)::after {
      display: block;
      top: 62px;
      bottom: -18px;
      left: 23px;
      right: auto;
      border-top: 0;
      border-left: 2px dashed rgb(255 255 255 / 35%);
    }

    .step {
      grid-template-columns: 48px 1fr;
      column-gap: 16px;
      row-gap: 6px;
    }

    .step__no {
      grid-row: span 3;
      margin-bottom: 0;
    }

    .step > :not(.step__no) {
      grid-column: 2;
    }

    .step__tag {
      justify-self: start;
    }
  }
</style>

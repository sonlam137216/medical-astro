---
import BeforeAfter from '../BeforeAfter.astro';
import Icon from '../Icon.astro';
import Section from '../Section.astro';
import SectionIntro from '../SectionIntro.astro';
import StoryText from './StoryText.astro';
import { parseArticleBody } from '../../lib/cms/articles';
import { getSection, getSmileStories } from '../../lib/content';

// "Smile transformations: Real Stories. Real Smiles.": one slide per Smile story, each a formatted story beside a
// before/after slider. The heading is Page text ("Home: smile transformation"). Before any story is published the
// block shows the sample slide (two drawn pictures), unless the heading was already edited for the live site.
// The row is a plain horizontal scroller that snaps to each slide, so it works by swipe, trackpad or keyboard
// without JavaScript; the arrows and dots are drawn with it, and only with two slides or more. On the pictures only
// the band around the knob drags the divider, so swiping elsewhere moves to the next slide.
const heading = await getSection('home_smile');
const published = heading ? await getSmileStories() : null;
const slides = published ?? (heading && !heading.edited ? [heading.sample] : []);
const many = slides.length > 1;
---

{heading && slides.length > 0 && (
  <Section labelledby="stories-title">
    <SectionIntro label={heading.label} headingId="stories-title" lined>
      <Fragment slot="title">{heading.title}</Fragment>
    </SectionIntro>

    <div class="stories" data-stories>
      <ul
        class="stories__track"
        aria-label="Smile stories"
        tabindex={many ? 0 : undefined}
        data-stories-track
      >
        {slides.map((story, i) => (
          <li
            class="story"
            aria-roledescription={many ? 'slide' : undefined}
            aria-label={many ? `${i + 1} of ${slides.length}` : undefined}
          >
            <div class="story__text">
              <StoryText blocks={parseArticleBody(story.body)} />
            </div>
            <BeforeAfter
              class="story__img"
              before={story.before}
              after={story.after}
              slot="home-smile"
              sizes="(max-width: 960px) 100vw, 560px"
              band={many}
            />
          </li>
        ))}
      </ul>
      {many && (
        <div class="stories__nav">
          <button
            class="stories__arrow"
            type="button"
            aria-label="Previous story"
            data-stories-prev
          >
            <Icon name="arrow-left" size={20} />
          </button>
          <ol class="stories__dots">
            {slides.map((_, i) => (
              <li>
                <button
                  class="stories__dot"
                  type="button"
                  aria-label={`Show story ${i + 1}`}
                  aria-current={i === 0 ? 'true' : undefined}
                  data-stories-dot={i}
                ></button>
              </li>
            ))}
          </ol>
          <button class="stories__arrow" type="button" aria-label="Next story" data-stories-next>
            <Icon name="arrow-right" size={20} />
          </button>
        </div>
      )}
    </div>
  </Section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-stories]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-stories-track]');
    const slides = track ? [...track.children].map((el) => el as HTMLElement) : [];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-stories-dot]')];
    if (!track || slides.length < 2) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const offset = (el: HTMLElement) => el.offsetLeft - slides[0].offsetLeft;
    let current = 0;
    // Where an arrow sent the row while it is still scrolling there, so quick clicks add up.
    let target: number | null = null;

    const nearest = () => {
      const left = track.scrollLeft;
      let best = 0;
      slides.forEach((s, i) => {
        if (Math.abs(offset(s) - left) < Math.abs(offset(slides[best]) - left)) best = i;
      });
      return best;
    };
    const settle = () => {
      target = null;
      current = nearest();
      dots.forEach((d, n) => {
        if (n === current) d.setAttribute('aria-current', 'true');
        else d.removeAttribute('aria-current');
      });
    };
    // The arrows go round: after the last story comes the first.
    const go = (i: number) => {
      const n = (i + slides.length) % slides.length;
      target = n;
      track.scrollTo({ left: offset(slides[n]), behavior: reduce ? 'auto' : 'smooth' });
    };

    let timer: number | undefined;
    track.addEventListener(
      'scroll',
      () => {
        window.clearTimeout(timer);
        timer = window.setTimeout(settle, 120);
      },
      { passive: true },
    );
    root
      .querySelector('[data-stories-prev]')
      ?.addEventListener('click', () => go((target ?? current) - 1));
    root
      .querySelector('[data-stories-next]')
      ?.addEventListener('click', () => go((target ?? current) + 1));
    dots.forEach((d, n) => d.addEventListener('click', () => go(n)));
  });
</script>

<style>
  .stories {
    display: grid;
    gap: 24px;
    min-width: 0;
  }

  .stories__track {
    display: flex;
    gap: 32px;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    list-style: none;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .stories__track::-webkit-scrollbar {
    display: none;
  }

  .stories__track:focus-visible {
    outline: 3px solid var(--color-blue);
    outline-offset: 4px;
    border-radius: var(--radius-image);
  }

  /* One story per view: the text on the left, the pictures on the right. */
  .story {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    align-items: center;
    gap: 64px;
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: start;
  }

  .story__text {
    max-width: 420px;
  }

  .story :global(.story__img) {
    width: 100%;
  }

  .stories__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .stories__arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-blue);
    cursor: pointer;
  }

  .stories__arrow:hover {
    border-color: var(--color-blue);
  }

  .stories__dots {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stories__dot {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .stories__dot::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-border);
    transition:
      background-color 0.2s,
      scale 0.2s;
  }

  .stories__dot[aria-current='true']::before {
    background: var(--color-blue);
    scale: 1.2;
  }

  /* Without JS the arrows and dots do nothing: the row is swiped or scrolled instead. */
  :global(html:not(.js)) .stories__nav {
    display: none;
  }

  @media (max-width: 960px) {
    .story {
      grid-template-columns: 1fr;
      align-content: start;
      gap: 32px;
    }

    .story__text {
      max-width: none;
    }

    /* The pictures first on a narrow screen, so every slide starts at the same place. */
    .story :global(.story__img) {
      order: -1;
    }
  }
</style>

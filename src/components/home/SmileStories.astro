---
import ProfileImage from '../ProfileImage.astro';
import Section from '../Section.astro';
import SectionIntro from '../SectionIntro.astro';

import { getSection } from '../../lib/content';

// Built-in text: the sample photo. Once the section is edited the photo is the one chosen for it, and without one
// the story is shown without a picture (the sample photo shows a real patient).
const smileStories = await getSection('home_smile');
const picture =
  smileStories && (smileStories.edited ? smileStories.chosenPhotos.image : smileStories.image);
---

{smileStories && (
  <Section labelledby="stories-title">
    <SectionIntro label={smileStories.label} headingId="stories-title" lined>
      <Fragment slot="title">{smileStories.title}</Fragment>
    </SectionIntro>

    <div class="story">
      <div class="story__text">
        <p>{smileStories.summary}</p>
        <div class="story__details">
          {smileStories.details.length > 0 && (
            <>
              <p class="story__heading">{smileStories.detailsTitle}</p>
              <ul>
                {smileStories.details.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            </>
          )}
        </div>
      </div>
      {picture && (
        <ProfileImage
          class="story__img"
          image={picture}
          width={560}
          height={440}
          sizes="(max-width: 960px) 100vw, 560px"
        />
      )}
    </div>
  </Section>
)}

<style>
  .story {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    align-items: center;
    gap: 64px;
  }

  .story__text {
    display: grid;
    gap: 28px;
    max-width: 420px;
    color: var(--color-muted);
  }

  .story__heading {
    margin-bottom: 8px;
    font-weight: 700;
    color: var(--color-blue);
  }

  .story__details ul {
    display: grid;
    gap: 6px;
    margin: 0;
    padding-left: 20px;
  }

  .story__img {
    width: 100%;
    height: auto;
    aspect-ratio: 560 / 440;
    object-fit: cover;
    border-radius: var(--radius-image);
  }

  @media (max-width: 960px) {
    .story {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .story__text {
      max-width: none;
    }
  }
</style>

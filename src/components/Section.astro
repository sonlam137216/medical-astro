---
// Section band: full-width, side padding from the .container, 80px vertical, 40px gap.
interface Props {
  tone?: 'white' | 'soft' | 'navy' | 'blue';
  id?: string;
  labelledby?: string;
  class?: string;
}

const { tone = 'white', id, labelledby, class: className } = Astro.props;
---

<section id={id} aria-labelledby={labelledby} class:list={['band', `band--${tone}`, className]}>
  <div class="container band__inner">
    <slot />
  </div>
</section>

<style>
  .band {
    padding-block: var(--section-pad-y);
  }

  .band--white {
    background: var(--color-white);
  }

  .band--soft {
    background: var(--color-soft);
  }

  /* Dark navy band (Figma: gradient #001A4F → #002B68). */
  .band--navy {
    background: var(--gradient-band);
    color: var(--color-white);
  }

  /* Bright blue band (Home gallery, "How it works"). */
  .band--blue {
    background: var(--gradient-blue);
    color: var(--color-white);
  }

  .band__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
</style>

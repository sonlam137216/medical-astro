---
import Icon from './Icon.astro';
import FormGuards from './FormGuards.astro';
import Button from './Button.astro';
import PhoneField from './PhoneField.astro';
import { getServiceLinks, getSiteContent } from '../lib/site-content';

import { getSection } from '../lib/content';

const site = await getSiteContent();

// Each page keeps its own editable copy; the Packages variant follows Figma's one-column form.
interface Props {
  variant?: 'implants' | 'packages';
}
const { variant = 'implants' } = Astro.props;
const packages = variant === 'packages';
const plan = await getSection(packages ? 'packages_plan' : 'implants_plan');
const interests = (await getServiceLinks()).map((t) => t.label);
---

{plan && (
  <section
    class:list={['band', { 'band--packages': packages }]}
    id="consultation"
    aria-labelledby="plan-title"
  >
    <div class="container">
      <div class="plan">
        <div class="plan__info">
          <p class="plan__label">{plan.label}</p>
          <h2 class="t-h2" id="plan-title">
            {plan.title}
          </h2>
          <p>{plan.body}</p>
          <ul class="plan__bullets">
            {plan.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
          {site.whatsappUrl && (
            <div>
              <Button variant={packages ? 'whatsapp-outline' : 'outline'} href={site.whatsappUrl}>
                {!packages && <Icon name="brand-whatsapp" />}
                Ask on WhatsApp
              </Button>
            </div>
          )}
        </div>

        <!-- POST so personal data never lands in the URL. Same endpoint as the shared consultation form. -->
        <form class="form" method="post" action="/api/consultation" data-form="consultation">
          <FormGuards part="fields" />
          <div class="field">
            <label for="pv-name">{packages ? 'Name' : 'Full name'}</label>
            <input
              id="pv-name"
              name="name"
              type="text"
              autocomplete="name"
              placeholder={packages ? undefined : 'Your full name'}
              maxlength="120"
              required
            />
          </div>
          {packages && <PhoneField id="pv-phone" label="Phone" placeholder="" />}
          <div class="field">
            <label for="pv-email">Email</label>
            <input
              id="pv-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder={packages ? undefined : 'you@example.com'}
              maxlength="254"
              required
            />
          </div>
          {!packages && <PhoneField id="pv-phone" label="Phone / WhatsApp" class="form__wide" />}
          <div class="field form__wide">
            <label for="pv-interest">{packages ? 'Services' : 'Treatment interest'}</label>
            <select id="pv-interest" name="service">
              <option value="">Select a treatment</option>
              {interests.map((i) => (
                <option value={i}>{i}</option>
              ))}
            </select>
          </div>
          <div class="form__actions">
            <Button type="submit" variant={packages ? 'outline' : 'primary'}>
              Request consultation
            </Button>
          </div>
          <FormGuards part="status" />
          {!packages && <p class="form__note">Your information is kept confidential.</p>}
        </form>
      </div>
    </div>
  </section>
)}

<style>
  .band {
    padding-block: var(--section-pad-y);
    background: var(--color-white);
  }

  /* Figma: copy and bullets on the left, the form in a bordered white card on the right. */
  .plan {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 48px;
  }

  .plan__info {
    display: grid;
    align-content: center;
    gap: 20px;
  }

  .plan__label {
    display: grid;
    gap: 8px;
    justify-items: start;
    font: 700 var(--text-body) / var(--text-body-lh) var(--font-display);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-title);
  }

  .plan__label::after {
    content: '';
    width: 64px;
    height: 1px;
    background: currentcolor;
    opacity: 0.6;
  }

  .plan__bullets {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .plan__bullets li {
    position: relative;
    padding-left: 22px;
  }

  .plan__bullets li::before {
    content: '';
    position: absolute;
    top: 9px;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-title);
  }

  .form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    padding: 32px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: 0 6px 18px rgb(0 86 229 / 8%);
    --field-label: var(--color-title);
    --field-label-font: 700 var(--text-small) / var(--text-small-lh) var(--font-display);
    --field-label-transform: uppercase;
  }

  .field {
    display: grid;
    gap: 8px;
  }

  .field label {
    font: var(--field-label-font);
    text-transform: var(--field-label-transform);
    color: var(--field-label);
  }

  .field input,
  .field select {
    width: 100%;
    height: 54px;
    padding: 0 16px;
    font: inherit;
    color: var(--color-navy);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
  }

  .field input::placeholder {
    color: var(--color-muted);
  }

  .form__actions,
  .form__status,
  .form__note,
  .form :global(.form__wide) {
    grid-column: 1 / -1;
  }

  .form__actions {
    display: flex;
  }

  .form__note {
    color: var(--color-muted);
  }

  /* Dental Packages / Treatment Prices, Figma 342:652. Keep the original Implants variant. */
  .band--packages .plan {
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    align-items: start;
    gap: 32px;
  }

  .band--packages .plan__info {
    gap: 18px;
    color: var(--color-muted);
    font-family: var(--font-display);
  }

  .band--packages .plan__label {
    gap: 12px;
    color: var(--color-blue);
    font-weight: 500;
  }

  .band--packages .plan__info h2 {
    color: var(--color-title);
  }

  .band--packages .plan__bullets {
    gap: 14px;
  }

  .band--packages .form {
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    margin-top: 72px;
    padding: 36px 40px;
    --field-label: var(--color-blue-deep);
    --field-bg: var(--color-field);
    --field-color: var(--color-blue-deep);
    --field-height: 48px;
    --field-radius: 10px;
    --phone-code-width: 96px;
    --phone-code-pad: 10px;
  }

  .band--packages .field input,
  .band--packages .field select {
    height: var(--field-height);
    border-radius: var(--field-radius);
    background: var(--field-bg);
    color: var(--field-color);
  }

  .band--packages :global(.phone) {
    gap: 0;
    min-width: 0;
  }

  .band--packages :global(.phone select) {
    border-radius: var(--field-radius) 0 0 var(--field-radius);
  }

  .band--packages :global(.phone input) {
    min-width: 0;
    border-left: 0;
    border-radius: 0 var(--field-radius) var(--field-radius) 0;
  }

  .band--packages .form__actions :global(.btn) {
    width: 100%;
    border-color: var(--color-blue-deep);
    border-radius: 999px;
    padding-inline: 12px;
    color: var(--color-blue-deep);
    font-weight: 700;
    text-transform: uppercase;
    white-space: normal;
  }

  .band--packages .form :global(.form__status:empty) {
    display: none;
  }

  @media (max-width: 900px) {
    .plan,
    .band--packages .plan {
      grid-template-columns: minmax(0, 1fr);
    }

    .band--packages .form {
      margin-top: 0;
    }
  }

  @media (max-width: 560px) {
    .form,
    .band--packages .form {
      grid-template-columns: minmax(0, 1fr);
      padding: 24px 20px;
    }
  }
</style>

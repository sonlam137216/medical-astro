---
import Button from './Button.astro';
import { site, footerTreatments } from '../data/site';

// Consultation block used on the Dental Implants landing page (different copy and fields from the shared one).
const interests = footerTreatments.map((t) => t.label); // PROVISIONAL option list
---

<section class="band" id="consultation" aria-labelledby="plan-title">
  <div class="container">
    <div class="plan">
      <div class="plan__info">
        <p class="t-label">Let’s plan your visit</p>
        <h2 class="t-h2" id="plan-title">
          Your new smile
          <br />
          starts with a conversation.
        </h2>
        <p>
          Tell us what you need. Our team can help you understand treatment options and plan your
          visit to Vietnam.
        </p>
        <p class="plan__whatsapp">
          <a href={site.whatsappUrl}>WhatsApp&nbsp; {site.phoneDisplay}</a>
        </p>
      </div>

      <!-- Not wired yet (Phase 4). POST so personal data never lands in the URL; the endpoint does not exist yet. -->
      <form class="form" method="post" action="/api/consultation" data-form="consultation">
        <div class="field">
          <label for="pv-name">Full name</label>
          <input
            id="pv-name"
            name="name"
            type="text"
            autocomplete="name"
            placeholder="Your full name"
            required
          />
        </div>
        <div class="field">
          <label for="pv-email">Email</label>
          <input
            id="pv-email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="you@example.com"
            required
          />
        </div>
        <div class="field">
          <label for="pv-phone">Phone / WhatsApp</label>
          <input
            id="pv-phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            placeholder="Country code + number"
            required
          />
        </div>
        <div class="field">
          <label for="pv-interest">Treatment interest</label>
          <select id="pv-interest" name="service">
            <option value="">Select a treatment</option>
            {interests.map((i) => (
              <option value={i}>{i}</option>
            ))}
          </select>
        </div>
        <div class="form__actions">
          <Button type="submit">Request consultation</Button>
        </div>
        <p class="form__note">Your information is kept confidential.</p>
      </form>
    </div>
  </div>
</section>

<style>
  .band {
    padding-block: var(--section-pad-y);
    background: var(--color-white);
  }

  .plan {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    padding: 48px 40px;
    background: var(--color-soft);
    border-radius: var(--radius-panel);
  }

  .plan__info {
    display: grid;
    align-content: center;
    gap: 20px;
  }

  .plan__whatsapp a {
    color: var(--color-blue);
  }

  .form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .field {
    display: grid;
    gap: 8px;
  }

  .field label {
    color: var(--color-heading);
  }

  .field input,
  .field select {
    width: 100%;
    height: 54px;
    padding: 0 16px;
    font: inherit;
    color: var(--color-navy);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
  }

  .field input::placeholder {
    color: var(--color-muted);
  }

  .form__actions,
  .form__note {
    grid-column: 1 / -1;
  }

  .form__actions {
    display: flex;
  }

  .form__note {
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .plan {
      grid-template-columns: 1fr;
      padding: 32px 20px;
    }
  }

  @media (max-width: 560px) {
    .form {
      grid-template-columns: 1fr;
    }
  }
</style>

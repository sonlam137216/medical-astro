---
import FormGuards from './FormGuards.astro';
import Button from './Button.astro';
import PhoneField from './PhoneField.astro';
import { getServiceLinks, getSiteContent } from '../lib/site-content';

import { getSection } from '../lib/content';

const site = await getSiteContent();

// Consultation block used on the Dental Implants landing page (different copy and fields from the shared one).
const plan = (await getSection('implants_plan'))!;
const interests = (await getServiceLinks()).map((t) => t.label);
---

<section class="band" id="consultation" aria-labelledby="plan-title">
  <div class="container">
    <div class="plan">
      <div class="plan__info">
        <p class="plan__label">{plan.label}</p>
        <h2 class="t-h2" id="plan-title">
          {plan.title}
        </h2>
        <p>{plan.body}</p>
        <ul class="plan__bullets">
          {plan.bullets.map((b) => (
            <li>{b}</li>
          ))}
        </ul>
        {site.whatsappUrl && (
          <div>
            <Button variant="outline" href={site.whatsappUrl}>
              Ask on WhatsApp
            </Button>
          </div>
        )}
      </div>

      <!-- POST so personal data never lands in the URL. Same endpoint as the shared consultation form. -->
      <form class="form" method="post" action="/api/consultation" data-form="consultation">
        <FormGuards part="fields" />
        <div class="field">
          <label for="pv-name">Full name</label>
          <input
            id="pv-name"
            name="name"
            type="text"
            autocomplete="name"
            placeholder="Your full name"
            maxlength="120"
            required
          />
        </div>
        <div class="field">
          <label for="pv-email">Email</label>
          <input
            id="pv-email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="you@example.com"
            maxlength="254"
            required
          />
        </div>
        <PhoneField id="pv-phone" label="Phone / WhatsApp" class="form__wide" />
        <div class="field form__wide">
          <label for="pv-interest">Treatment interest</label>
          <select id="pv-interest" name="service">
            <option value="">Select a treatment</option>
            {interests.map((i) => (
              <option value={i}>{i}</option>
            ))}
          </select>
        </div>
        <div class="form__actions">
          <Button type="submit">Request consultation</Button>
        </div>
        <FormGuards part="status" />
        <p class="form__note">Your information is kept confidential.</p>
      </form>
    </div>
  </div>
</section>

<style>
  .band {
    padding-block: var(--section-pad-y);
    background: var(--color-white);
  }

  /* Figma: copy and bullets on the left, the form in a bordered white card on the right. */
  .plan {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 48px;
  }

  .plan__info {
    display: grid;
    align-content: center;
    gap: 20px;
  }

  .plan__label {
    display: grid;
    gap: 8px;
    justify-items: start;
    font: 700 var(--text-body) / var(--text-body-lh) var(--font-display);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-title);
  }

  .plan__label::after {
    content: '';
    width: 64px;
    height: 1px;
    background: currentcolor;
    opacity: 0.6;
  }

  .plan__bullets {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .plan__bullets li {
    position: relative;
    padding-left: 22px;
  }

  .plan__bullets li::before {
    content: '';
    position: absolute;
    top: 9px;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-title);
  }

  .form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    padding: 32px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: 0 6px 18px rgb(0 86 229 / 8%);
    --field-label: var(--color-title);
    --field-label-font: 700 var(--text-small) / var(--text-small-lh) var(--font-display);
    --field-label-transform: uppercase;
  }

  .field {
    display: grid;
    gap: 8px;
  }

  .field label {
    font: var(--field-label-font);
    text-transform: var(--field-label-transform);
    color: var(--field-label);
  }

  .field input,
  .field select {
    width: 100%;
    height: 54px;
    padding: 0 16px;
    font: inherit;
    color: var(--color-navy);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
  }

  .field input::placeholder {
    color: var(--color-muted);
  }

  .form__actions,
  .form__status,
  .form__note,
  .form :global(.form__wide) {
    grid-column: 1 / -1;
  }

  .form__actions {
    display: flex;
  }

  .form__note {
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .plan {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .form {
      grid-template-columns: 1fr;
      padding: 24px 20px;
    }
  }
</style>

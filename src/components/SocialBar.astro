---
import { Image } from 'astro:assets';
import facebook from '../assets/images/social/facebook.png';
import instagram from '../assets/images/social/instagram.png';
import youtube from '../assets/images/social/youtube.png';
import linkedin from '../assets/images/social/linkedin.png';
import { getSiteContent } from '../lib/site-content';

const icons = { facebook, instagram, youtube, linkedin } as const;
// Profile links come from Site details. Before anything is published they are '#' placeholders (Figma
// shows the four icons but no URLs); published, a platform without a link is simply not shown.
const links = (await getSiteContent()).social.flatMap((l) =>
  l.platform in icons
    ? [{ name: l.name, icon: icons[l.platform as keyof typeof icons], href: l.href }]
    : [],
);
---

{links.length > 0 && (
  <section class="social" aria-labelledby="social-title">
    <div class="container social__inner">
      <p class="t-label is-lined">Social media</p>
      <h2 class="t-h2" id="social-title">
        Find us and stay connected
      </h2>
      <ul>
        {links.map((l) => (
          <li>
            <a class="social__card" href={l.href}>
              <Image src={l.icon} alt="" width={44} height={44} densities={[1, 2]} loading="lazy" />
              <span>{l.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  /* Figma: centred eyebrow + serif title, then one white bordered tile per network. */
  .social {
    padding-block: var(--section-pad-y);
    background: var(--color-soft);
  }

  .social__inner {
    display: grid;
    justify-items: center;
    gap: 16px;
    text-align: center;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .social__card {
    display: grid;
    justify-items: center;
    gap: 10px;
    width: 140px;
    padding: 20px 12px 16px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: 0 2px 8px rgb(0 19 169 / 8%);
    font-size: var(--text-small);
    line-height: var(--text-small-lh);
    color: var(--color-title);
    transition: border-color 0.15s;
  }

  .social__card:hover {
    border-color: var(--color-blue);
  }
</style>

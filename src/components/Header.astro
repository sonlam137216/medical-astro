---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { getSiteContent } from '../lib/site-content';
import { pageLink } from '../lib/links';
import { isMenuGroup, type MenuGroup } from '../lib/menu';
import { pagePath } from '../lib/seo';

interface Props {
  /** Pathname of the current page, used to highlight the active link. */
  current?: string;
  /** Second top-bar button. Defaults to the "Dental Knowledge" link from the site menu. */
  utility?: { label: string; href?: string };
  /** First top-bar button. Defaults to "Booking Now" (jumps to the consultation form). */
  cta?: { label: string; href?: string };
  /** The page has its own `#consultation` block (see SiteLayout). */
  consultationHere?: boolean;
}

const site = await getSiteContent();
const {
  current = pagePath(Astro.url.pathname),
  utility = site.utility ?? undefined,
  cta = { label: 'Booking Now', href: '#consultation' },
  consultationHere = true,
} = Astro.props;
const link = (href: string) => pageLink(href, consultationHere);
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
// Links that share a drop-down name in the admin ("Guides") open as a small menu (ported from ui-improvements).
const groupActive = (g: MenuGroup) => g.links.some((l) => isActive(l.href));
---

<div class="topbar">
  <div class="container topbar__inner">
    <p class="topbar__contact">
      {site.phoneDisplay && (
        <a href={`tel:${site.phoneIntl?.replace(/\s/g, '') ?? ''}`}>
          <Icon name="phone" size={16} />
          {site.phoneDisplay}
        </a>
      )}
      {site.email && (
        <a href={`mailto:${site.email}`}>
          <Icon name="mail" size={16} />
          {site.email}
        </a>
      )}
    </p>
    <div class="topbar__actions">
      <a class="topbar__btn" href={link(cta.href ?? '#consultation')}>
        <Icon name="calendar-check" size={16} />
        {cta.label}
      </a>
      {utility && utility.href && (
        <a class="topbar__btn" href={link(utility.href)}>
          {utility.label}
        </a>
      )}
      {utility && !utility.href && <span class="topbar__btn">{utility.label}</span>}
    </div>
  </div>
</div>

<header class="header">
  <div class="nav">
    <div class="container nav__inner">
      <Logo />

      <!-- Small-screen menu is an addition: Figma only has the desktop header -->
      <div class="menu" data-menu>
        <button
          class="menu__toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-menu"
          data-menu-toggle
        >
          <span class="visually-hidden">Menu</span>
          <span class="menu__bars" aria-hidden="true"></span>
        </button>
        <nav id="site-menu" class="menu__panel" aria-label="Main">
          <ul class="menu__list">
            {site.main.map((item, i) =>
              isMenuGroup(item) ? (
                <li class:list={['menu__group', { 'menu__group--link': item.href }]} data-dropdown>
                  {item.href ? (
                    <>
                      <a
                        class:list={[
                          'menu__link',
                          { 'is-active': isActive(item.href) || groupActive(item) },
                        ]}
                        href={pageLink(item.href, consultationHere)}
                        aria-current={current === item.href ? 'page' : undefined}
                      >
                        {item.label}
                      </a>
                      <button
                        class="menu__trigger menu__trigger--icon"
                        type="button"
                        aria-expanded="false"
                        aria-controls={`menu-group-${i}`}
                        data-dropdown-toggle
                      >
                        <span class="visually-hidden">Show the {item.label} menu</span>
                        <Icon name="chevron-down" size={16} class="menu__chevron" />
                      </button>
                    </>
                  ) : (
                    <button
                      class:list={[
                        'menu__link',
                        'menu__trigger',
                        { 'is-active': groupActive(item) },
                      ]}
                      type="button"
                      aria-expanded="false"
                      aria-controls={`menu-group-${i}`}
                      data-dropdown-toggle
                    >
                      {item.label}
                      <Icon name="chevron-down" size={16} class="menu__chevron" />
                    </button>
                  )}
                  <ul class="menu__sub" id={`menu-group-${i}`}>
                    {item.links.map((l) => (
                      <li>
                        <a
                          class:list={['menu__sublink', { 'is-active': isActive(l.href) }]}
                          href={pageLink(l.href, consultationHere)}
                          aria-current={isActive(l.href) ? 'page' : undefined}
                        >
                          {l.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li>
                  <a
                    class:list={['menu__link', { 'is-active': isActive(item.href) }]}
                    href={pageLink(item.href, consultationHere)}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ),
            )}
          </ul>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  // Content and wrapping change the header height across screen sizes and CMS settings.
  const header = document.querySelector<HTMLElement>('header.header');
  if (header) {
    const updateHeaderHeight = () => {
      document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
    };
    updateHeaderHeight();
    new ResizeObserver(updateHeaderHeight).observe(header);
  }

  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  const setOpen = (open: boolean) => {
    menu?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
  };

  toggle?.addEventListener('click', () => setOpen(!menu?.classList.contains('is-open')));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('is-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });
  // Close on a tap outside the menu or on any link in it (a #anchor link keeps the page open).
  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (!menu?.classList.contains('is-open')) return;
    if (!menu.contains(target) || (target as Element).closest?.('a')) setOpen(false);
  });

  // Drop-downs ("Guides"): the button opens and closes its links; Escape, a click elsewhere or moving the focus
  // out closes them. With a mouse they also open on hover (CSS). Without JavaScript they open on hover and focus.
  const dropdowns = [...document.querySelectorAll<HTMLElement>('[data-dropdown]')];
  const setDropdown = (dropdown: HTMLElement, open: boolean) => {
    dropdown.classList.toggle('is-open', open);
    dropdown.querySelector('[data-dropdown-toggle]')?.setAttribute('aria-expanded', String(open));
  };
  for (const dropdown of dropdowns) {
    const button = dropdown.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
    button?.addEventListener('click', () => {
      const open = !dropdown.classList.contains('is-open');
      for (const other of dropdowns) if (other !== dropdown) setDropdown(other, false);
      setDropdown(dropdown, open);
    });
    dropdown.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !dropdown.classList.contains('is-open')) return;
      e.stopPropagation(); // close the drop-down only, not the small-screen menu around it
      setDropdown(dropdown, false);
      button?.focus();
    });
    dropdown.addEventListener('focusout', (e) => {
      if (!dropdown.contains(e.relatedTarget as Node | null)) setDropdown(dropdown, false);
    });
  }
  document.addEventListener('click', (e) => {
    for (const dropdown of dropdowns)
      if (!dropdown.contains(e.target as Node)) setDropdown(dropdown, false);
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-white);
    box-shadow: 0 2px 12px rgb(0 19 169 / 8%);
  }

  /* Top bar: Figma #0056E5, contact on the left, two outlined pill buttons on the right. */
  .topbar {
    background: var(--color-blue);
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: var(--text-small);
    line-height: var(--text-small-lh);
  }

  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    flex-wrap: wrap;
    min-height: var(--utility-bar-h);
    padding-block: 12px;
  }

  .topbar__contact {
    display: grid;
    gap: 4px;
    margin: 0;
  }

  .topbar__contact a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 24px;
  }

  .topbar__contact :global(.icon) {
    opacity: 0.9;
  }

  .topbar__contact a:hover {
    text-decoration: underline;
  }

  .topbar__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .topbar__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 36px;
    padding: 6px 18px;
    color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    box-shadow: 0 2px 6px rgb(0 19 169 / 25%);
    text-align: center;
    white-space: nowrap;
    transition: background-color 0.15s;
  }

  a.topbar__btn:hover {
    background: rgb(255 255 255 / 16%);
  }

  .nav {
    background: var(--color-white);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--nav-h);
    padding-block: 16px;
  }

  .menu {
    display: flex;
    flex: 1;
    justify-content: flex-end;
  }

  .menu__toggle {
    display: none;
    padding: 12px;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .menu__bars,
  .menu__bars::before,
  .menu__bars::after {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-title);
    content: '';
  }

  .menu__bars {
    position: relative;
  }

  .menu__bars::before,
  .menu__bars::after {
    position: absolute;
    left: 0;
  }

  .menu__bars::before {
    top: -7px;
  }

  .menu__bars::after {
    top: 7px;
  }

  .menu__list {
    display: flex;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu__link {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-body);
    line-height: var(--text-body-lh);
    color: var(--color-title);
    white-space: nowrap;
  }

  .menu__link:hover,
  .menu__link.is-active {
    color: var(--color-blue);
  }

  /* Drop-down ("Guides"): a button that looks like the other links, and a small card of links under it. */
  .menu__group {
    position: relative;
  }

  .menu__trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .menu__chevron {
    transition: transform var(--dur-fast, 0.15s);
  }

  /* Services: the name is a link to the Services page, the chevron next to it opens the drop-down. */
  .menu__group--link {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px;
  }

  .menu__trigger--icon {
    justify-content: center;
    min-width: 24px;
    color: var(--color-title);
  }

  .menu__trigger--icon:hover,
  .menu__group--link:has(.is-active) .menu__trigger--icon {
    color: var(--color-blue);
  }

  .menu__group.is-open .menu__chevron {
    transform: rotate(180deg);
  }

  .menu__sub {
    display: none;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu__group.is-open > .menu__sub {
    display: grid;
  }

  .menu__sublink {
    display: block;
    padding: 10px 14px;
    border-radius: var(--radius-control);
    font: 500 var(--text-body) / var(--text-body-lh) var(--font-display);
    color: var(--color-title);
    white-space: nowrap;
  }

  .menu__sublink:hover {
    background: var(--color-soft);
    color: var(--color-blue);
  }

  .menu__sublink.is-active {
    background: var(--color-blue);
    color: var(--color-white);
  }

  @media (min-width: 1025px) {
    .menu__sub {
      position: absolute;
      top: calc(100% + 14px);
      left: 50%;
      translate: -50% 0;
      z-index: 10;
      min-width: 220px;
      padding: 8px;
      background: var(--color-white);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-card);
      box-shadow: 0 16px 36px rgb(0 19 169 / 12%);
    }

    /* Covers the gap between the button and the card, so the pointer can move down without closing it. */
    .menu__sub::before {
      content: '';
      position: absolute;
      inset: -16px 0 auto;
      height: 16px;
    }

    @media (hover: hover) {
      .menu__group:hover > .menu__sub {
        display: grid;
      }

      .menu__group:hover .menu__chevron {
        transform: rotate(180deg);
      }
    }

    :global(html:not(.js)) .menu__group:focus-within > .menu__sub {
      display: grid;
    }

    @media (prefers-reduced-motion: no-preference) {
      .menu__group.is-open > .menu__sub,
      .menu__group:hover > .menu__sub {
        animation: menu-in var(--dur-base) var(--ease-out);
      }
    }
  }

  @media (max-width: 1024px) {
    .menu {
      flex: 0;
      position: relative;
    }

    .menu__toggle {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 0;
    }

    .menu__panel {
      position: absolute;
      right: 0;
      top: 100%;
      width: min(320px, 90vw);
      max-height: calc(100dvh - var(--header-h) - 16px);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 16px;
      background: var(--color-white);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-control);
      z-index: 10;
    }

    .menu__list {
      flex-direction: column;
      gap: 4px;
    }

    .menu__link {
      display: block;
      padding: 10px 4px;
    }

    /* In the panel the drop-down opens in place, its links set in a little. */
    .menu__trigger {
      display: flex;
      justify-content: space-between;
      width: 100%;
      text-align: left;
    }

    .menu__sub {
      padding: 0 0 6px 8px;
    }

    .menu__sublink {
      padding: 10px 4px 10px 12px;
      border-left: 2px solid var(--color-soft);
      border-radius: 0;
    }

    .menu__sublink:hover {
      background: none;
    }

    .menu__sublink.is-active {
      background: none;
      color: var(--color-blue);
      border-left-color: var(--color-blue);
    }

    /* Services in the panel: the link fills the row, the chevron button sits at its end, the links below. */
    .menu__group--link > .menu__link {
      flex: 1;
    }

    .menu__group--link > .menu__trigger--icon {
      justify-content: flex-end;
      width: 44px;
      min-height: 44px;
    }

    .menu__group--link > .menu__sub {
      flex-basis: 100%;
    }

    /* Without JavaScript the panel is always open, and so are its drop-downs. */
    :global(html:not(.js)) .menu__sub {
      display: grid;
    }

    /* With JS the panel is collapsed until toggled; without JS it stays visible */
    :global(.js) .menu__panel {
      display: none;
    }

    :global(.js) .menu.is-open .menu__panel {
      display: block;
    }

    @media (prefers-reduced-motion: no-preference) {
      :global(.js) .menu.is-open .menu__panel {
        animation: menu-in var(--dur-base) var(--ease-out);
      }
    }

    :global(html:not(.js)) .menu__toggle {
      display: none;
    }
  }

  @media (max-width: 768px) {
    /* Do not let a late font swap move the actions from beside the contact details onto a new row. */
    .topbar__inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      row-gap: 12px;
    }

    .topbar__contact {
      font-size: 13px;
    }

    .topbar__contact a {
      display: flex;
      align-items: center;
      min-height: 40px;
    }

    .topbar__btn {
      min-height: 40px;
      padding: 4px 14px;
      font-size: 13px;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

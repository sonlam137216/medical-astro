---
import Logo from './Logo.astro';
import { getSiteContent } from '../lib/site-content';
import { pageLink } from '../lib/links';
import { isMenuGroup, type MenuItem, type MenuGroup } from '../lib/menu';

interface Props {
  /** Pathname of the current page, used to highlight the active link. */
  current?: string;
  /** Extra menu link after the main ones. Defaults to the top-bar link of the site menu, if there is one. */
  utility?: { label: string; href?: string };
  /** The filled button at the right. Defaults to "Get a free plan" (jumps to the consultation form). */
  cta?: { label: string; href?: string };
  /** The page has its own `#consultation` block (see SiteLayout). */
  consultationHere?: boolean;
}

const site = await getSiteContent();
const {
  current = Astro.url.pathname,
  utility = site.utility ?? undefined,
  cta = { label: 'Get a free plan', href: '#consultation' },
  consultationHere = true,
} = Astro.props;
const link = (href: string) => pageLink(href, consultationHere);
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
// UI update (2026-10-12): the blue top bar (phone, email and two outlined buttons) is gone. Phone and email are in
// the footer and the "Visit us" block; the top-bar link joins the menu; the call to action is a filled button here.
// UI update (2026-10-13): links that share a drop-down name in the admin ("Guides") open as a small menu.
const items: MenuItem[] = [
  ...site.main,
  ...(utility?.href ? [{ label: utility.label, href: utility.href }] : []),
];
const groupActive = (g: MenuGroup) => g.links.some((l) => isActive(l.href));
---

<header class="header">
  <div class="header__inner">
    <Logo />

    <!-- Small-screen menu is an addition: Figma only has the desktop header -->
    <div class="menu" data-menu>
      <button
        class="menu__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-toggle
      >
        <span class="visually-hidden">Menu</span>
        <span class="menu__bars" aria-hidden="true"></span>
      </button>
      <nav id="site-menu" class="menu__panel" aria-label="Main">
        <ul class="menu__list">
          {items.map((item, i) =>
            isMenuGroup(item) ? (
              <li class="menu__group" data-dropdown>
                <button
                  class:list={['menu__link', 'menu__trigger', { 'is-active': groupActive(item) }]}
                  type="button"
                  aria-expanded="false"
                  aria-controls={`menu-group-${i}`}
                  data-dropdown-toggle
                >
                  {item.label}
                  <svg
                    class="menu__chevron"
                    width="12"
                    height="12"
                    viewBox="0 0 12 12"
                    aria-hidden="true"
                  >
                    <path
                      d="M2.5 4.5 6 8l3.5-3.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                </button>
                <ul class="menu__sub" id={`menu-group-${i}`}>
                  {item.links.map((l) => (
                    <li>
                      <a
                        class:list={['menu__sublink', { 'is-active': isActive(l.href) }]}
                        href={link(l.href)}
                        aria-current={isActive(l.href) ? 'page' : undefined}
                      >
                        {l.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a
                  class:list={['menu__link', { 'is-active': isActive(item.href) }]}
                  href={link(item.href)}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ),
          )}
        </ul>
      </nav>
    </div>

    <div class="header__actions">
      {site.whatsappUrl && (
        <a class="header__wa" href={site.whatsappUrl} aria-label="Chat on WhatsApp">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"
            ></path>
          </svg>
        </a>
      )}
      <a class="header__cta" href={link(cta.href ?? '#consultation')}>
        {cta.label}
      </a>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  const setOpen = (open: boolean) => {
    menu?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
  };

  toggle?.addEventListener('click', () => setOpen(!menu?.classList.contains('is-open')));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('is-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });
  // Close on a tap outside the menu or on any link in it (a #anchor link keeps the page open).
  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (!menu?.classList.contains('is-open')) return;
    if (!menu.contains(target) || (target as Element).closest?.('a')) setOpen(false);
  });

  // Drop-downs ("Guides"): the button opens and closes its links; Escape, a click elsewhere or moving the focus
  // out closes them. With a mouse they also open on hover (CSS). Without JavaScript they open on hover and focus.
  const dropdowns = [...document.querySelectorAll<HTMLElement>('[data-dropdown]')];
  const setDropdown = (dropdown: HTMLElement, open: boolean) => {
    dropdown.classList.toggle('is-open', open);
    dropdown.querySelector('[data-dropdown-toggle]')?.setAttribute('aria-expanded', String(open));
  };
  for (const dropdown of dropdowns) {
    const button = dropdown.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
    button?.addEventListener('click', () => {
      const open = !dropdown.classList.contains('is-open');
      for (const other of dropdowns) if (other !== dropdown) setDropdown(other, false);
      setDropdown(dropdown, open);
    });
    dropdown.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !dropdown.classList.contains('is-open')) return;
      e.stopPropagation(); // close the drop-down only, not the small-screen menu around it
      setDropdown(dropdown, false);
      button?.focus();
    });
    dropdown.addEventListener('focusout', (e) => {
      if (!dropdown.contains(e.relatedTarget as Node | null)) setDropdown(dropdown, false);
    });
  }
  document.addEventListener('click', (e) => {
    for (const dropdown of dropdowns)
      if (!dropdown.contains(e.target as Node)) setDropdown(dropdown, false);
  });
</script>

<style>
  /* One row that stays at the top while the page scrolls (added: Figma's header scrolls away). */
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-white);
    border-bottom: 1px solid rgb(0 19 169 / 8%);
  }

  /* A soft shadow once the page has scrolled (CSS only; browsers without scroll timelines keep the hairline). */
  @supports (animation-timeline: scroll()) {
    .header {
      animation: header-lift linear both;
      animation-timeline: scroll();
      animation-range: 0 80px;
    }
  }

  @keyframes header-lift {
    to {
      box-shadow: 0 6px 24px rgb(0 19 169 / 8%);
      border-bottom-color: transparent;
    }
  }

  /* Wider than the page container: the menu links and two buttons need the room. */
  .header__inner {
    display: flex;
    align-items: center;
    gap: 28px;
    max-width: 1264px;
    min-height: var(--header-h);
    margin-inline: auto;
    padding-inline: 32px;
  }

  /* At least 44 px of tap area round the logo link, whatever its picture's height. */
  .header__inner :global(.logo) {
    display: flex;
    align-items: center;
    min-height: 44px;
  }

  .header__inner :global(.logo img) {
    width: 168px;
    height: auto;
  }

  .menu {
    display: flex;
    flex: 1;
    justify-content: flex-end;
  }

  .menu__toggle {
    display: none;
    padding: 12px;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .menu__bars,
  .menu__bars::before,
  .menu__bars::after {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-title);
    content: '';
  }

  .menu__bars {
    position: relative;
  }

  .menu__bars::before,
  .menu__bars::after {
    position: absolute;
    left: 0;
  }

  .menu__bars::before {
    top: -7px;
  }

  .menu__bars::after {
    top: 7px;
  }

  .menu__list {
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu__link {
    position: relative;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 15px;
    line-height: 24px;
    color: var(--color-title);
    white-space: nowrap;
  }

  .menu__link:hover,
  .menu__link.is-active {
    color: var(--color-blue);
  }

  /* Drop-down ("Guides"): a button that looks like the other links, and a small card of links under it. */
  .menu__group {
    position: relative;
  }

  .menu__trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .menu__chevron {
    transition: transform var(--dur-fast, 0.15s);
  }

  .menu__group.is-open .menu__chevron {
    transform: rotate(180deg);
  }

  .menu__sub {
    display: none;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu__group.is-open > .menu__sub {
    display: grid;
  }

  .menu__sublink {
    display: block;
    padding: 10px 14px;
    border-radius: var(--radius-control);
    font: 500 15px / 24px var(--font-display);
    color: var(--color-title);
    white-space: nowrap;
  }

  .menu__sublink:hover {
    background: var(--color-soft);
    color: var(--color-blue);
  }

  .menu__sublink.is-active {
    color: var(--color-blue);
  }

  @media (min-width: 1221px) {
    .menu__sub {
      position: absolute;
      top: calc(100% + 14px);
      left: 50%;
      translate: -50% 0;
      z-index: 10;
      min-width: 220px;
      padding: 8px;
      background: var(--color-white);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-card);
      box-shadow: 0 16px 36px rgb(0 19 169 / 12%);
    }

    /* Covers the gap between the button and the card, so the pointer can move down without closing it. */
    .menu__sub::before {
      content: '';
      position: absolute;
      inset: -16px 0 auto;
      height: 16px;
    }

    @media (hover: hover) {
      .menu__group:hover > .menu__sub {
        display: grid;
      }

      .menu__group:hover .menu__chevron {
        transform: rotate(180deg);
      }
    }

    :global(html:not(.js)) .menu__group:focus-within > .menu__sub {
      display: grid;
    }

    @media (prefers-reduced-motion: no-preference) {
      .menu__group.is-open > .menu__sub,
      .menu__group:hover > .menu__sub {
        animation: menu-in var(--dur-base) var(--ease-out);
      }
    }
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .header__wa {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--color-soft);
    color: var(--color-green);
    transition: background-color 0.15s;
  }

  .header__wa:hover {
    box-shadow: inset 0 0 0 1px var(--color-border);
  }

  .header__cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 20px;
    border-radius: 12px;
    background: var(--color-blue);
    color: var(--color-white);
    font: 600 15px / 24px var(--font-display);
    white-space: nowrap;
    transition: background-color 0.15s;
  }

  .header__cta:hover {
    background: var(--color-blue-deep);
  }

  /* Below this width the links do not fit on one row: they move into the menu panel. (With the "Guides" drop-down
     six items would fit down to ~1080px, but a menu without drop-downs still has seven: keep the room for those.) */
  @media (max-width: 1220px) {
    /* Logo, then the buttons, then the menu toggle at the far right. */
    .menu {
      position: relative;
      flex: 0;
      order: 1;
    }

    .header__actions {
      margin-left: auto;
    }

    .menu__toggle {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 0;
    }

    .menu__panel {
      position: absolute;
      right: 0;
      top: calc(100% + 12px);
      width: min(320px, 90vw);
      padding: 16px;
      background: var(--color-white);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-control);
      box-shadow: 0 12px 32px rgb(0 19 169 / 12%);
      z-index: 10;
    }

    .menu__list {
      flex-direction: column;
      gap: 4px;
    }

    .menu__link {
      display: block;
      padding: 10px 4px;
      font-size: var(--text-body);
    }

    /* In the panel the drop-down opens in place, its links set in a little. */
    .menu__trigger {
      display: flex;
      justify-content: space-between;
      width: 100%;
      text-align: left;
    }

    .menu__sub {
      padding: 0 0 6px 12px;
    }

    .menu__sublink {
      padding: 10px 4px 10px 12px;
      border-left: 2px solid var(--color-soft);
      border-radius: 0;
      font-size: var(--text-body);
    }

    .menu__sublink:hover {
      background: none;
    }

    /* Without JavaScript the panel is always open, and so are its drop-downs. */
    :global(html:not(.js)) .menu__sub {
      display: grid;
    }

    /* With JS the panel is collapsed until toggled; without JS it stays visible */
    :global(.js) .menu__panel {
      display: none;
    }

    :global(.js) .menu.is-open .menu__panel {
      display: block;
    }

    @media (prefers-reduced-motion: no-preference) {
      :global(.js) .menu.is-open .menu__panel {
        animation: menu-in var(--dur-base) var(--ease-out);
      }
    }

    :global(html:not(.js)) .menu__toggle {
      display: none;
    }
  }

  /* Phones: the WhatsApp and consultation buttons live in the bar at the bottom of the screen (MobileActionBar). */
  @media (max-width: 768px) {
    .header__inner {
      gap: 12px;
      padding-inline: var(--gutter);
    }

    .header__inner :global(.logo img) {
      width: 150px;
    }

    .header__actions {
      display: none;
    }

    .menu {
      margin-left: auto;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

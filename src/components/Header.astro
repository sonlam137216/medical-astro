---
import Logo from './Logo.astro';
import { getSiteContent } from '../lib/site-content';
import { pageLink } from '../lib/links';

interface Props {
  /** Pathname of the current page, used to highlight the active link. */
  current?: string;
  /** Second top-bar button. Defaults to the "Dental Knowledge" link from the site menu. */
  utility?: { label: string; href?: string };
  /** First top-bar button. Defaults to "Booking Now" (jumps to the consultation form). */
  cta?: { label: string; href?: string };
  /** The page has its own `#consultation` block (see SiteLayout). */
  consultationHere?: boolean;
}

const site = await getSiteContent();
const {
  current = Astro.url.pathname,
  utility = site.utility ?? undefined,
  cta = { label: 'Booking Now', href: '#consultation' },
  consultationHere = true,
} = Astro.props;
const link = (href: string) => pageLink(href, consultationHere);
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="header">
  <div class="topbar">
    <div class="container topbar__inner">
      <p class="topbar__contact">
        {site.phoneDisplay && (
          <a href={`tel:${site.phoneIntl?.replace(/\s/g, '') ?? ''}`}>{site.phoneDisplay}</a>
        )}
        {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
      </p>
      <div class="topbar__actions">
        <a class="topbar__btn" href={link(cta.href ?? '#consultation')}>
          {cta.label}
        </a>
        {utility && utility.href && (
          <a class="topbar__btn" href={link(utility.href)}>
            {utility.label}
          </a>
        )}
        {utility && !utility.href && <span class="topbar__btn">{utility.label}</span>}
      </div>
    </div>
  </div>

  <div class="nav">
    <div class="container nav__inner">
      <Logo />

      <!-- Small-screen menu is an addition: Figma only has the desktop header -->
      <div class="menu" data-menu>
        <button
          class="menu__toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-menu"
          data-menu-toggle
        >
          <span class="visually-hidden">Menu</span>
          <span class="menu__bars" aria-hidden="true"></span>
        </button>
        <nav id="site-menu" class="menu__panel" aria-label="Main">
          <ul class="menu__list">
            {site.main.map((link) => (
              <li>
                <a
                  class:list={['menu__link', { 'is-active': isActive(link.href) }]}
                  href={pageLink(link.href, consultationHere)}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  const setOpen = (open: boolean) => {
    menu?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
  };

  toggle?.addEventListener('click', () => setOpen(!menu?.classList.contains('is-open')));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>

<style>
  /* Top bar: Figma #0056E5, contact on the left, two outlined pill buttons on the right. */
  .topbar {
    background: var(--color-blue);
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: var(--text-small);
    line-height: var(--text-small-lh);
  }

  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    flex-wrap: wrap;
    min-height: var(--utility-bar-h);
    padding-block: 12px;
  }

  .topbar__contact {
    display: grid;
    margin: 0;
  }

  .topbar__contact a:hover {
    text-decoration: underline;
  }

  .topbar__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .topbar__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 6px 18px;
    color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    box-shadow: 0 2px 6px rgb(0 19 169 / 25%);
    text-align: center;
    white-space: nowrap;
    transition: background-color 0.15s;
  }

  a.topbar__btn:hover {
    background: rgb(255 255 255 / 16%);
  }

  .nav {
    background: var(--color-white);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--nav-h);
    padding-block: 16px;
  }

  .menu {
    display: flex;
    flex: 1;
    justify-content: flex-end;
  }

  .menu__toggle {
    display: none;
    padding: 12px;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .menu__bars,
  .menu__bars::before,
  .menu__bars::after {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-title);
    content: '';
  }

  .menu__bars {
    position: relative;
  }

  .menu__bars::before,
  .menu__bars::after {
    position: absolute;
    left: 0;
  }

  .menu__bars::before {
    top: -7px;
  }

  .menu__bars::after {
    top: 7px;
  }

  .menu__list {
    display: flex;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu__link {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-body);
    line-height: var(--text-body-lh);
    color: var(--color-title);
    white-space: nowrap;
  }

  .menu__link:hover,
  .menu__link.is-active {
    color: var(--color-blue);
  }

  @media (max-width: 1024px) {
    .menu {
      flex: 0;
      position: relative;
    }

    .menu__toggle {
      display: block;
    }

    .menu__panel {
      position: absolute;
      right: 0;
      top: 100%;
      width: min(320px, 90vw);
      padding: 16px;
      background: var(--color-white);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-control);
      z-index: 10;
    }

    .menu__list {
      flex-direction: column;
      gap: 4px;
    }

    .menu__link {
      display: block;
      padding: 10px 4px;
    }

    /* With JS the panel is collapsed until toggled; without JS it stays visible */
    :global(.js) .menu__panel {
      display: none;
    }

    :global(.js) .menu.is-open .menu__panel {
      display: block;
    }

    :global(html:not(.js)) .menu__toggle {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .topbar__contact {
      font-size: 12px;
    }

    .topbar__btn {
      min-height: 32px;
      padding: 4px 12px;
      font-size: 12px;
    }
  }
</style>

---
import Button from './Button.astro';
import { Image } from 'astro:assets';
import { getSiteContent } from '../lib/site-content';
import { heroImage } from '../data/home';
import { getSection } from '../lib/content';

const site = await getSiteContent();
const hero = (await getSection('home_hero'))!;
const rating = hero.rating?.trim();
---

<section class="hero" aria-labelledby="hero-title">
  <!-- Figma: one wide photo, copy on the plain left side of it. The picture is the LCP element. -->
  <Image
    class="hero__bg"
    src={heroImage.src}
    alt={heroImage.alt}
    width={2000}
    height={1046}
    widths={[900, 1400, 2000]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="t-label is-lined is-lead">{hero.label}</p>
      <h1 class="t-hero" id="hero-title">
        {hero.title}
      </h1>
      <div class="hero__body">
        {hero.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
      <!-- UI update: a filled consultation button first (Figma has WhatsApp only), WhatsApp beside it. -->
      <div class="hero__actions">
        <Button href="#consultation">Get a free treatment plan</Button>
        {site.whatsappUrl && (
          <Button variant="whatsapp-outline" href={site.whatsappUrl}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"
              ></path>
            </svg>
            WhatsApp us
          </Button>
        )}
        {/* Only when a video is chosen in Site details: it scrolls to the player further down the page. */}
        {site.video && (
          <Button variant="outline" href="#video">
            Watch video
          </Button>
        )}
      </div>
      {(rating || hero.trust) && (
        <div class="hero__proof">
          {rating && (
            <p class="hero__rating">
              <span class="hero__stars" aria-hidden="true">
                ★★★★★
              </span>
              {rating}
            </p>
          )}
          {hero.trust && <p class="hero__trust pre-line">{hero.trust}</p>}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #eaf3fc;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
  }

  .hero__inner {
    display: flex;
    align-items: center;
    min-height: clamp(520px, 40vw, 620px);
    padding-block: 64px;
  }

  .hero__content {
    display: grid;
    gap: 20px;
    max-width: 720px; /* wide enough for the Figma two-line title; the copy below stays narrower */
  }

  .hero__body {
    display: grid;
    gap: 6px;
    max-width: 540px;
    color: var(--color-navy);
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: 29px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 4px;
  }

  .hero__proof {
    display: grid;
    gap: 6px;
    max-width: 600px;
    padding-top: 4px;
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--text-small-lh);
    color: var(--color-muted);
  }

  .hero__rating {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--color-title);
  }

  .hero__stars {
    color: #ffc83d; /* same star colour as the 'Visit us' rating */
    letter-spacing: 2px;
  }

  @media (max-width: 520px) {
    .hero__body {
      font-size: 16px;
      line-height: 26px;
    }

    .hero__actions > :global(*) {
      flex: 1 1 100%;
    }
  }

  @media (max-width: 900px) {
    .hero__bg {
      object-position: 80% center;
    }

    /* On narrow screens the copy covers the picture, so lighten it for legibility. */
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background: rgb(255 255 255 / 82%);
    }

    .hero__inner {
      min-height: 0;
    }
  }
</style>

---
import Button from './Button.astro';
import { Image } from 'astro:assets';
import { getSiteContent } from '../lib/site-content';
import { heroImage } from '../data/home';
import { getSection } from '../lib/content';

const site = await getSiteContent();
const hero = (await getSection('home_hero'))!;
---

<section class="hero" aria-labelledby="hero-title">
  <!-- Figma: one wide photo, copy on the plain left side of it. The picture is the LCP element. -->
  <Image
    class="hero__bg"
    src={heroImage.src}
    alt={heroImage.alt}
    width={2000}
    height={1046}
    widths={[900, 1400, 2000]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="t-label is-lined is-lead">{hero.label}</p>
      <h1 class="t-hero" id="hero-title">
        {hero.title}
      </h1>
      <div class="hero__body">
        {hero.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
      <div class="hero__actions">
        {site.whatsappUrl && (
          <Button variant="whatsapp" href={site.whatsappUrl}>
            WhatsApp us
          </Button>
        )}
        {/* Only when a video is chosen in Site details: it scrolls to the player further down the page. */}
        {site.video && <Button href="#video">Watch video</Button>}
      </div>
      {hero.trust && <p class="hero__trust pre-line">{hero.trust}</p>}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #eaf3fc;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
  }

  .hero__inner {
    display: flex;
    align-items: center;
    min-height: clamp(560px, 46vw, 700px);
    padding-block: 64px;
  }

  .hero__content {
    display: grid;
    gap: 20px;
    max-width: 600px;
  }

  .hero__body {
    display: grid;
    gap: 6px;
    color: var(--color-muted);
    font-size: var(--text-body);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 4px;
  }

  .hero__trust {
    font-size: var(--text-small);
    line-height: var(--text-small-lh);
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .hero__bg {
      object-position: 80% center;
    }

    /* On narrow screens the copy covers the picture, so lighten it for legibility. */
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background: rgb(255 255 255 / 82%);
    }

    .hero__inner {
      min-height: 0;
    }
  }
</style>

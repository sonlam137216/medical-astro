---
import { itemInput, type Field, type FieldErrors, type FormValues } from '../../lib/cms/fields';
import type { FormOptions } from '../../lib/cms/admin';
import MediaPicker from './MediaPicker.astro';

// One input of a content form, drawn from its field definition.
interface Props {
  f: Field;
  values: FormValues;
  errors: FieldErrors;
  options: FormOptions;
}

const { f, values, errors, options } = Astro.props;
const error = errors[f.name];
const text = (name: string) => String(values[name] ?? '');
const invalid = (name: string) => (errors[name] ? 'true' : undefined);
// Slots of an `items` field shown without JavaScript: the filled ones plus two empty ones (at most the field's
// maximum). The others are drawn hidden, for the "Add" button (src/scripts/items-field.ts).
const slotsFor = (f: Extract<Field, { type: 'items' }>) => {
  let last = -1;
  for (let i = 0; i < f.maxItems; i++)
    if (f.columns.some((c) => text(itemInput(f.name, i, c.name)) !== '')) last = i;
  return Math.min(f.maxItems, last + 3);
};
---

{f.type === 'bool' && (
  <label class="admin-check">
    <input type="checkbox" name={f.name} checked={Boolean(values[f.name])} />
    {f.label}
  </label>
)}

{f.type === 'image' && (
  <MediaPicker
    name={f.name}
    label={f.label}
    value={text(f.name)}
    images={options.images}
    slot={f.slot}
    help={f.help}
    error={error}
  />
)}

{f.type === 'items' && (
  <fieldset class="admin-items" data-items={f.name}>
    <legend>{f.label}</legend>
    {f.help && <span class="admin-hint">{f.help}</span>}
    {Array.from({ length: f.maxItems }, (_, i) => (
      <div class="admin-item" data-item hidden={i >= slotsFor(f)}>
        <div class="admin-item__head">
          <p class="admin-item__title">
            {f.itemLabel} <span data-item-number>{i + 1}</span>
          </p>
          <button type="button" class="admin-btn admin-btn--ghost" data-item-remove hidden>
            Remove
          </button>
        </div>
        {f.columns.map((c) => (
          <label>
            {c.label}
            {c.kind === 'text' ? (
              <input
                name={itemInput(f.name, i, c.name)}
                value={text(itemInput(f.name, i, c.name))}
                maxlength={c.max}
              />
            ) : c.kind === 'video' ? (
              <input
                type="url"
                inputmode="url"
                name={itemInput(f.name, i, c.name)}
                value={text(itemInput(f.name, i, c.name))}
                maxlength={c.max}
                placeholder="https://www.youtube.com/watch?v=…"
              />
            ) : c.kind === 'choice' ? (
              <select name={itemInput(f.name, i, c.name)}>
                <option value="">None</option>
                {(c.options ?? []).map((o) => (
                  <option value={o.value} selected={text(itemInput(f.name, i, c.name)) === o.value}>
                    {o.label}
                  </option>
                ))}
              </select>
            ) : (
              <textarea
                name={itemInput(f.name, i, c.name)}
                rows={c.kind === 'lines' ? 4 : 3}
                maxlength={c.kind === 'textarea' ? c.max : undefined}
              >{text(itemInput(f.name, i, c.name))}</textarea>
            )}
            {c.help && <span class="admin-hint">{c.help}</span>}
          </label>
        ))}
      </div>
    ))}
    <button type="button" class="admin-btn admin-btn--ghost admin-items__add" data-item-add hidden>
      + Add {f.itemLabel.toLowerCase()}
    </button>
    <span class="admin-hint" data-items-hint>
      Leave a card empty to leave it out. To add more than are shown, save and come back: two empty
      cards are offered each time (up to {f.maxItems}).
    </span>
    {error && <span class="admin-field-error">{error}</span>}
  </fieldset>
)}

{f.type === 'money' && (
  <label>
    {f.label}
    <span class="admin-money">
      <input
        name={f.name}
        value={text(f.name)}
        inputmode="decimal"
        placeholder="Leave empty if there is no price"
        aria-invalid={invalid(f.name)}
      />
      <input
        name={f.currencyName}
        value={text(f.currencyName)}
        maxlength="3"
        aria-label="Currency"
        placeholder="USD"
      />
    </span>
    {f.help && <span class="admin-hint">{f.help}</span>}
    {error && <span class="admin-field-error">{error}</span>}
  </label>
)}

{f.type === 'textarea' && f.editor && (
  <div
    class="admin-rte"
    data-article-editor
    data-thumbs={JSON.stringify(
      Object.fromEntries(options.images.map((img) => [img.id, img.thumb])),
    )}
  >
    <label class="admin-rte__label" for={`field-${f.name}`}>
      {f.label}
    </label>
    <div class="admin-rte__bar" role="toolbar" aria-label="Text formatting" data-rte-tools hidden>
      <button type="button" data-tool="h2" title="Section heading">
        H2
      </button>
      <button type="button" data-tool="h3" title="Smaller heading">
        H3
      </button>
      <button type="button" data-tool="bold" title="Bold">
        <strong>B</strong>
      </button>
      <button type="button" data-tool="ul" title="Bullet list">
        • List
      </button>
      <button type="button" data-tool="ol" title="Numbered list">
        1. List
      </button>
      <button type="button" data-tool="quote" title="Quote">
        “ Quote
      </button>
      <button type="button" data-tool="link" title="Link">
        Link
      </button>
      {f.editor === 'article' && (
        <button type="button" data-tool="image" title="Picture from Media">
          Picture
        </button>
      )}
      <span class="admin-rte__tabs" role="tablist" aria-label="View">
        <button type="button" role="tab" data-view="write" aria-selected="true">
          Write
        </button>
        <button type="button" role="tab" data-view="preview" aria-selected="false">
          Preview
        </button>
      </span>
    </div>
    <textarea
      id={`field-${f.name}`}
      name={f.name}
      rows={f.rows ?? 20}
      maxlength={f.max}
      aria-invalid={invalid(f.name)}
      data-rte-text
    >{text(f.name)}</textarea>
    <div class="admin-rte__preview article-preview" data-rte-preview hidden></div>
    {f.help && <span class="admin-hint">{f.help}</span>}
    {error && <span class="admin-field-error">{error}</span>}
  </div>
)}

{!(f.type === 'textarea' && f.editor) &&
  f.type !== 'bool' &&
  f.type !== 'image' &&
  f.type !== 'money' &&
  f.type !== 'items' && (
    <label>
      {f.label}
      {(f.type === 'text' ||
        f.type === 'url' ||
        f.type === 'path' ||
        f.type === 'email' ||
        f.type === 'weburl') && (
        <input
          name={f.name}
          value={text(f.name)}
          maxlength={'max' in f ? f.max : 200}
          placeholder={'placeholder' in f ? f.placeholder : undefined}
          required={f.required}
          readonly={f.readonly}
          type={f.type === 'email' ? 'email' : 'text'}
          aria-invalid={invalid(f.name)}
        />
      )}
      {f.type === 'slug' && (
        <input
          name={f.name}
          value={text(f.name)}
          maxlength="100"
          placeholder={f.from ? 'Leave empty to create it from the name' : 'lowercase-with-hyphens'}
          required={f.required}
          aria-invalid={invalid(f.name)}
        />
      )}
      {f.type === 'textarea' && <textarea
        name={f.name}
        rows={f.rows ?? 5}
        maxlength={f.max}
        aria-invalid={invalid(f.name)}
      >{text(f.name)}</textarea>}
      {f.type === 'lines' && <textarea
        name={f.name}
        rows="5"
        aria-invalid={invalid(f.name)}
      >{text(f.name)}</textarea>}
      {f.type === 'int' && (
        <input
          name={f.name}
          type="number"
          min={f.min}
          max={f.max}
          value={text(f.name)}
          aria-invalid={invalid(f.name)}
        />
      )}
      {f.type === 'date' && (
        <input name={f.name} type="date" value={text(f.name)} aria-invalid={invalid(f.name)} />
      )}
      {f.type === 'select' && (
        <select name={f.name} aria-invalid={invalid(f.name)}>
          {f.options.map(([value, label]) => (
            <option value={value} selected={text(f.name) === value}>
              {label}
            </option>
          ))}
        </select>
      )}
      {f.type === 'ref' && (
        <select
          name={f.name}
          aria-invalid={invalid(f.name)}
          data-media-video={f.where?.kind === 'video' ? '' : undefined}
          required={f.required}
        >
          <option value="" selected={text(f.name) === ''} disabled={f.required}>
            {f.required ? 'Choose…' : 'None'}
          </option>
          {(options.refs[f.name] ?? []).map((o) => (
            <option value={o.value} selected={text(f.name) === o.value}>
              {o.label}
            </option>
          ))}
        </select>
      )}
      {f.help && <span class="admin-hint">{f.help}</span>}
      {error && <span class="admin-field-error">{error}</span>}
    </label>
  )}

<script>
  // The article writing tools are loaded only on pages that have them.
  if (document.querySelector('[data-article-editor]')) void import('../../scripts/article-editor');
  if (document.querySelector('select[data-media-video]')) void import('../../scripts/media-fields');
  if (document.querySelector('[data-items]')) void import('../../scripts/items-field');
</script>

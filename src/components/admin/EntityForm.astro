---
import type { EntityDef } from '../../lib/cms/entities';
import type { Field as FieldDef, FieldErrors, FormValues } from '../../lib/cms/fields';
import type { FormOptions } from '../../lib/cms/admin';
import Field from './Field.astro';

// Renders the form of any registered content type from its field list: the text on the left, the settings
// (visibility, order, photo, dates, price...) in a column on the right, and a save bar along the bottom.
interface Props {
  def: Pick<EntityDef, 'fields'>;
  values: FormValues;
  errors?: FieldErrors;
  formError?: string;
  options: FormOptions;
  submitLabel: string;
}

const { def, values, errors = {}, formError, options, submitLabel } = Astro.props;

const SIDE_TYPES = new Set(['bool', 'int', 'select', 'ref', 'date', 'image', 'money', 'slug']);
const main = def.fields.filter((f) => !SIDE_TYPES.has(f.type));
const side = def.fields.filter((f) => SIDE_TYPES.has(f.type));
const photos = side.filter((f) => f.type === 'image');
const settings = side.filter((f) => f.type !== 'image');

// A failed save lists its problems at the top too: a message under a photo in the side column is easy to miss.
const problems = Object.entries(errors).map(([name, message]) => {
  const field = def.fields.find((f) => f.name === name);
  return field ? `${field.label}: ${message}` : message;
});

// A heading is drawn when a field starts a new group.
const rows = main.map((f: FieldDef, i) => ({
  f,
  heading: f.group && f.group !== main[i - 1]?.group ? f.group : null,
}));
---

<form class:list={['admin-editor', { 'admin-editor--single': side.length === 0 }]} method="post">
  {formError && (
    <p class="admin-notice admin-notice--error admin-editor__wide" role="alert">
      {formError}
    </p>
  )}
  {!formError && problems.length > 0 && (
    <div class="admin-notice admin-notice--error admin-editor__wide" role="alert">
      <p>Not saved yet. Please fix:</p>
      <ul>
        {problems.map((p) => (
          <li>{p}</li>
        ))}
      </ul>
    </div>
  )}

  {main.length > 0 && (
    <div class="admin-editor__main admin-card admin-form">
      {rows.map(({ f, heading }) => (
        <>
          {heading && <h2 class="admin-form__group">{heading}</h2>}
          <div class:list={['admin-field', { 'is-half': f.half }]}>
            <Field {f} {values} {errors} {options} />
          </div>
        </>
      ))}
    </div>
  )}

  {side.length > 0 && (
    <aside class="admin-editor__side">
      {settings.length > 0 && (
        <section class="admin-card admin-form">
          <h2 class="admin-panel__title">Settings</h2>
          {settings.map((f) => (
            <Field {f} {values} {errors} {options} />
          ))}
        </section>
      )}
      {photos.map((f) => (
        <section class="admin-card admin-form">
          <Field {f} {values} {errors} {options} />
        </section>
      ))}
    </aside>
  )}

  <div class="admin-form__bar admin-editor__wide">
    <button class="admin-btn" type="submit">
      {submitLabel}
    </button>
    <span class="admin-hint">
      Saving changes the working copy only. Changes appear on the website after you publish.
    </span>
  </div>
</form>

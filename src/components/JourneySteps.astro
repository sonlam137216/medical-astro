---
import Icon from './Icon.astro';
import { isIconName } from '../lib/icons';

// The numbered steps of "How it works" (from "Home: how it works" in the admin): numbers on a dashed line, an
// optional tag ("Online", "In Vietnam") saying where the step happens. `blue` on the blue band of Home, `light`
// under the "Your Seamless Dental Journey" banner of the inner pages (UI update 2026-10-13: that banner had a
// heading and a photo but no steps). A step with an icon (chosen in the admin, 2026-10-16; Figma had emoji
// placeholders) shows it in the circle with the number in a small badge; without one the circle shows the number.
interface Props {
  steps: { title: string; body?: string | null; tag?: string | null; icon?: string | null }[];
  tone?: 'blue' | 'light';
}

const { steps, tone = 'blue' } = Astro.props;
---

<ol class:list={['steps', `steps--${tone}`]}>
  {steps.map((s, i) => (
    <li class="step">
      <span class="step__no" aria-hidden="true">
        {isIconName(s.icon) ? (
          <>
            <Icon name={s.icon} size={24} />
            <span class="step__badge">{String(i + 1).padStart(2, '0')}</span>
          </>
        ) : (
          String(i + 1).padStart(2, '0')
        )}
      </span>
      {s.tag && <span class="step__tag">{s.tag}</span>}
      <h3 class="step__title">
        <span class="visually-hidden">Step {i + 1}: </span>
        {s.title}
      </h3>
      {s.body && <p class="step__body">{s.body}</p>}
    </li>
  ))}
</ol>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 28px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .steps--blue {
    --step-no-bg: var(--color-white);
    --step-no-fg: var(--color-blue);
    --step-ring: rgb(255 255 255 / 14%);
    --step-line: rgb(255 255 255 / 35%);
    --step-tag-bg: rgb(255 255 255 / 16%);
    --step-tag-fg: var(--color-white);
    --step-title: var(--color-white);
    --step-body: rgb(255 255 255 / 85%);
    --step-badge-bg: var(--color-title);
    --step-badge-fg: var(--color-white);
    --step-badge-border: var(--color-white);
  }

  .steps--light {
    --step-no-bg: var(--color-blue);
    --step-no-fg: var(--color-white);
    --step-ring: var(--color-soft);
    --step-line: var(--color-border);
    --step-tag-bg: var(--color-soft);
    --step-tag-fg: var(--color-blue);
    --step-title: var(--color-heading);
    --step-body: var(--color-muted);
    --step-badge-bg: var(--color-white);
    --step-badge-fg: var(--color-blue);
    --step-badge-border: var(--color-blue);
  }

  /* A dashed line from each number to the next one. */
  .step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 24px;
    left: 62px;
    right: -14px;
    border-top: 2px dashed var(--step-line);
  }

  .step {
    position: relative;
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 10px;
  }

  .step__no {
    position: relative;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 6px;
    border-radius: 50%;
    background: var(--step-no-bg);
    box-shadow: 0 0 0 6px var(--step-ring);
    font: 700 16px / 1 var(--font-display);
    color: var(--step-no-fg);
  }

  .step__badge {
    position: absolute;
    top: -6px;
    right: -8px;
    display: grid;
    place-items: center;
    min-width: 28px;
    height: 24px;
    padding: 0 5px;
    border: 2px solid var(--step-badge-border);
    border-radius: 999px;
    background: var(--step-badge-bg);
    font: 700 12px / 1 var(--font-display);
    color: var(--step-badge-fg);
  }

  .step__tag {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--step-tag-bg);
    font: 600 12px / 20px var(--font-sans);
    letter-spacing: 0.02em;
    color: var(--step-tag-fg);
  }

  .step__title {
    font: 600 18px / 26px var(--font-display);
    color: var(--step-title);
  }

  .step__body {
    font-size: var(--text-small);
    line-height: 22px;
    color: var(--step-body);
  }

  /* Two or more rows: a single line across would join steps that are not next to each other. */
  @media (max-width: 1024px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }

    .step:not(:last-child)::after {
      display: none;
    }
  }

  /* Phones: one column, the line runs down past the numbers. */
  @media (max-width: 520px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .step:not(:last-child)::after {
      display: block;
      top: 62px;
      bottom: -18px;
      left: 23px;
      right: auto;
      border-top: 0;
      border-left: 2px dashed var(--step-line);
    }

    .step {
      grid-template-columns: 48px 1fr;
      column-gap: 16px;
      row-gap: 6px;
    }

    .step__no {
      grid-row: span 3;
      margin-bottom: 0;
    }

    .step > :not(.step__no) {
      grid-column: 2;
    }

    .step__tag {
      justify-self: start;
    }
  }
</style>

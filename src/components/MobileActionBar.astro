---
import { getSiteContent } from '../lib/site-content';
import { pageLink } from '../lib/links';

// Added (not in Figma): on phones the two ways to get in touch stay at the bottom of the screen. Most visitors
// abroad read on a phone and message on WhatsApp, and the header buttons are hidden at this width.
interface Props {
  /** The page has its own `#consultation` block (see SiteLayout). */
  consultationHere?: boolean;
}

const { consultationHere = true } = Astro.props;
const site = await getSiteContent();
---

<div class:list={['actionbar', { 'actionbar--single': !site.whatsappUrl }]} data-actionbar>
  {site.whatsappUrl && (
    <a class="actionbar__btn actionbar__btn--wa" href={site.whatsappUrl}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path
          fill="currentColor"
          d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"
        ></path>
      </svg>
      WhatsApp
    </a>
  )}
  <a class="actionbar__btn actionbar__btn--plan" href={pageLink('#consultation', consultationHere)}>
    Get a free plan
  </a>
</div>

<script>
  // Step aside while a consultation form is on screen: the visitor is already where the buttons lead.
  // Without JavaScript (or IntersectionObserver) the bar simply stays.
  const bar = document.querySelector<HTMLElement>('[data-actionbar]');
  const forms = document.querySelectorAll('#consultation, form[data-form="consultation"]');
  if (bar && forms.length > 0 && 'IntersectionObserver' in window) {
    const onScreen = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) onScreen.add(e.target);
        else onScreen.delete(e.target);
      }
      bar.classList.toggle('is-away', onScreen.size > 0);
    });
    forms.forEach((f) => io.observe(f));
  }
</script>

<style>
  .actionbar {
    display: none;
  }

  @media (max-width: 768px) {
    .actionbar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 40;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom, 0px));
      background: var(--color-white);
      border-top: 1px solid rgb(0 19 169 / 8%);
      box-shadow: 0 -8px 24px rgb(0 19 169 / 8%);
      transition:
        translate 0.25s var(--ease-out, ease),
        opacity 0.25s;
    }

    .actionbar--single {
      grid-template-columns: 1fr;
    }

    .actionbar.is-away {
      translate: 0 110%;
      opacity: 0;
      pointer-events: none;
    }

    .actionbar__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 48px;
      padding: 10px 12px;
      border-radius: 12px;
      font: 600 15px / 22px var(--font-display);
      white-space: nowrap;
    }

    .actionbar__btn--wa {
      background: var(--color-green);
      color: var(--color-white);
    }

    .actionbar__btn--plan {
      background: var(--color-blue);
      color: var(--color-white);
    }

    /* Room at the end of the page so the bar never covers the footer's last line. */
    :global(body) {
      padding-bottom: calc(68px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>

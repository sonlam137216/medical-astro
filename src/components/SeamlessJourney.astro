---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import { seamlessJourney as j } from '../data/shared';
---

<Section labelledby="journey-title">
  <!-- Figma: left-aligned eyebrow + serif title sit on the white-faded left of a rounded dental-room photo. -->
  <div class="journey">
    <Image
      class="journey__img"
      src={j.image.src}
      alt={j.image.alt}
      widths={[720, 1040, 1600]}
      sizes="(max-width: 1440px) 100vw, 1040px"
      loading="lazy"
    />
    <div class="journey__text">
      <p class="journey__label">{j.label}</p>
      <h2 class="t-h2" id="journey-title">
        {j.title}
      </h2>
    </div>
  </div>
</Section>

<style>
  .journey {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 340px;
    border-radius: var(--radius-image);
    background: var(--color-white);
  }

  .journey__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 75% center;
  }

  .journey::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      90deg,
      rgb(255 255 255 / 100%) 0%,
      rgb(255 255 255 / 92%) 30%,
      rgb(255 255 255 / 0%) 62%
    );
  }

  .journey__text {
    display: grid;
    align-content: center;
    gap: 12px;
    max-width: 440px;
    min-height: 340px;
    padding: 40px 48px;
  }

  /* Figma: bold blue label with a short rule under it (not beside it). */
  .journey__label {
    display: grid;
    gap: 8px;
    justify-items: start;
    font: 700 var(--text-body) / var(--text-body-lh) var(--font-display);
    color: var(--color-blue);
  }

  .journey__label::after {
    content: '';
    width: 72px;
    height: 1px;
    background: currentcolor;
    opacity: 0.6;
  }

  @media (max-width: 700px) {
    .journey::before {
      background: rgb(255 255 255 / 84%);
    }

    .journey__text {
      padding: 32px 24px;
    }
  }
</style>

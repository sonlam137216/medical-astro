---
import ProfileImage from './ProfileImage.astro';
import Section from './Section.astro';
import JourneySteps from './JourneySteps.astro';

import { getSection } from '../lib/content';

const j = (await getSection('shared_journey'))!;
const picture = j.chosenPhotos.image ?? j.image;
// The steps are the ones of "Home: how it works" (written once in the admin); switched off there, the banner
// stands alone as before.
const how = await getSection('home_how');
const steps = how?.steps ?? [];
---

<Section labelledby="journey-title">
  <!-- Figma: left-aligned eyebrow + serif title sit on the white-faded left of a rounded dental-room photo. -->
  <div class="journey">
    <ProfileImage
      class="journey__img"
      image={picture}
      slot="journey-banner"
      sizes="(max-width: 1440px) 100vw, 1040px"
    />
    <div class="journey__text">
      <p class="journey__label">{j.label}</p>
      <h2 class="t-h2" id="journey-title">
        {j.title}
      </h2>
    </div>
  </div>
  {steps.length > 0 && (
    <div class="journey__steps">
      <JourneySteps steps={steps} tone="light" />
    </div>
  )}
</Section>

<style>
  .journey__steps {
    margin-top: 40px;
    padding-inline: 8px;
  }

  .journey {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 340px;
    border-radius: var(--radius-image);
    background: var(--color-white);
  }

  .journey__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .journey::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      90deg,
      rgb(255 255 255 / 100%) 0%,
      rgb(255 255 255 / 92%) 30%,
      rgb(255 255 255 / 0%) 62%
    );
  }

  .journey__text {
    display: grid;
    align-content: center;
    gap: 12px;
    max-width: 440px;
    min-height: 340px;
    padding: 40px 48px;
  }

  /* Figma: bold blue label with a short rule under it (not beside it). */
  .journey__label {
    display: grid;
    gap: 8px;
    justify-items: start;
    font: 700 var(--text-body) / var(--text-body-lh) var(--font-display);
    color: var(--color-blue);
  }

  .journey__label::after {
    content: '';
    width: 72px;
    height: 1px;
    background: currentcolor;
    opacity: 0.6;
  }

  @media (max-width: 700px) {
    .journey::before {
      background: rgb(255 255 255 / 84%);
    }

    .journey__text {
      padding: 32px 24px;
    }
  }
</style>

---
import type { Block } from '../../lib/cms/articles';
import type { PublicImage } from '../../lib/media';
import ProfileImage from '../ProfileImage.astro';

// Renders the parsed article body. The parser returns data, never HTML, so every piece of text goes through
// Astro's escaping and the only attributes built from the body are the safe link targets it already vetted.
interface Props {
  blocks: Block[];
  /** Pictures placed in the text, by media id. A picture that is not here (deleted) is left out. */
  images?: Record<string, PublicImage>;
}
const { blocks, images = {} } = Astro.props;
const external = (href: string) => /^https?:\/\//i.test(href);
---

<div class="body">
  {blocks.map((b) => {
    if (b.type === 'heading') {
      return b.level === 2 ? <h2 id={b.id}>{b.text}</h2> : <h3 id={b.id}>{b.text}</h3>;
    }
    if (b.type === 'paragraph') {
      return (
        <p>
          {b.children.map((p) =>
            p.href ? (
              <a href={p.href} rel={external(p.href) ? 'noopener noreferrer' : undefined}>
                {p.text}
              </a>
            ) : p.bold ? (
              <strong>{p.text}</strong>
            ) : (
              p.text
            ),
          )}
        </p>
      );
    }
    if (b.type === 'image') {
      const image = images[b.id];
      return image ? (
        <figure>
          <ProfileImage
            image={image}
            width={800}
            height={450}
            sizes="(max-width: 960px) 100vw, 680px"
          />
          {b.caption && <figcaption>{b.caption}</figcaption>}
        </figure>
      ) : null;
    }
    if (b.type === 'quote') {
      return (
        <blockquote>
          {b.children.map((p) =>
            p.href ? (
              <a href={p.href} rel={external(p.href) ? 'noopener noreferrer' : undefined}>
                {p.text}
              </a>
            ) : p.bold ? (
              <strong>{p.text}</strong>
            ) : (
              p.text
            ),
          )}
        </blockquote>
      );
    }
    const Tag = b.ordered ? 'ol' : 'ul';
    return (
      <Tag>
        {b.items.map((item) => (
          <li>
            {item.map((p) =>
              p.href ? (
                <a href={p.href} rel={external(p.href) ? 'noopener noreferrer' : undefined}>
                  {p.text}
                </a>
              ) : p.bold ? (
                <strong>{p.text}</strong>
              ) : (
                p.text
              ),
            )}
          </li>
        ))}
      </Tag>
    );
  })}
</div>

<style>
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 30px;
    color: var(--color-navy);
    overflow-wrap: anywhere;
  }

  .body :global(h2) {
    margin-top: 28px;
    font: 600 26px / 34px var(--font-display);
    color: var(--color-heading);
    text-wrap: balance;
    scroll-margin-top: calc(var(--header-h) + 16px);
  }

  .body :global(h3) {
    margin-top: 12px;
    font: 600 20px / 28px var(--font-display);
    color: var(--color-title);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }

  .body :global(ul),
  .body :global(ol) {
    display: grid;
    gap: 10px;
    margin: 0;
    padding-left: 26px;
  }

  .body :global(li::marker) {
    font-weight: 700;
    color: var(--color-blue);
  }

  .body :global(blockquote) {
    margin: 8px 0;
    padding: 20px 26px;
    border-left: 4px solid var(--color-blue);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
    background: var(--color-card);
    font: 500 19px / 30px var(--font-display);
    color: var(--color-heading);
  }

  .body :global(figure) {
    display: grid;
    gap: 10px;
    margin: 12px 0;
  }

  .body :global(figure img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
  }

  .body :global(figcaption) {
    font-size: 13px;
    line-height: 20px;
    text-align: center;
    color: var(--color-muted);
  }

  .body :global(a) {
    color: var(--color-blue);
    text-decoration: underline;
    text-decoration-color: rgb(0 86 229 / 35%);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.15s;
  }

  .body :global(a:hover) {
    text-decoration-color: currentcolor;
  }

  @media (max-width: 768px) {
    .body {
      font-size: 16px;
      line-height: 28px;
    }

    .body :global(h2) {
      font-size: 28px;
      line-height: 34px;
    }

    .body :global(blockquote) {
      padding: 16px 20px;
      font-size: 19px;
      line-height: 28px;
    }
  }
</style>

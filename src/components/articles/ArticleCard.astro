---
import type { PublicArticle } from '../../lib/content';
import ProfileImage from '../ProfileImage.astro';
import { formatArticleDateShort } from '../../lib/cms/articles';

// Card of the article lists (like a WordPress archive card: cover, category and date, title, summary). The whole
// card is one link (the title link is stretched over it), so the picture is clickable without a second link for
// keyboard and screen-reader users. An article without a cover gets a plain tile of the same shape, so the grid
// stays even. UI update (2026-10-13, direction A): no frame around the card, no "Read article" line and no
// reading time; on phones a card is a row (text, then a small square picture) so a list scrolls much less.
interface Props {
  article: PublicArticle;
  /** The big card at the top of the first page: picture beside the text. */
  featured?: boolean;
  /** A small row with the picture first and no summary ("Keep reading"). */
  compact?: boolean;
}

const { article, featured = false, compact = false } = Astro.props;
const date = formatArticleDateShort(article.publishedOn);
const kindLabel = article.kind === 'travel_guide' ? 'Travel guide' : 'Dental knowledge';
---

<article
  class:list={[
    'card',
    'article',
    { 'article--featured': featured, 'article--compact': compact, 'article--card': !compact },
  ]}
>
  <div class="article__media">
    {article.cover ? (
      <ProfileImage
        class="card__media article__img"
        image={article.cover}
        slot="article-cover"
        sizes={
          featured
            ? '(max-width: 768px) 100vw, 600px'
            : compact
              ? '96px'
              : '(max-width: 600px) 96px, (max-width: 960px) 50vw, 340px'
        }
        priority={featured}
      />
    ) : (
      <div class="card__media article__img article__img--empty" aria-hidden="true">
        <span>{kindLabel}</span>
      </div>
    )}
  </div>
  <div class="card__body">
    {(article.category || date) && (
      <p class="article__meta">
        {article.category && <span class="article__category">{article.category.name}</span>}
        {date && !compact && <time datetime={article.publishedOn ?? undefined}>{date}</time>}
      </p>
    )}
    <h3 class="article__title">
      <a href={article.path}>{article.title}</a>
    </h3>
    {!compact && article.excerpt && <p class="article__excerpt">{article.excerpt}</p>}
  </div>
</article>

<style>
  /* No frame: the picture carries the card (overrides the shared .card shell and its hover lift). */
  .article {
    position: relative;
    height: 100%;
    overflow: visible;
    background: transparent;
    border: 0;
    border-radius: 0;
  }

  .article:hover {
    transform: none;
    box-shadow: none;
  }

  .article__media {
    overflow: hidden;
    border-radius: var(--radius-card);
    aspect-ratio: 3 / 2;
    background: var(--color-soft);
  }

  .article__media > :global(*) {
    width: 100%;
    height: 100%;
  }

  .card__body {
    flex: 1;
    align-content: start;
    gap: 8px;
    padding: 18px 0 0;
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 10px;
    font: 500 12px / 18px var(--font-display);
    letter-spacing: 0.02em;
    color: var(--color-muted);
  }

  .article__meta > :not(:first-child)::before {
    content: '';
    display: inline-block;
    width: 3px;
    height: 3px;
    margin-right: 10px;
    vertical-align: middle;
    border-radius: 50%;
    background: currentcolor;
    opacity: 0.6;
  }

  .article__category {
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-blue);
  }

  .article__title {
    font: 600 20px / 28px var(--font-display);
    color: var(--color-heading);
    text-wrap: balance;
    transition: color 0.15s;
  }

  /* The link covers the whole card. */
  .article__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .article__title a:focus-visible {
    outline: none;
  }

  .article:has(.article__title a:focus-visible) {
    outline: 2px solid var(--color-blue);
    outline-offset: 4px;
    border-radius: var(--radius-card);
  }

  .article:hover .article__title {
    color: var(--color-blue);
  }

  .article__excerpt {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    font-size: var(--text-small);
    line-height: var(--text-small-lh);
    color: var(--color-muted);
  }

  .article__img--empty {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 20% 15%, rgb(255 255 255 / 70%), transparent 55%),
      linear-gradient(135deg, #dce9fc, #bcd3f7);
  }

  .article__img--empty span {
    font: 700 12px / 18px var(--font-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
    color: var(--color-title);
    opacity: 0.55;
  }

  /* Small row: square picture, then category and title ("Keep reading"). */
  .article--compact {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 16px;
    align-items: center;
  }

  .article--compact .article__media {
    aspect-ratio: 1;
    border-radius: 12px;
  }

  .article--compact .card__body {
    gap: 4px;
    padding: 0;
  }

  .article--compact .article__title {
    font-size: 16px;
    line-height: 23px;
  }

  .article--compact .article__img--empty span,
  .article--card:not(.article--featured) .article__img--empty span {
    font-size: 10px;
    line-height: 14px;
  }

  /* Featured: picture on the left, a larger title (first page of the unfiltered list only). */
  @media (min-width: 769px) {
    .article--featured {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: 40px;
      align-items: center;
    }

    .article--featured .article__media {
      aspect-ratio: 16 / 10;
      border-radius: var(--radius-image);
    }

    .article--featured .card__body {
      gap: 14px;
      padding: 0;
    }

    .article--featured .article__title {
      font-size: 32px;
      line-height: 40px;
    }

    .article--featured .article__excerpt {
      -webkit-line-clamp: 4;
      line-clamp: 4;
      font-size: var(--text-body);
      line-height: var(--text-body-lh);
    }
  }

  /* Phones: list cards become rows (text first, small square picture on the right). */
  @media (max-width: 600px) {
    .article--card:not(.article--featured) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 96px;
      gap: 16px;
      align-items: start;
      padding-block: 16px;
      border-bottom: 1px solid var(--color-soft);
    }

    .article--card:not(.article--featured) .article__media {
      grid-column: 2;
      grid-row: 1;
      aspect-ratio: 1;
      border-radius: 12px;
    }

    .article--card:not(.article--featured) .card__body {
      grid-column: 1;
      grid-row: 1;
      gap: 6px;
      padding: 0;
    }

    .article--card:not(.article--featured) .article__title {
      font-size: 16px;
      line-height: 23px;
    }

    .article--card:not(.article--featured) .article__excerpt {
      display: none;
    }

    .article--featured .article__media {
      aspect-ratio: 16 / 10;
    }

    .article--featured .article__title {
      font-size: 22px;
      line-height: 30px;
    }
  }
</style>

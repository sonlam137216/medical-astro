---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Section from '../Section.astro';
import ProfileImage from '../ProfileImage.astro';
import ArticleBody from './ArticleBody.astro';
import SidebarConsultation from '../SidebarConsultation.astro';
import {
  ARTICLE_BASE_PATH,
  formatArticleDate,
  parseArticleBody,
  tableOfContents,
} from '../../lib/cms/articles';
import type { PublicArticle } from '../../lib/content';
import { getServiceLinks } from '../../lib/site-content';

// One article (Figma "Single Post"): breadcrumb, title, update line, table of contents, body, reviewer card,
// related articles, and a sidebar with the services and a consultation form.
interface Props {
  article: PublicArticle;
  all: PublicArticle[];
}

const { article, all } = Astro.props;
const serviceLinks = await getServiceLinks();
const blocks = parseArticleBody(article.body);
const toc = tableOfContents(blocks);
const listLabel = article.kind === 'travel_guide' ? 'Dental Travel Guide' : 'Dental Knowledge';
const updated = formatArticleDate(article.updatedOn ?? article.publishedOn);
const reviewed = formatArticleDate(article.reviewedOn);

// Same category first, then the newest. The list is already newest first.
const related = all
  .filter((a) => a.slug !== article.slug)
  .sort(
    (a, b) =>
      Number(b.category?.slug === article.category?.slug && b.category !== null) -
      Number(a.category?.slug === article.category?.slug && a.category !== null),
  )
  .slice(0, 4);

const title = article.seoTitle || `${article.title} · Melatec Dental Clinic`;
const description = article.seoDescription || article.excerpt || undefined;
---

<SiteLayout {title} {description} consultation={false} consultationAnchor social={false}>
  <Section labelledby="article-title">
    <div class="layout">
      <article class="main">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li>
              <a href="/">Home</a>
            </li>
            <li>
              <a href={ARTICLE_BASE_PATH[article.kind]}>{listLabel}</a>
            </li>
            <li aria-current="page">{article.title}</li>
          </ol>
        </nav>

        <header class="head">
          <h1 class="title" id="article-title">
            {article.title}
          </h1>
          <p class="meta">
            {updated && <span>Updated: {updated}</span>}
            {article.author && <span>Written by: {article.author}</span>}
          </p>
        </header>

        {article.excerpt && <p class="lead">{article.excerpt}</p>}

        {article.cover && (
          <ProfileImage
            class="cover"
            image={article.cover}
            width={800}
            height={450}
            sizes="(max-width: 960px) 100vw, 680px"
            priority
          />
        )}

        {toc.length > 1 && (
          <details class="toc">
            <summary>Table of contents</summary>
            <ol>
              {toc.map((t) => (
                <li>
                  <a href={`#${t.id}`}>{t.text}</a>
                </li>
              ))}
            </ol>
          </details>
        )}

        <ArticleBody blocks={blocks} />

        {article.reviewedBy && (
          <div class="review">
            <p class="review__by">Clinically reviewed by: {article.reviewedBy}</p>
            {reviewed && <p class="review__date">Reviewed on {reviewed}</p>}
            <a class="link-arrow" href="/our-doctors">
              View all doctors <span aria-hidden="true">→</span>
            </a>
          </div>
        )}

        {related.length > 0 && (
          <section class="related" aria-labelledby="related-title">
            <h2 id="related-title">Related articles</h2>
            <ul>
              {related.map((r) => (
                <li>
                  <a href={r.path}>
                    {r.cover ? (
                      <ProfileImage
                        class="related__img"
                        image={r.cover}
                        width={240}
                        height={160}
                        sizes="(max-width: 600px) 45vw, 160px"
                      />
                    ) : (
                      <span class="related__img related__img--empty" aria-hidden="true" />
                    )}
                    <span class="related__title">{r.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </article>

      <div class="side">
        <section class="services card" aria-labelledby="services-title">
          <h2 id="services-title">Our services</h2>
          <ul>
            {serviceLinks.slice(0, 4).map((s) => (
              <li>
                <a class="link-arrow" href={s.href}>
                  {s.label} <span aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
        <SidebarConsultation />
      </div>
    </div>
  </Section>
</SiteLayout>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 48px;
    align-items: start;
  }

  .main {
    display: grid;
    gap: 24px;
    min-width: 0;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-small);
    line-height: var(--text-small-lh);
    color: var(--color-muted);
  }

  .crumbs li + li::before {
    content: '›';
    margin-right: 6px;
  }

  .crumbs a {
    color: var(--color-title);
  }

  .crumbs li[aria-current] {
    overflow-wrap: anywhere;
  }

  .head {
    display: grid;
    gap: 10px;
  }

  .title {
    font: 700 var(--text-h2) / var(--text-h2-lh) var(--font-serif);
    color: var(--color-heading);
    overflow-wrap: anywhere;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    font-size: var(--text-small);
    line-height: var(--text-small-lh);
    color: var(--color-muted);
  }

  .lead {
    font-size: 18px;
    line-height: 28px;
    color: var(--color-navy);
  }

  .main :global(.cover) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-card);
  }

  .toc {
    justify-self: start;
    max-width: 100%;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
  }

  .toc summary {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 20px;
    cursor: pointer;
    list-style: none;
    font: 700 13px / 20px var(--font-display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-title);
  }

  .toc summary::-webkit-details-marker {
    display: none;
  }

  .toc summary::after {
    content: '+';
    font-size: 18px;
    color: var(--color-blue);
  }

  .toc[open] summary::after {
    content: '–';
  }

  .toc ol {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 4px 20px 16px 40px;
    font-size: var(--text-small);
    line-height: var(--text-small-lh);
  }

  .toc a {
    color: var(--color-blue);
  }

  .review {
    display: grid;
    gap: 4px;
    padding: 16px 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-card);
  }

  .review__by {
    font: 700 13px / 20px var(--font-display);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-title);
  }

  .review__date {
    font-size: var(--text-small);
    color: var(--color-muted);
  }

  .review .link-arrow {
    margin-top: 6px;
  }

  .related h2 {
    margin-bottom: 14px;
    font: 700 13px / 20px var(--font-display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-title);
  }

  .related ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related a {
    display: grid;
    gap: 8px;
  }

  .related :global(.related__img),
  .related__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 12px;
  }

  .related__img--empty {
    background: var(--color-soft);
    border: 1px solid var(--color-border);
  }

  .related__title {
    font: 600 var(--text-small) / var(--text-small-lh) var(--font-display);
    color: var(--color-title);
  }

  .related a:hover .related__title {
    color: var(--color-blue);
  }

  .side {
    position: sticky;
    top: 24px;
    display: grid;
    gap: 24px;
  }

  .services {
    gap: 12px;
    padding: 24px;
    background: var(--color-white);
  }

  .services h2 {
    font: 700 24px / 30px var(--font-serif);
    color: var(--color-heading);
  }

  .services ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .side {
      position: static;
    }
  }
</style>

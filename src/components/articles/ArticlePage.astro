---
import Icon from '../Icon.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Section from '../Section.astro';
import ProfileImage from '../ProfileImage.astro';
import ArticleBody from './ArticleBody.astro';
import ArticleCard from './ArticleCard.astro';
import ArticleToc from './ArticleToc.astro';
import Button from '../Button.astro';
import {
  ARTICLE_BASE_PATH,
  categoryBasePath,
  formatArticleDate,
  parseArticleBody,
  tocOutline,
} from '../../lib/cms/articles';
import type { PublicArticle } from '../../lib/content';
import { getSiteContent } from '../../lib/site-content';
import {
  absoluteUrl,
  articleJsonLd,
  breadcrumbJsonLd,
  largestImageUrl,
  pageUrl,
} from '../../lib/seo';
import logo from '../../assets/images/brand/logo.png';

// One article (Figma "Single Post", laid out like a WordPress post): breadcrumb, category, title, summary
// (always there: a published article must have one), author and date line with share links, cover (only when
// one was chosen), body, reviewer card, related articles. UI update (2026-10-13, direction A, a deliberate change
// from Figma's sidebar with the services and a form): on wide screens the side column holds the table of
// contents (it stays in view and marks the section being read) and a short call to action; the consultation form
// is the shared block after the article. Below 960px the table of contents sits in the text, as before.
// Later the same day: the breadcrumb, title, summary, author line and cover moved into a top band in the light
// look of the other page heroes (text left, cover right), so article pages match the rest of the site.
interface Props {
  article: PublicArticle;
  /** Chosen by the route (relatedArticles): same category first, then the same kind, then the other kind. */
  related: PublicArticle[];
}

const { article, related } = Astro.props;
const blocks = parseArticleBody(article.body);
const toc = tocOutline(blocks);
const listLabel = article.kind === 'travel_guide' ? 'Dental Travel Guide' : 'Dental Knowledge';
const updated = formatArticleDate(article.updatedOn ?? article.publishedOn);
const reviewed = formatArticleDate(article.reviewedOn);

const title = article.seoTitle || `${article.title} · Melatec Dental Clinic`;
const description = article.seoDescription || article.excerpt || undefined;

// Structured data (only written on an indexable build, see BaseLayout): the article and its breadcrumb trail.
const site = Astro.site;
const siteContent = await getSiteContent();
const at = (path: string) => pageUrl(site, path);
// Link previews and structured data use the widest file of the cover (the smallest is too small for a large preview).
const coverPath = article.cover ? largestImageUrl(article.cover) : undefined;
const coverUrl = coverPath ? absoluteUrl(site, coverPath) : undefined;
// Share on WhatsApp: a plain link (no third-party script). The script below swaps in the address of the page as
// it is opened, so it also works on staging, where there is no public address at build time.
const shareText = [article.title, at(article.path)].filter(Boolean).join(' ');
const whatsappShare = `https://wa.me/?text=${encodeURIComponent(shareText)}`;
const jsonLd = site
  ? [
      articleJsonLd({
        url: at(article.path)!,
        title: article.title,
        description,
        image: coverUrl,
        author: article.author,
        publishedOn: article.publishedOn,
        updatedOn: article.updatedOn,
        reviewedBy: article.reviewedBy,
        reviewedOn: article.reviewedOn,
        publisher: { name: siteContent.name, url: at('/')!, logo: absoluteUrl(site, logo.src) },
      }),
      breadcrumbJsonLd([
        { name: 'Home', url: at('/') },
        { name: listLabel, url: at(ARTICLE_BASE_PATH[article.kind]) },
        ...(article.category
          ? [
              {
                name: article.category.name,
                url: at(categoryBasePath(article.kind, article.category.slug)),
              },
            ]
          : []),
        { name: article.title },
      ]),
    ]
  : [];
---

<SiteLayout {title} {description} {jsonLd} image={coverPath} ogType="article" social={false}>
  <div class="progress" aria-hidden="true"></div>
  <article aria-labelledby="article-title">
    <!-- Top band in the light look of the other page heroes (PageHero): text on the left, cover on the right. -->
    <header class:list={['top', { 'top--cover': article.cover }]}>
      <div class="container top__inner">
        <div class="top__text">
          <nav class="crumbs" aria-label="Breadcrumb">
            <ol>
              <li>
                <a href="/">Home</a>
              </li>
              <li>
                <a href={ARTICLE_BASE_PATH[article.kind]}>{listLabel}</a>
              </li>
              {article.category && (
                <li>
                  <a href={categoryBasePath(article.kind, article.category.slug)}>
                    {article.category.name}
                  </a>
                </li>
              )}
              <li aria-current="page">{article.title}</li>
            </ol>
          </nav>
          <p class="t-label is-lined is-lead eyebrow">
            {article.category ? (
              <a href={categoryBasePath(article.kind, article.category.slug)}>
                {article.category.name}
              </a>
            ) : (
              <a href={ARTICLE_BASE_PATH[article.kind]}>{listLabel}</a>
            )}
          </p>
          <h1 class="title" id="article-title">
            {article.title}
          </h1>
          {article.excerpt && <p class="lead">{article.excerpt}</p>}
          <div class="meta">
            <p class="meta__info">
              {article.author && (
                <span class="meta__avatar" aria-hidden="true">
                  {article.author.trim().charAt(0).toUpperCase()}
                </span>
              )}
              <span class="meta__text">
                {article.author && <span class="meta__author">{article.author}</span>}
                {updated && <span class="meta__date">Updated {updated}</span>}
              </span>
            </p>
            <div class="share" data-share>
              <button type="button" class="share__btn" data-copy-link data-needs-js>
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"></path>
                  <path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"></path>
                </svg>
                <span data-copy-label>Copy link</span>
              </button>
              <a
                class="share__btn"
                href={whatsappShare}
                data-share-whatsapp
                rel="noopener"
                target="_blank"
              >
                <Icon name="brand-whatsapp" size={16} />
                Share on WhatsApp
              </a>
            </div>
          </div>
        </div>
        {article.cover && (
          <figure class="cover-wrap">
            <ProfileImage
              class="cover"
              image={article.cover}
              slot="article-cover"
              sizes="(max-width: 960px) 100vw, 440px"
              priority
            />
          </figure>
        )}
      </div>
    </header>

    <Section class="post-band">
      <div class="layout">
        <div class="main">
          {toc.length > 1 && (
            <div class="toc-inline">
              <ArticleToc items={toc} />
            </div>
          )}

          <ArticleBody blocks={blocks} images={article.bodyImages} />

          {article.reviewedBy && (
            <aside class="review">
              <span class="review__icon" aria-hidden="true">
                <Icon name="shield-check" size={18} />
              </span>
              <div class="review__text">
                <p class="review__by">Clinically reviewed by {article.reviewedBy}</p>
                {reviewed && <p class="review__date">Reviewed on {reviewed}</p>}
                <a class="link-arrow" href="/our-doctors">
                  Meet our doctors{' '}
                  <span aria-hidden="true">
                    <Icon name="arrow-right" size={14} />
                  </span>
                </a>
              </div>
            </aside>
          )}

          <a class="back" href={ARTICLE_BASE_PATH[article.kind]}>
            <Icon name="arrow-left" size={16} /> All articles in {listLabel}
          </a>
        </div>

        <div class="side">
          {toc.length > 1 && <ArticleToc items={toc} variant="rail" />}
          <div class="cta">
            <p class="cta__title">Planning treatment in Vietnam?</p>
            <p class="cta__text">
              Tell us what you need and our team will prepare a free treatment plan.
            </p>
            <Button href="#consultation">Get a free plan</Button>
            {siteContent.whatsappUrl && (
              <Button variant="whatsapp-outline" href={siteContent.whatsappUrl}>
                <Icon name="brand-whatsapp" />
                WhatsApp us
              </Button>
            )}
          </div>
        </div>
      </div>

      {related.length > 0 && (
        <section class="related" aria-labelledby="related-title">
          <h2 id="related-title">Keep reading</h2>
          <ul>
            {related.map((r) => (
              <li>
                <ArticleCard article={r} compact />
              </li>
            ))}
          </ul>
        </section>
      )}
    </Section>
  </article>
</SiteLayout>

<script>
  // Share links: the address of the page as it is opened (staging has no public address at build time).
  const share = document.querySelector<HTMLElement>('[data-share]');
  const whatsapp = share?.querySelector<HTMLAnchorElement>('[data-share-whatsapp]');
  const copy = share?.querySelector<HTMLButtonElement>('[data-copy-link]');
  const label = copy?.querySelector<HTMLElement>('[data-copy-label]');
  const url = location.origin + location.pathname;
  if (whatsapp) {
    const title = document.querySelector('h1')?.textContent?.trim() ?? document.title;
    whatsapp.href = `https://wa.me/?text=${encodeURIComponent(`${title} ${url}`)}`;
  }
  if (copy && label) {
    let timer: number | undefined;
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        label.textContent = 'Link copied';
      } catch {
        label.textContent = 'Could not copy';
      }
      clearTimeout(timer);
      timer = window.setTimeout(() => (label.textContent = 'Copy link'), 2000);
    });
  }
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 56px;
    align-items: start;
  }

  .main {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    min-width: 0;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    line-height: 20px;
    color: var(--color-muted);
  }

  .crumbs li + li::before {
    content: '›';
    margin-right: 6px;
  }

  .crumbs a {
    color: var(--color-muted);
  }

  .crumbs a:hover {
    color: var(--color-blue);
  }

  .crumbs li[aria-current] {
    /* The page title is right below: keep the trail short. */
    max-width: 240px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Top band: the light look of the page heroes (PageHero: white to soft blue), text left, cover right. */
  .top {
    background: linear-gradient(90deg, var(--color-white) 0%, var(--color-soft) 100%);
  }

  .top__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 32px 56px;
    padding-block: 48px 56px;
  }

  .top--cover .top__inner {
    grid-template-columns: minmax(0, 1fr) minmax(0, 440px);
  }

  .top__text {
    display: grid;
    gap: 16px;
    justify-items: start;
    min-width: 0;
    max-width: 760px;
  }

  .eyebrow a {
    color: inherit;
  }

  .eyebrow a:hover {
    color: var(--color-blue-deep);
  }

  .title {
    font: 700 clamp(30px, 3.4vw, 42px) / 1.18 var(--font-display);
    letter-spacing: -0.015em;
    color: var(--color-title);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  :global(section.band.post-band) {
    padding-top: 48px;
  }

  .lead {
    font: 400 19px / 30px var(--font-display);
    color: var(--color-muted);
  }

  .meta {
    justify-self: stretch;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding: 14px 0;
    border-block: 1px solid var(--color-border);
  }

  .meta__info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .meta__avatar {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-blue);
    font: 700 16px / 1 var(--font-display);
    color: var(--color-white);
  }

  .meta__text {
    display: grid;
    font-size: var(--text-small);
    line-height: 20px;
    color: var(--color-muted);
  }

  .meta__author {
    font: 600 15px / 22px var(--font-display);
    color: var(--color-navy);
  }

  .share {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .share__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 16px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-white);
    font: 500 13px / 1 var(--font-display);
    color: var(--color-title);
    cursor: pointer;
    transition:
      border-color 0.15s,
      color 0.15s;
  }

  .share__btn:hover {
    border-color: var(--color-blue);
    color: var(--color-blue);
  }

  .cover-wrap {
    margin: 0;
  }

  .top :global(.cover) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-image);
    box-shadow: 0 18px 40px rgb(0 19 169 / 10%);
  }

  .review {
    display: flex;
    gap: 16px;
    padding: 20px 24px;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-blue);
    border-radius: var(--radius-card);
    background: var(--color-card);
  }

  .review__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-blue);
    font-size: 16px;
    color: var(--color-white);
  }

  .review__text {
    display: grid;
    gap: 2px;
  }

  .review__by {
    font: 700 15px / 24px var(--font-display);
    color: var(--color-title);
  }

  .review__date {
    font-size: var(--text-small);
    color: var(--color-muted);
  }

  .review .link-arrow {
    margin-top: 6px;
  }

  .back {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font: 600 var(--text-small) / var(--text-small-lh) var(--font-display);
    color: var(--color-blue);
  }

  .back:hover {
    color: var(--color-blue-deep);
  }

  .related {
    display: grid;
    gap: 24px;
    margin-top: 64px;
    padding-top: 40px;
    border-top: 1px solid var(--color-border);
  }

  .related h2 {
    font: 600 26px / 34px var(--font-display);
    color: var(--color-heading);
  }

  .related ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Side column (wide screens): table of contents and a short call to action, in view while the article
     scrolls. Its top clears the sticky header; a long table of contents scrolls inside the column. */
  .side {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: grid;
    gap: 28px;
    max-height: calc(100vh - var(--header-h) - 48px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  .cta {
    display: grid;
    gap: 12px;
    padding: 22px;
    border-radius: var(--radius-card);
    background: var(--color-soft);
  }

  .cta__title {
    font: 700 18px / 26px var(--font-display);
    color: var(--color-title);
    text-wrap: balance;
  }

  .cta__text {
    font-size: var(--text-small);
    line-height: var(--text-small-lh);
    color: var(--color-muted);
  }

  .cta :global(.btn) {
    width: 100%;
  }

  /* Reading progress: a thin bar under the top of the window, driven by the page scroll. Only where the browser
     supports scroll-driven animations and motion is welcome; elsewhere it is simply not there. */
  .progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .progress {
        display: block;
        position: fixed;
        inset: 0 0 auto;
        z-index: 60;
        height: 3px;
        background: var(--color-blue);
        transform-origin: left;
        animation: progress linear both;
        animation-timeline: scroll(root block);
      }

      @keyframes progress {
        from {
          transform: scaleX(0);
        }

        to {
          transform: scaleX(1);
        }
      }
    }
  }

  @media (min-width: 961px) {
    .toc-inline {
      display: none;
    }
  }

  @media (max-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .top--cover .top__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Narrower screens: the table of contents is in the text, the form is below the article and the phone
       action bar is at the bottom of the screen, so the side column is not needed. */
    .side {
      display: none;
    }

    .related ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .top__inner {
      gap: 24px;
      padding-block: 28px 32px;
    }

    /* Touch target for the category link, without adding space around the label. */
    .eyebrow a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      margin-block: -10px;
    }

    :global(section.band.post-band) {
      padding-top: 32px;
    }
  }

  @media (max-width: 600px) {
    .related ul {
      grid-template-columns: minmax(0, 1fr);
    }

    .lead {
      font-size: 17px;
      line-height: 28px;
    }
  }
</style>

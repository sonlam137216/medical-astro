---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Section from '../Section.astro';
import ProfileImage from '../ProfileImage.astro';
import ArticleBody from './ArticleBody.astro';
import ArticleCard from './ArticleCard.astro';
import ArticleToc from './ArticleToc.astro';
import SidebarConsultation from '../SidebarConsultation.astro';
import {
  ARTICLE_BASE_PATH,
  categoryBasePath,
  formatArticleDate,
  parseArticleBody,
  readingMinutes,
  tocOutline,
} from '../../lib/cms/articles';
import type { PublicArticle } from '../../lib/content';
import { getServiceLinks, getSiteContent } from '../../lib/site-content';
import { absoluteUrl, articleJsonLd, breadcrumbJsonLd, pageUrl } from '../../lib/seo';
import logo from '../../assets/images/brand/logo.png';

// One article (Figma "Single Post", laid out like a WordPress post): breadcrumb, category, title, summary
// (always there: a published article must have one), author and date line, cover (only when one was chosen),
// table of contents, body, reviewer card, related articles, and a sidebar with the services and a consultation form.
interface Props {
  article: PublicArticle;
  /** Chosen by the route (relatedArticles): same category first, then the same kind, then the other kind. */
  related: PublicArticle[];
}

const { article, related } = Astro.props;
const serviceLinks = await getServiceLinks();
const blocks = parseArticleBody(article.body);
const toc = tocOutline(blocks);
const minutes = readingMinutes(blocks);
const listLabel = article.kind === 'travel_guide' ? 'Dental Travel Guide' : 'Dental Knowledge';
const updated = formatArticleDate(article.updatedOn ?? article.publishedOn);
const reviewed = formatArticleDate(article.reviewedOn);

const title = article.seoTitle || `${article.title} · Melatec Dental Clinic`;
const description = article.seoDescription || article.excerpt || undefined;

// Structured data (only written on an indexable build, see BaseLayout): the article and its breadcrumb trail.
const site = Astro.site;
const siteContent = await getSiteContent();
const at = (path: string) => pageUrl(site, path);
const coverUrl = article.cover ? absoluteUrl(site, article.cover.url) : undefined;
const jsonLd = site
  ? [
      articleJsonLd({
        url: at(article.path)!,
        title: article.title,
        description,
        image: coverUrl,
        author: article.author,
        publishedOn: article.publishedOn,
        updatedOn: article.updatedOn,
        reviewedBy: article.reviewedBy,
        reviewedOn: article.reviewedOn,
        publisher: { name: siteContent.name, url: at('/')!, logo: absoluteUrl(site, logo.src) },
      }),
      breadcrumbJsonLd([
        { name: 'Home', url: at('/') },
        { name: listLabel, url: at(ARTICLE_BASE_PATH[article.kind]) },
        ...(article.category
          ? [
              {
                name: article.category.name,
                url: at(categoryBasePath(article.kind, article.category.slug)),
              },
            ]
          : []),
        { name: article.title },
      ]),
    ]
  : [];
---

<SiteLayout
  {title}
  {description}
  {jsonLd}
  image={article.cover?.url}
  ogType="article"
  consultation={false}
  consultationAnchor
  social={false}
>
  <div class="progress" aria-hidden="true"></div>
  <Section labelledby="article-title">
    <div class="layout">
      <article class="main">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li>
              <a href="/">Home</a>
            </li>
            <li>
              <a href={ARTICLE_BASE_PATH[article.kind]}>{listLabel}</a>
            </li>
            {article.category && (
              <li>
                <a href={categoryBasePath(article.kind, article.category.slug)}>
                  {article.category.name}
                </a>
              </li>
            )}
            <li aria-current="page">{article.title}</li>
          </ol>
        </nav>

        <header class="head">
          {article.category && (
            <a class="eyebrow" href={categoryBasePath(article.kind, article.category.slug)}>
              {article.category.name}
            </a>
          )}
          <h1 class="title" id="article-title">
            {article.title}
          </h1>
          {article.excerpt && <p class="lead">{article.excerpt}</p>}
          <p class="meta">
            {article.author && (
              <span class="meta__author">
                <span class="meta__avatar" aria-hidden="true">
                  {article.author.trim().charAt(0).toUpperCase()}
                </span>
                <span>
                  <span class="meta__label">Written by</span>
                  {article.author}
                </span>
              </span>
            )}
            {updated && (
              <span>
                <span class="meta__label">Updated</span>
                {updated}
              </span>
            )}
            <span>
              <span class="meta__label">Reading time</span>
              {minutes} min
            </span>
          </p>
        </header>

        {article.cover && (
          <figure class="cover-wrap">
            <ProfileImage
              class="cover"
              image={article.cover}
              slot="article-cover"
              sizes="(max-width: 960px) 100vw, 692px"
              priority
            />
          </figure>
        )}

        {toc.length > 1 && <ArticleToc items={toc} />}

        <ArticleBody blocks={blocks} images={article.bodyImages} />

        {article.reviewedBy && (
          <aside class="review">
            <span class="review__icon" aria-hidden="true">
              ✓
            </span>
            <div class="review__text">
              <p class="review__by">Clinically reviewed by {article.reviewedBy}</p>
              {reviewed && <p class="review__date">Reviewed on {reviewed}</p>}
              <a class="link-arrow" href="/our-doctors">
                Meet our doctors <span aria-hidden="true">→</span>
              </a>
            </div>
          </aside>
        )}

        <a class="back" href={ARTICLE_BASE_PATH[article.kind]}>
          <span aria-hidden="true">←</span> All articles in {listLabel}
        </a>

        {related.length > 0 && (
          <section class="related" aria-labelledby="related-title">
            <h2 id="related-title">Keep reading</h2>
            <ul>
              {related.map((r) => (
                <li>
                  <ArticleCard article={r} compact />
                </li>
              ))}
            </ul>
          </section>
        )}
      </article>

      <div class="side">
        <section class="services card" aria-labelledby="services-title">
          <h2 id="services-title">Our services</h2>
          <ul>
            {serviceLinks.slice(0, 4).map((s) => (
              <li>
                <a class="link-arrow" href={s.href}>
                  {s.label} <span aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
        <SidebarConsultation />
      </div>
    </div>
  </Section>
</SiteLayout>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 56px;
    align-items: start;
  }

  .main {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    min-width: 0;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    line-height: 20px;
    color: var(--color-muted);
  }

  .crumbs li + li::before {
    content: '›';
    margin-right: 6px;
  }

  .crumbs a {
    color: var(--color-muted);
  }

  .crumbs a:hover {
    color: var(--color-blue);
  }

  .crumbs li[aria-current] {
    /* The page title is right below: keep the trail short. */
    max-width: 240px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .head {
    display: grid;
    gap: 16px;
  }

  .eyebrow {
    justify-self: start;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--color-soft);
    font: 700 12px / 18px var(--font-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-blue);
  }

  .eyebrow:hover {
    background: var(--color-blue);
    color: var(--color-white);
  }

  .title {
    font: 700 var(--text-h2) / 1.15 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--color-heading);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .lead {
    font: 400 19px / 30px var(--font-sans);
    color: var(--color-muted);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    padding: 16px 0;
    border-block: 1px solid var(--color-border);
    font: 500 14px / 20px var(--font-display);
    color: var(--color-navy);
  }

  .meta > span {
    display: grid;
  }

  .meta__author {
    grid-auto-flow: column;
    align-items: center;
    gap: 12px;
  }

  .meta__avatar {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-blue);
    font: 700 16px / 1 var(--font-display);
    color: var(--color-white);
  }

  .meta__label {
    display: block;
    font: 500 12px / 16px var(--font-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cover-wrap {
    margin: 0;
  }

  .main :global(.cover) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-image);
    box-shadow: 0 18px 40px rgb(0 19 169 / 10%);
  }

  .review {
    display: flex;
    gap: 16px;
    padding: 20px 24px;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-blue);
    border-radius: var(--radius-card);
    background: var(--color-card);
  }

  .review__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-blue);
    font-size: 16px;
    color: var(--color-white);
  }

  .review__text {
    display: grid;
    gap: 2px;
  }

  .review__by {
    font: 700 15px / 24px var(--font-display);
    color: var(--color-title);
  }

  .review__date {
    font-size: var(--text-small);
    color: var(--color-muted);
  }

  .review .link-arrow {
    margin-top: 6px;
  }

  .back {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font: 600 var(--text-small) / var(--text-small-lh) var(--font-display);
    color: var(--color-blue);
  }

  .back:hover {
    color: var(--color-blue-deep);
  }

  .related {
    display: grid;
    gap: 20px;
    margin-top: 16px;
    padding-top: 40px;
    border-top: 1px solid var(--color-border);
  }

  .related h2 {
    font: 600 26px / 34px var(--font-display);
    color: var(--color-heading);
  }

  .related ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related li {
    display: flex;
  }

  .related li > :global(*) {
    flex: 1;
  }

  .side {
    position: sticky;
    top: 24px;
    display: grid;
    gap: 24px;
  }

  .services {
    gap: 12px;
    padding: 24px;
    background: var(--color-white);
  }

  .services h2 {
    font: 600 20px / 28px var(--font-display);
    color: var(--color-heading);
  }

  .services ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Reading progress: a thin bar under the top of the window, driven by the page scroll. Only where the browser
     supports scroll-driven animations and motion is welcome; elsewhere it is simply not there. */
  .progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .progress {
        display: block;
        position: fixed;
        inset: 0 0 auto;
        z-index: 60;
        height: 3px;
        background: var(--color-blue);
        transform-origin: left;
        animation: progress linear both;
        animation-timeline: scroll(root block);
      }

      @keyframes progress {
        from {
          transform: scaleX(0);
        }

        to {
          transform: scaleX(1);
        }
      }
    }
  }

  @media (max-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    .side {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .eyebrow {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding-inline: 16px;
    }
  }

  @media (max-width: 600px) {
    .related ul {
      grid-template-columns: minmax(0, 1fr);
    }

    .lead {
      font-size: 17px;
      line-height: 28px;
    }
  }
</style>

---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../PageHero.astro';
import Section from '../Section.astro';
import Button from '../Button.astro';
import ArticleCard from './ArticleCard.astro';
import { towerImage } from '../../data/shared';
import type { PublicArticle } from '../../lib/content';

// Shared by /travel-guide and /dental-knowledge (Figma: navy hero with a search box, optional category chips,
// a 3-column grid of cards). Search and chips are added by a few lines of JavaScript; without it every article shows.
interface Props {
  title: string;
  description?: string;
  label: string;
  heading: string;
  intro: string;
  articles: PublicArticle[];
  categories: { slug: string; name: string }[];
  current?: string;
}

const { title, description, label, heading, intro, articles, categories, current } = Astro.props;
const usedCategories = categories.filter((c) => articles.some((a) => a.category?.slug === c.slug));
---

<SiteLayout {title} {description} {current} consultation={false} social={false}>
  <PageHero variant="banner" dark {label} image={towerImage} imageHeight={340}>
    <Fragment slot="title">{heading}</Fragment>
    <p>{intro}</p>
    <form slot="actions" class="search" role="search" data-article-form data-needs-js>
      <label class="visually-hidden" for="article-search">
        Search articles
      </label>
      <input
        id="article-search"
        type="search"
        placeholder="Search articles"
        autocomplete="off"
        maxlength="100"
        data-article-search
      />
    </form>
  </PageHero>

  <Section tone="soft" labelledby="articles-title">
    <h2 class="visually-hidden" id="articles-title">
      Articles
    </h2>
    <div data-article-index class="index">
      {usedCategories.length > 0 && (
        <div class="chips" role="group" aria-label="Filter by category" data-needs-js>
          <button type="button" class="chip" data-chip="" aria-pressed="true">
            All articles
          </button>
          {usedCategories.map((c) => (
            <button type="button" class="chip" data-chip={c.slug} aria-pressed="false">
              {c.name}
            </button>
          ))}
        </div>
      )}
      <p class="visually-hidden" role="status" aria-live="polite" data-count></p>

      {articles.length > 0 ? (
        <ul class="grid">
          {articles.map((a) => (
            <li>
              <ArticleCard article={a} />
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty">
          <h3 class="t-h2">Articles are on their way</h3>
          <p>
            We are preparing our first articles. In the meantime, our team is happy to answer your
            questions.
          </p>
          <!-- These pages have no form of their own: go to the one on the Home page. -->
          <Button href="/#consultation">Ask the team</Button>
        </div>
      )}

      <p class="no-match" data-no-match hidden>
        No articles match your search. Try a different word or choose another category.
      </p>
    </div>
  </Section>
</SiteLayout>

<script>
  import '../../scripts/article-filter';
</script>

<style>
  /* Hidden until JavaScript is available, so nobody sees controls that do nothing. */
  :global(html:not(.js)) [data-needs-js] {
    display: none;
  }

  .search input {
    width: min(340px, 100%);
    height: 48px;
    padding: 0 20px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: var(--color-white);
    font: 400 var(--text-body) / var(--text-body-lh) var(--font-sans);
    color: var(--color-navy);
  }

  .search input::placeholder {
    color: var(--color-muted);
  }

  .index {
    display: grid;
    gap: 32px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .chip {
    padding: 10px 24px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background: var(--color-white);
    font: 500 var(--text-small) / var(--text-small-lh) var(--font-display);
    color: var(--color-title);
    cursor: pointer;
    transition:
      background-color 0.15s,
      color 0.15s;
  }

  .chip:hover {
    border-color: var(--color-blue);
  }

  .chip[aria-pressed='true'] {
    background: var(--color-blue);
    border-color: var(--color-blue);
    color: var(--color-white);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid li {
    display: flex;
  }

  .grid li[hidden] {
    display: none;
  }

  .grid li > :global(*) {
    flex: 1;
  }

  .empty,
  .no-match {
    display: grid;
    justify-items: center;
    gap: 16px;
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
  }

  .no-match[hidden] {
    display: none;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

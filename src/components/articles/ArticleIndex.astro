---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../PageHero.astro';
import Section from '../Section.astro';
import Button from '../Button.astro';
import ArticleCard from './ArticleCard.astro';
import Pagination from './Pagination.astro';
import { heroImage } from '../../data/home';
import { listPagePath } from '../../lib/cms/articles';
import type { PublicArticle } from '../../lib/content';

// Shared by the Travel Guide and Dental Knowledge lists, their category pages and their later pages (Figma: navy
// hero with a search box, category chips, a 3-column grid of cards). Everything but the search is plain links to
// pages built at build time, so it works without JavaScript. The search loads a small index (`search.json`) the
// first time someone types, because one page only holds some of the articles.
interface Props {
  title: string;
  description?: string;
  label: string;
  heading: string;
  intro: string;
  /** The articles of this page only. */
  articles: PublicArticle[];
  /** Categories that have articles, as filters. */
  categories: { slug: string; name: string; path: string }[];
  /** Slug of the category page being shown; none: the whole list. */
  activeCategory?: string | null;
  /** Address of page 1 of this list (pagination links are built from it). */
  listPath: string;
  /** Address of the whole list of this kind (the "All articles" chip). */
  rootPath: string;
  page: number;
  totalPages: number;
  /** Number of articles of the kind: 0 shows the "on their way" message. */
  kindTotal: number;
  searchUrl: string;
  current?: string;
}

const {
  title,
  description,
  label,
  heading,
  intro,
  articles,
  categories,
  activeCategory = null,
  listPath,
  rootPath,
  page,
  totalPages,
  kindTotal,
  searchUrl,
  current,
} = Astro.props;

// Like a WordPress blog's newest post: on the first page of the whole list the first article is shown big,
// when there are enough of them for the rest to still fill a grid.
const featured = page === 1 && activeCategory === null && articles.length >= 4 ? articles[0] : null;
const rest = featured ? articles.slice(1) : articles;
---

<SiteLayout {title} {description} {current} consultation={false} social={false}>
  {page > 1 && <link slot="head" rel="prev" href={listPagePath(listPath, page - 1)} />}
  {page < totalPages && <link slot="head" rel="next" href={listPagePath(listPath, page + 1)} />}

  <PageHero variant="banner" {label} image={heroImage} imageHeight={340} position="75% center">
    <Fragment slot="title">{heading}</Fragment>
    <p>{intro}</p>
    <form
      slot="actions"
      class="search"
      role="search"
      data-article-form
      data-needs-js
      data-search-url={searchUrl}
    >
      <label class="visually-hidden" for="article-search">
        Search articles
      </label>
      <input
        id="article-search"
        type="search"
        placeholder="Search articles"
        autocomplete="off"
        maxlength="100"
        data-article-search
      />
    </form>
  </PageHero>

  <Section tone="soft" labelledby="articles-title">
    <h2 class="visually-hidden" id="articles-title">
      Articles
    </h2>
    <div data-article-index class="index">
      <div data-search-results hidden>
        <p class="results__status" role="status" aria-live="polite" data-search-status></p>
        <ul class="results" data-search-list></ul>
      </div>

      <div class="browse" data-browse>
        {categories.length > 0 && (
          <nav class="chips" aria-label="Filter by category">
            <a
              class="chip"
              href={rootPath}
              aria-current={activeCategory === null ? 'page' : undefined}
            >
              All articles
            </a>
            {categories.map((c) => (
              <a
                class="chip"
                href={c.path}
                aria-current={activeCategory === c.slug ? 'page' : undefined}
              >
                {c.name}
              </a>
            ))}
          </nav>
        )}

        {featured && <ArticleCard article={featured} featured />}

        {rest.length > 0 ? (
          <ul class="grid">
            {rest.map((a) => (
              <li>
                <ArticleCard article={a} />
              </li>
            ))}
          </ul>
        ) : (
          articles.length === 0 &&
          kindTotal === 0 && (
            <div class="empty">
              <h3 class="t-h2">Articles are on their way</h3>
              <p>
                We are preparing our first articles. In the meantime, our team is happy to answer
                your questions.
              </p>
              <!-- These pages have no form of their own: go to the one on the Home page. -->
              <Button href="/#consultation">Ask the team</Button>
            </div>
          )
        )}

        <Pagination base={listPath} {page} {totalPages} />
      </div>
    </div>
  </Section>
</SiteLayout>

<script>
  import '../../scripts/article-filter';
</script>

<style>
  /* Hidden until JavaScript is available, so nobody sees controls that do nothing. */
  :global(html:not(.js)) [data-needs-js] {
    display: none;
  }

  .search input {
    width: min(340px, 100%);
    height: 48px;
    padding: 0 20px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-white);
    font: 400 var(--text-body) / var(--text-body-lh) var(--font-sans);
    color: var(--color-navy);
  }

  .search input::placeholder {
    color: var(--color-muted);
  }

  .index {
    display: grid;
    gap: 32px;
  }

  .browse {
    display: grid;
    gap: 32px;
  }

  .browse[hidden] {
    display: none;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .chip {
    padding: 8px 22px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background: var(--color-white);
    font: 500 var(--text-small) / var(--text-small-lh) var(--font-display);
    color: var(--color-title);
    cursor: pointer;
    transition:
      background-color 0.15s,
      color 0.15s;
  }

  .chip:hover {
    border-color: var(--color-blue);
  }

  .chip[aria-current='page'] {
    background: var(--color-blue);
    border-color: var(--color-blue);
    color: var(--color-white);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid li {
    display: flex;
  }

  .grid li[hidden] {
    display: none;
  }

  .grid li > :global(*) {
    flex: 1;
  }

  .empty {
    display: grid;
    justify-items: center;
    gap: 16px;
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
  }

  /* Search results: built by article-filter.ts, so the rules reach its elements through :global. */
  .results__status {
    margin-bottom: 20px;
    text-align: center;
    color: var(--color-navy);
  }

  .results {
    display: grid;
    gap: 16px;
    max-width: 760px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .results :global(li) {
    display: grid;
    gap: 6px;
    padding: 20px 24px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }

  .results :global(.result__category) {
    font: 700 12px / 18px var(--font-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-blue);
  }

  .results :global(.result__title) {
    font: 700 22px / 28px var(--font-serif);
    color: var(--color-title);
  }

  .results :global(.result__title:hover) {
    color: var(--color-blue);
  }

  .results :global(.result__excerpt) {
    font-size: var(--text-small);
    line-height: var(--text-small-lh);
    color: var(--color-navy);
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

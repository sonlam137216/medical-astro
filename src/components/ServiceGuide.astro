---
import Section from './Section.astro';
import Icon from './Icon.astro';
import ArticleBody from './articles/ArticleBody.astro';
import { getSection, type PublicGuide } from '../lib/content';
import { parseArticleBody } from '../lib/cms/articles';

// The round arrow button under the FAQ of the service pages (Figma "General Service Template"): it opens the guide of
// the service (Services, "Guide under the FAQ": an article-like text with headings, lists and pictures) in place.
// A <details> element, so it works without JavaScript and the text is in the HTML for search engines. Self-added:
// the words under the arrow (Page text "Service pages: guide under the FAQ"), since an arrow alone does not say what
// it opens, and the "Close the guide" button at the end of a long text. Nothing is shown when the service has no
// guide or the section is switched off.
interface Props {
  guide: PublicGuide | null;
  /** Wrap in a section of its own (when the page has no FAQ block to sit in). */
  standalone?: boolean;
}

const { guide, standalone = false } = Astro.props;
const section = await getSection('service_articles');
const blocks = section && guide ? parseArticleBody(guide.body) : [];
const Wrap = standalone ? Section : Fragment;
const wrapProps = standalone ? { tone: 'soft' as const } : {};
---

{section && guide && blocks.length > 0 && (
  <Wrap {...wrapProps}>
    <details class="more" data-guide>
      <summary>
        <span class="more__arrow" aria-hidden="true">
          <Icon name="arrow-down" size={28} />
        </span>
        <span class="more__label">{section.button}</span>
      </summary>
      <article class="more__panel">
        <ArticleBody {blocks} images={guide.images} />
        <button type="button" class="more__close" data-guide-close data-needs-js>
          <Icon name="arrow-up" size={18} />
          Close the guide
        </button>
      </article>
    </details>
  </Wrap>
)}

<script>
  // "Close the guide" at the end of the text: closes it and brings the button back into view.
  for (const close of document.querySelectorAll<HTMLButtonElement>('[data-guide-close]')) {
    close.addEventListener('click', () => {
      const details = close.closest('details');
      if (!details) return;
      details.open = false;
      const summary = details.querySelector('summary');
      summary?.scrollIntoView({ block: 'center' });
      summary?.focus({ preventScroll: true });
    });
  }
</script>

<style>
  .more {
    margin-top: 32px;
  }

  .more summary {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: fit-content;
    margin-inline: auto;
    cursor: pointer;
    list-style: none;
    font: 600 var(--text-small) / var(--text-small-lh) var(--font-display);
    color: var(--color-blue-deep);
  }

  .more summary::-webkit-details-marker {
    display: none;
  }

  /* Figma: a light blue circle with a blue arrow. */
  .more__arrow {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-border);
    color: var(--color-blue);
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out),
      rotate var(--dur-base) var(--ease-out);
  }

  .more[open] .more__arrow {
    rotate: 180deg;
  }

  .more summary:hover .more__arrow,
  .more summary:focus-visible .more__arrow {
    background: var(--color-blue);
    color: var(--color-white);
  }

  .more summary:focus-visible {
    outline: none;
  }

  .more summary:focus-visible .more__arrow {
    outline: 2px solid var(--color-blue);
    outline-offset: 3px;
  }

  /* The guide reads like an article page: one column of comfortable width on a white card. */
  .more__panel {
    display: grid;
    gap: 28px;
    max-width: 820px;
    margin: 32px auto 0;
    padding: 48px 56px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: 0 12px 32px rgb(2 15 50 / 6%);
  }

  /* The first heading of the text sits at the top of the card. */
  .more__panel :global(.body > :first-child) {
    margin-top: 0;
  }

  .more__close {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-self: center;
    min-height: 44px;
    padding: 0 20px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-white);
    color: var(--color-blue);
    font: 600 var(--text-small) / 1 var(--font-display);
    cursor: pointer;
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  .more__close:hover {
    background: var(--color-blue);
    border-color: var(--color-blue);
    color: var(--color-white);
  }

  @media (max-width: 768px) {
    .more__panel {
      padding: 28px 20px;
    }
  }
</style>

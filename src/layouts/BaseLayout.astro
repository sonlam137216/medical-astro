---
import '@fontsource-variable/inter/wght.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/cormorant-garamond/vietnamese-600.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Keep true until the site is ready to be indexed (skeleton / staging / preview). */
  noindex?: boolean;
  /** Origin of the media CDN, when pictures come from one: the browser connects to it early. */
  mediaOrigin?: string | null;
}

const { title, description, noindex = false, mediaOrigin = null } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    {mediaOrigin && <link rel="preconnect" href={mediaOrigin} />}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <slot />
  </body>
</html>

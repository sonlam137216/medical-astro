---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsultationSection from '../components/ConsultationSection.astro';
import SocialBar from '../components/SocialBar.astro';
import ContactDock from '../components/ContactDock.astro';
import { getMediaOrigin } from '../lib/content';
import { SITE_INDEXABLE, pagePath } from '../lib/seo';
import { getPageMeta, getSiteVerificationMeta } from '../lib/site-content';
import { META_PIXEL_ID, META_PIXEL_SCRIPT } from '../../integrations/inline-scripts.mjs';

interface Props {
  title: string;
  description?: string;
  /** Show the shared "Book a consultation" block above the footer (all Figma pages have it). */
  consultation?: boolean;
  /**
   * The page has a `#consultation` block of its own (default: the shared block shown by `consultation`). When it
   * has none, the "Booking Now" and "Contact" links go to the Home page's form instead of doing nothing.
   */
  consultationAnchor?: boolean;
  /** Keep this page out of search engines whatever Pages (SEO) says (the 404 page). */
  noindex?: boolean;
  /** Show the "Stay Connected" social row above the footer. */
  social?: boolean;
  /**
   * `sans` (default) = the look of every page in the current Figma file (Montserrat headings, bright blue
   * consultation block and footer); `serif` = the older inner-page look (Cormorant headings, navy bands).
   */
  theme?: 'serif' | 'sans';
  /** Link preview picture (path or address); absent: the default share picture. */
  image?: string;
  ogType?: 'website' | 'article';
  /** schema.org data for the page (src/lib/seo.ts). */
  jsonLd?: Record<string, unknown>[];
  /** Pathname used to highlight the active nav link (defaults to the request path). */
  current?: string;
  /** Header variations seen in Figma: the Dental Implants landing page swaps the utility text and CTA. */
  header?: {
    utility?: { label: string; href?: string };
    cta?: { label: string; href?: string };
  };
}

const {
  title,
  description,
  consultation = true,
  consultationAnchor = consultation,
  social = true,
  noindex = false,
  current,
  header,
  theme = 'sans',
  image,
  ogType,
  jsonLd,
} = Astro.props;

// Per-page settings from Pages (SEO): hidden from search engines, and the picture for link previews.
const path = pagePath(Astro.url.pathname);
const meta = await getPageMeta(path);
// Google Search Console / Bing check the Home page for their tag (BaseLayout writes it on indexable builds only).
const verification = path === '/' ? await getSiteVerificationMeta() : [];
---

<!-- Pages are indexable only on a build made with SITE_INDEXABLE=true and a SITE_URL (integrations/build-env.mjs). -->
<BaseLayout
  title={title}
  description={description}
  noindex={noindex || !SITE_INDEXABLE || meta.noindex}
  mediaOrigin={getMediaOrigin()}
  image={image ?? meta.shareImage ?? undefined}
  {ogType}
  {jsonLd}
  {verification}
>
  <Fragment slot="head">
    <script is:inline set:html={META_PIXEL_SCRIPT}></script>
    <slot name="head" />
  </Fragment>
  <noscript>
    <img
      height="1"
      width="1"
      style="display:none"
      src={`https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1`}
      alt=""
    />
  </noscript>
  <a class="skip-link visually-hidden" href="#main">
    Skip to content
  </a>
  <Header
    current={current ?? path}
    utility={header?.utility}
    cta={header?.cta}
    consultationHere={consultationAnchor}
  />
  <main id="main" class:list={{ 'theme-sans': theme === 'sans' }}>
    <slot />
  </main>
  {consultation && <ConsultationSection bright={theme === 'sans'} />}
  <slot name="after-consultation" />
  {social && <SocialBar sans={theme === 'sans'} />}
  {Astro.slots.has('after-social') && (
    <div class:list={{ 'theme-sans': theme === 'sans' }}>
      <slot name="after-social" />
    </div>
  )}
  <Footer consultationHere={consultationAnchor} />
  <ContactDock />
</BaseLayout>
